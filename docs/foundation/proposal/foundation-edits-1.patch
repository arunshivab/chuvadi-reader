diff --git a/src/ChuvadiReader.Ui/Components/Platform/PlatformRoot.razor b/src/ChuvadiReader.Ui/Components/Platform/PlatformRoot.razor
new file mode 100644
index 0000000..ffbfe1f
--- /dev/null
+++ b/src/ChuvadiReader.Ui/Components/Platform/PlatformRoot.razor
@@ -0,0 +1,65 @@
+@using ChuvadiReader.Platform
+@implements IAsyncDisposable
+@inject IPlatformInfo Platform
+@inject IJSRuntime JS
+
+@*
+    Publishes the platform to the page and to child components.
+      * <html data-shell="desktop|tablet|phone|portal" data-platform="windows|macos|linux|android|web"
+              data-form-factor="desktop|tablet|phone" data-input="mouse touch pen keyboard"> — CSS for platform components keys on these,
+        and reader.js reads data-platform to pick the primary shortcut modifier (Ctrl or ⌘).
+      * Cascades a PlatformState that changes when the form factor changes, so layouts re-render.
+    Place once, around the app's content.
+*@
+<CascadingValue Value="_state">
+    @ChildContent
+</CascadingValue>
+
+@code {
+    [Parameter]
+    public RenderFragment? ChildContent { get; set; }
+
+    private PlatformState _state = default!;
+    private IJSObjectReference? _module;
+
+    protected override void OnInitialized()
+    {
+        _state = PlatformState.From(Platform);
+        Platform.FormFactorChanged += OnFormFactorChanged;
+    }
+
+    protected override async Task OnAfterRenderAsync(bool firstRender)
+    {
+        if (!firstRender) return;
+        try
+        {
+            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ChuvadiReader.Ui/js/platform.js");
+            await ApplyAsync();
+        }
+        catch (JSDisconnectedException)
+        {
+        }
+    }
+
+    private void OnFormFactorChanged() => InvokeAsync(async () =>
+    {
+        _state = PlatformState.From(Platform);
+        await ApplyAsync();
+        StateHasChanged();
+    });
+
+    private async Task ApplyAsync()
+    {
+        if (_module is null) return;
+        await _module.InvokeVoidAsync("apply", _state.ShellKey, _state.KindKey, _state.FormFactorKey, _state.InputKey);
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        Platform.FormFactorChanged -= OnFormFactorChanged;
+        if (_module is not null)
+        {
+            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
+        }
+    }
+}
diff --git a/src/ChuvadiReader.Ui/Components/Platform/PlatformState.cs b/src/ChuvadiReader.Ui/Components/Platform/PlatformState.cs
new file mode 100644
index 0000000..a9d9043
--- /dev/null
+++ b/src/ChuvadiReader.Ui/Components/Platform/PlatformState.cs
@@ -0,0 +1,38 @@
+using ChuvadiReader.Platform;
+
+namespace ChuvadiReader.Ui.Components.Platform;
+
+/// <summary>Snapshot of the platform facts the Ui renders from; cascaded by <c>PlatformRoot</c>.</summary>
+public sealed record PlatformState(PlatformKind Kind, FormFactor FormFactor, InputKinds Input, ShellChrome Chrome, PlatformCapabilities Capabilities)
+{
+    /// <summary>What the Ui switches chrome on: desktop, tablet, phone or portal.</summary>
+    public ShellLayout Shell => ShellLayouts.From(Kind, FormFactor);
+
+    public string ShellKey => ShellLayouts.Key(Shell);
+
+    public string KindKey => Kind switch
+    {
+        PlatformKind.Windows => "windows",
+        PlatformKind.MacOS => "macos",
+        PlatformKind.Linux => "linux",
+        PlatformKind.Android => "android",
+        _ => "web",
+    };
+
+    public string FormFactorKey => FormFactor switch
+    {
+        FormFactor.Tablet => "tablet",
+        FormFactor.Phone => "phone",
+        _ => "desktop",
+    };
+
+    public string InputKey => string.Join(' ', new[]
+    {
+        Input.HasFlag(InputKinds.Mouse) ? "mouse" : null,
+        Input.HasFlag(InputKinds.Touch) ? "touch" : null,
+        Input.HasFlag(InputKinds.Pen) ? "pen" : null,
+        Input.HasFlag(InputKinds.Keyboard) ? "keyboard" : null,
+    }.Where(s => s is not null));
+
+    public static PlatformState From(IPlatformInfo p) => new(p.Kind, p.FormFactor, p.Input, p.Chrome, p.Capabilities);
+}
