+let net = null;          // DotNetObjectReference<TouchSupport>
+let attached = false;
+const touches = new Map();   // pointerId → {x, y}
+let pinch = null;            // {dist, desk}
+let tap = null;              // {x, y, t, id, moved}
+let lastTap = null;          // {x, y, t}
