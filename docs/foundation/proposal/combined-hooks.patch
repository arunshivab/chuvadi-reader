+.sg-pill { font-family: var(--chvd-mono); font-size: 10.5px; padding: 2px 7px; border-radius: 4px; white-space: nowrap; }
+.sg-pill.sangam { background: color-mix(in srgb, var(--chvd-marigold) 14%, transparent); color: color-mix(in srgb, var(--chvd-marigold) 70%, var(--chvd-ink)); }
+.sg-pill.free { background: color-mix(in srgb, var(--chvd-olive) 12%, transparent); color: color-mix(in srgb, var(--chvd-olive) 55%, var(--chvd-ink)); }
+
+@media (max-width: 920px) { .sg-row { flex-direction: column; gap: 16px; } }
