+
+// ── pointer routing ─────────────────────────────────────────────────────────
+function onDown(e) {
+    if (!isTouch(e) || e.__chvdSynthetic) return;
+    touches.set(e.pointerId, { x: e.clientX, y: e.clientY });
+
+    if (touches.size === 2) {
