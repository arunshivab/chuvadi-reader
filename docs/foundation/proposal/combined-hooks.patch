+const DOUBLE_TAP_MS = 300;
+const TAP_SLOP = 10;
+const SWIPE_MIN = 60;
+const LONG_PRESS_MS = 450;
+const ZOOM_K = 0.0015;       // reader.js: next = old * exp(-deltaY * 0.0015)
