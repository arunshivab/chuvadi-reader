+++ b/src/ChuvadiReader.Ui/Components/Platform/Portal/AccountMenu.razor
@@ -0,0 +1,83 @@
+@namespace ChuvadiReader.Ui.Components.Platform.Portal
+@using ChuvadiReader.Platform
+@implements IDisposable
+@inject IAccount Account
+@inject PortalLinks Links
+
+@*
+    Web portal account menu (design: Portal & Android 12b). Sits at the end of the top bar where the
+    desktop draws its window buttons; shown only when IPlatformInfo.Chrome.AccountMenu is true.
+    Scope (Arun, 6 Nov): no per-user storage and no sharing this release, so the handout's storage
+    meter, "My files" and "Shared with me" are left out. Items: Get the desktop app · Account
+    settings · Sign out.
+*@
+<span class="acct-wrap" @onmousedown:stopPropagation="true" @ondblclick:stopPropagation="true">
+    <button class="acct-chip @(_open ? "on" : null)" @onclick="Toggle" aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")"
+            title="@Account.DisplayName" aria-label="Account: @Account.DisplayName">
+        <span class="acct-av">@AccountText.Initials(Account.DisplayName)</span>
+        <span class="acct-first">@AccountText.FirstName(Account.DisplayName)</span>
+        <Icon Name="chevron-down" Size="11" />
+    </button>
+    @if (_open)
+    {
+        <div class="pop-scrim" @onclick="Close"></div>
+        <div class="acct-pop" role="menu" @onkeydown="OnKey">
+            <div class="acct-who">
+                <span class="acct-av acct-av-lg">@AccountText.Initials(Account.DisplayName)</span>
+                <div class="acct-who-t">
+                    <b>@Account.DisplayName</b>
+                    @if (!string.IsNullOrEmpty(Account.Email))
+                    {
+                        <span class="acct-id">@Account.Email@(string.IsNullOrEmpty(Account.Unit) ? null : " · " + Account.Unit)</span>
+                    }
+                </div>
+            </div>
+            <a class="acct-item" role="menuitem" href="@Links.DesktopAppUrl" target="_blank" rel="noopener" @onclick="Close">
+                <Icon Name="download" Size="15" />Get the desktop app
+            </a>
+            @if (Links.AccountSettingsUrl is { } settings)
+            {
+                <a class="acct-item" role="menuitem" href="@settings" target="_blank" rel="noopener" @onclick="Close">
+                    <Icon Name="settings" Size="15" />Account settings
+                </a>
+            }
+            <button class="acct-item acct-out" role="menuitem" @onclick="SignOut" disabled="@_signingOut">
+                <Icon Name="log-out" Size="15" />Sign out
+            </button>
+        </div>
+    }
+</span>
+
+@code {
+    private bool _open;
+    private bool _signingOut;
+
+    protected override void OnInitialized() => Account.Changed += OnAccountChanged;
+
+    private void OnAccountChanged() => InvokeAsync(StateHasChanged);
+
+    private void Toggle() => _open = !_open;
+
+    private void Close() => _open = false;
+
+    private void OnKey(KeyboardEventArgs e)
+    {
+        if (e.Key == "Escape") _open = false;
+    }
+
+    private async Task SignOut()
+    {
+        _signingOut = true;
+        try
+        {
+            await Account.SignOutAsync();
+        }
+        finally
+        {
+            _signingOut = false;
+            _open = false;
+        }
+    }
+
+    public void Dispose() => Account.Changed -= OnAccountChanged;
+}
diff --git a/src/ChuvadiReader.Ui/Components/Platform/Portal/AccountMenu.razor.css b/src/ChuvadiReader.Ui/Components/Platform/Portal/AccountMenu.razor.css
new file mode 100644
index 0000000..2cc2970
--- /dev/null
+++ b/src/ChuvadiReader.Ui/Components/Platform/Portal/AccountMenu.razor.css
@@ -0,0 +1,49 @@
+/* Portal account menu — Portal & Android 12b. Theme tokens only, so all five themes follow. */
+.acct-wrap { position: relative; display: flex; margin-left: 4px; }
+
+.acct-chip {
+    display: flex; align-items: center; gap: 6px; height: 30px; padding: 0 8px 0 4px;
+    border: var(--chvd-stroke) solid var(--chvd-border); border-radius: 15px; background: transparent;
+    color: var(--chvd-ink); font-family: var(--chvd-sans-display); font-size: 12.5px; cursor: pointer; white-space: nowrap;
+}
+.acct-chip:hover, .acct-chip.on { background: var(--chvd-surface-mid); border-color: var(--chvd-binding); }
+.acct-chip:focus-visible, .acct-item:focus-visible { outline: 1.5px solid var(--chvd-binding); outline-offset: 1px; }
+
+.acct-av {
+    width: 22px; height: 22px; flex: none; border-radius: 50%;
+    background: var(--chvd-binding); color: var(--chvd-on-accent);
+    display: flex; align-items: center; justify-content: center;
+    font-family: var(--chvd-mono); font-size: 9px; letter-spacing: 0;
+}
+.acct-av-lg { width: 34px; height: 34px; font-size: 11px; }
+
+.acct-pop {
+    /* 12b: the card opens just below the top bar, beside the Tools rail (right = Tools + View + 12 px). */
+    position: fixed; top: calc(var(--sh-top, 40px) + 14px); right: calc(var(--sh-tools, 64px) + var(--sh-view, 54px) + 12px);
+    z-index: 81; width: 300px;
+    display: flex; flex-direction: column; gap: 10px; padding: 14px 16px;
+    background: var(--chvd-surface-hi); border: var(--chvd-stroke) solid var(--chvd-border);
+    border-radius: var(--chvd-radius-xl); box-shadow: var(--chvd-shadow-popover);
+    font-size: 12.5px; color: var(--chvd-ink);
+}
+
+.acct-who { display: flex; align-items: center; gap: 10px; min-width: 0; }
+.acct-who-t { display: flex; flex-direction: column; min-width: 0; }
+.acct-who-t b { font-weight: 600; font-size: 13.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.acct-id { font-family: var(--chvd-mono); font-size: 10.5px; color: var(--chvd-ink-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+.acct-item {
+    display: flex; align-items: center; gap: 10px; height: 32px; width: 100%; padding: 0;
+    border: none; border-top: var(--chvd-stroke) solid var(--chvd-border-soft); background: transparent;
+    color: var(--chvd-ink); font-family: var(--chvd-sans-display); font-size: 12.5px;
+    text-align: left; text-decoration: none; cursor: pointer;
+}
+.acct-item:hover { color: var(--chvd-binding); }
+.acct-out, .acct-out:hover { color: var(--chvd-danger); }
+.acct-item:disabled { opacity: .5; cursor: default; }
+
+/* Narrow browsers: the chip keeps only the avatar. */
+@media (max-width: 720px) {
+    .acct-first { display: none; }
+    .acct-pop { right: 12px; width: min(300px, calc(100vw - 24px)); }
+}
diff --git a/src/ChuvadiReader.Ui/Components/Platform/Portal/AccountText.cs b/src/ChuvadiReader.Ui/Components/Platform/Portal/AccountText.cs
new file mode 100644
index 0000000..c167198
--- /dev/null
+++ b/src/ChuvadiReader.Ui/Components/Platform/Portal/AccountText.cs
@@ -0,0 +1,28 @@
+namespace ChuvadiReader.Ui.Components.Platform.Portal;
+
+/// <summary>How the portal shows a person's name: "AS" in the avatar, "Arun" on the chip (design 12b).</summary>
+public static class AccountText
+{
+    /// <summary>First letters of the first and last words, upper-case: "Arun S." → "AS". "?" when empty.</summary>
+    public static string Initials(string? displayName)
+    {
+        var words = Words(displayName);
+        if (words.Length == 0) return "?";
+        var first = char.ToUpperInvariant(words[0][0]);
+        return words.Length == 1 ? first.ToString() : string.Concat(first, char.ToUpperInvariant(words[^1][0]));
+    }
+
+    /// <summary>The first word of the name: "Arun S." → "Arun". Empty when there is no name.</summary>
+    public static string FirstName(string? displayName)
+    {
+        var words = Words(displayName);
+        return words.Length == 0 ? string.Empty : words[0];
+    }
+
+    private static string[] Words(string? s) =>
+        string.IsNullOrWhiteSpace(s)
+            ? []
+            : s.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
+               .Where(w => char.IsLetterOrDigit(w[0]))
+               .ToArray();
+}
diff --git a/src/ChuvadiReader.Ui/Components/Platform/Portal/PortalCredentials.cs b/src/ChuvadiReader.Ui/Components/Platform/Portal/PortalCredentials.cs
