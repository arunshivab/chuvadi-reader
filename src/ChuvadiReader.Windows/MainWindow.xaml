<Window x:Class="ChuvadiReader.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Chuvadi" Width="1100" Height="720"
        Icon="chuvadi.ico"
        WindowStartupLocation="CenterScreen" Background="#F2EAD6">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- The app's page (ChuvadiWebView). MainWindow puts it here, and puts a new one here if the page's
             browser process stops (BUG-21, BUG-25). -->
        <ContentControl x:Name="WebHost" Focusable="False" />

        <!-- Shown only when the page has stopped. Plain WPF, so it works with no page at all. -->
        <Border x:Name="Recovery" Visibility="Collapsed" Background="#F2EAD6">
            <StackPanel MaxWidth="460" Margin="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="RecoveryTitle" FontSize="20" FontWeight="SemiBold" Foreground="#2B211A"
                           TextWrapping="Wrap" Text="Chuvadi's window stopped working" />
                <TextBlock x:Name="RecoveryBody" Margin="0,12,0,0" FontSize="14" Foreground="#4A3D33"
                           TextWrapping="Wrap" LineHeight="21" />
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button x:Name="RecoveryReopen" Padding="18,8" MinWidth="150" IsDefault="True"
                            Content="Reopen the window" Click="OnRecoveryReopen" />
                    <Button x:Name="RecoveryWait" Padding="18,8" Margin="12,0,0,0" Visibility="Collapsed"
                            Content="Keep waiting" Click="OnRecoveryWait" />
                    <Button x:Name="RecoveryClose" Padding="18,8" Margin="12,0,0,0"
                            Content="Close Chuvadi" Click="OnRecoveryClose" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
