<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The Windows version suffix is REQUIRED. Without it (plain net10.0-windows)
      the Windows SDK projection assembly Microsoft.Windows.SDK.NET.dll is not
      brought in, and WebView2 throws FileNotFoundException at window show time.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>ChuvadiReader.Windows</RootNamespace>
    <AssemblyName>ChuvadiReader.Windows</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>chuvadi.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Startup speed (D-50): `dotnet publish` precompiles the app ReadyToRun, so Windows starts
    without JIT-compiling most methods (measured: about a third less Core/Ui startup work).
    Only publish is affected: build, F5 and tests stay as they are. ReadyToRun needs a runtime
    identifier; publish defaults to win-x64, and `dotnet publish -r win-arm64` makes the Arm build.
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="chuvadi.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- First-party Microsoft host control. The only host package. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChuvadiReader.Ui\ChuvadiReader.Ui.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Core\ChuvadiReader.Core.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Hosting\ChuvadiReader.Hosting.csproj" />
  </ItemGroup>
  <!-- Licence files beside the app (and in the installer): proprietary licence, EULA, notices. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\legal\EULA.txt" Link="EULA.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\legal\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
