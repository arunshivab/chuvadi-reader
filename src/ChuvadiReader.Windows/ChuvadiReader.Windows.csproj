<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The Windows version suffix is REQUIRED. Without it (plain net10.0-windows)
      the Windows SDK projection assembly Microsoft.Windows.SDK.NET.dll is not
      brought in, and WebView2 throws FileNotFoundException at window show time.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>ChuvadiReader.Windows</RootNamespace>
    <AssemblyName>ChuvadiReader.Windows</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>chuvadi.ico</ApplicationIcon>
    <!-- BUG-22: Windows shows the file description (Task Manager, Alt Tab details) as the app's name. -->
    <AssemblyTitle>Chuvadi</AssemblyTitle>
  </PropertyGroup>

  <!-- SC27: a Release build's version reads "1.0.0-preview", without the source commit after a "+". -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- SC27: what is published for people to install carries no debugging symbols (.pdb) or code documentation
       (.xml). Builds keep both, for debugging; publish leaves them out. -->
  <PropertyGroup>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!--
    Startup speed (D-50): `dotnet publish` precompiles the app ReadyToRun, so Windows starts
    without JIT-compiling most methods (measured: about a third less Core/Ui startup work).
    Only publish is affected: build, F5 and tests stay as they are. ReadyToRun needs a runtime
    identifier; publish defaults to win-x64, and `dotnet publish -r win-arm64` makes the Arm build.
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="chuvadi.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- First-party Microsoft host control. The only host package. -->
    <!-- SC20: kept on the latest servicing release. The second line lifts the Blazor WebView package it brings
         to its own latest servicing release (the .NET runtime itself is the one installed on the PC). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.130" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChuvadiReader.Ui\ChuvadiReader.Ui.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Core\ChuvadiReader.Core.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Hosting\ChuvadiReader.Hosting.csproj" />
  </ItemGroup>
  <!-- Licence files beside the app (and in the installer): proprietary licence, EULA, notices. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\legal\EULA.txt" Link="EULA.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\legal\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
