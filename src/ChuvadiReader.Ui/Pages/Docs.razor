@page "/docs"
@using ChuvadiReader.Ui.Components.Viewers
@inject IFilePicker Picker

@* Thin wrapper: pick a .docx and host the shared DocxView (the same viewer the Reader uses for Word tabs). *@

<PageTitle>Chuvadi · Docs</PageTitle>

<div class="docp">
    <div class="docp-bar">
        <a href="/" class="docp-back"><Icon Name="chevron-left" Size="14" /> dashboard</a>
        <span class="docp-title"><Icon Name="reader" Size="15" /> Docs</span>
        @if (!string.IsNullOrEmpty(_path))
        {
            <span class="docp-name" title="@_path">@System.IO.Path.GetFileName(_path)</span>
            @if (!string.IsNullOrEmpty(_meta)) { <span class="docp-meta">@_meta</span> }
        }
        <div class="docp-spacer"></div>
        <button class="docp-open" @onclick="Open"><Icon Name="upload" Size="14" /> Open Word file</button>
    </div>

    <div class="docp-stage">
        @if (string.IsNullOrEmpty(_path))
        {
            <div class="docp-empty">
                <div class="docp-empty-card">
                    <div class="docp-empty-ic"><Icon Name="reader" Size="40" /></div>
                    <h2>View a Word document</h2>
                    <p>Open a <strong>.docx</strong> file to read it here — headings, formatting, tables and images, no Word needed.</p>
                    <button class="docp-open lg" @onclick="Open"><Icon Name="upload" Size="16" /> Open Word file</button>
                </div>
            </div>
        }
        else
        {
            <DocxView @ref="_viewer" Path="@_path" OnStatus="s => _meta = s" />
        }
    </div>
</div>

@code {
    private string _path = "";
    private string? _meta;
    private DocxView? _viewer;

    private async Task Open()
    {
        var path = await Picker.PickDocumentAsync();
        if (string.IsNullOrEmpty(path)) return;
        if (path == _path && _viewer is not null) { await _viewer.ReloadAsync(); return; }
        _meta = null;
        _path = path;
    }
}
