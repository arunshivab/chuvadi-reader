        (on
            ? "var(--chvd-binding);color:var(--chvd-binding);background:var(--chvd-binding-soft)"
            : "var(--chvd-border);color:var(--chvd-ink);background:var(--chvd-surface-lo)");

    private void ShowPress()
    {
        _showPress = true;
        _pressStatus = null;
        _pressResult = null;
        _pressFolder = Press.DefaultFolder;
    }

    private void ClosePress() => _showPress = false;

    private async Task ChangePressFolder()
    {
        var folder = await Picker.PickFolderAsync();
        if (folder is not null)
        {
            _pressFolder = folder;
        }
    }

    private async Task RunPress()
    {
        var active = Tabs.Active;
        if (active?.Path is null)
        {
            return;
        }

        _pressBusy = true;
        _pressResult = null;
        _pressStatus = "pressing…";
        StateHasChanged();
        try
        {
            if (_pressUseTarget && _pressTargetMb > 0)
            {
                _pressResult = await Press.PressToTargetAsync(active.Path, _pressFolder, (long)(_pressTargetMb * 1024 * 1024));
            }
            else
            {
                var opts = _pressPreset == PressPreset.Custom
                    ? new PressOptions(_pressRecompress, _pressQuality, _pressMinStream, _pressMinPixels)
                    : PressOptions.For(_pressPreset);
                _pressResult = await Press.PressAsync(active.Path, _pressFolder, opts);
            }

            _pressStatus = null;
        }
        catch (Exception ex)
        {
            _pressStatus = "Press failed: " + ex.Message;
        }
        finally
        {
            _pressBusy = false;
        }
