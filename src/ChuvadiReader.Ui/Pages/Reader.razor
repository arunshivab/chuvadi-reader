    [JSInvokable]
    public async Task OnDeskResize()
    {
        var tab = Tabs.Active;
        if (tab?.Session is null || tab.FitMode == ReaderFitMode.Free || _js is null)
        {
            return;
        }

        try
        {
            var s = await _js.InvokeAsync<double>("measureFit", _desk, tab.FitMode == ReaderFitMode.Width ? "width" : "page");
            if (s > 0)
            {
                tab.Scale = s;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    private async Task SaveActiveScrollAsync()
    {
        var tab = Tabs.Active;
        if (tab?.Session is null || _js is null)
        {
            return;
        }

        try
        {
            var top = await _js.InvokeAsync<double>("getScrollTop", _desk);
            Tabs.UpdateViewState(tab.Id, tab.CurrentPage, tab.Scale, top);
        }
        catch
        {
            // best-effort; scroll memory is a nicety
        }
    }

    public async ValueTask DisposeAsync()
    {
        Tabs.Changed -= OnTabsChanged;
        OpenDoc.Requested -= OnOpenRequestedLive;

        try
        {
            await SaveActiveScrollAsync();
            await Tabs.SaveAsync();
        }
        catch
        {
            // leaving the page must never throw
        }

        try
        {
            if (_js is not null)
            {
                await _js.InvokeVoidAsync("dispose");
                await _js.DisposeAsync();
            }
        }
        catch
        {
            // disposing during teardown must never throw
        }

        _ref?.Dispose();
    }
