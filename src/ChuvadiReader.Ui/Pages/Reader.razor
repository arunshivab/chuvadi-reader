    private void CloseSignature() => _sigOpen = false;

    private async Task PlaceTypedSignature()
    {
        if (string.IsNullOrWhiteSpace(_sigText)) return;
        _sigError = null;
        try
        {
            int page = Math.Clamp(CurPage - 1, 0, (Doc?.PageCount ?? 1) - 1);
            await CacheLayerRect(page);
            string? dataUrl = _js is null
                ? null
                : await _js.InvokeAsync<string?>("renderSignature", _sigText.Trim(), SigCanvasFont, _sigColor);
            var bytes = DataUrlToBytes(dataUrl);
            if (bytes.Length == 0)
            {
                _sigError = "Could not render the signature.";
                return;
            }
            AddImageBox(page, bytes, "image/png");
            _sigOpen = false;
        }
        catch (Exception ex)
        {
            _sigError = $"Signature failed: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task UploadSignature()
    {
        _sigError = null;
        EnsureMarkupDoc();
        IReadOnlyList<string> paths;
        try { paths = await Picker.PickImagesAsync(); }
        catch { return; }
        if (paths is null || paths.Count == 0) return;
        int page = Math.Clamp(CurPage - 1, 0, (Doc?.PageCount ?? 1) - 1);
        await CacheLayerRect(page);
        try
        {
            var bytes = await Task.Run(() => System.IO.File.ReadAllBytes(paths[0]));
            AddImageBox(page, bytes, MimeForPath(paths[0]));
            _sigOpen = false;
        }
        catch (Exception ex)
        {
            _sigError = $"Could not load image: {ex.Message}";
        }
        StateHasChanged();
    }

    private static byte[] DataUrlToBytes(string? dataUrl)
    {
        if (string.IsNullOrEmpty(dataUrl)) return Array.Empty<byte>();
        var comma = dataUrl.IndexOf(',');
        try { return Convert.FromBase64String(comma >= 0 ? dataUrl[(comma + 1)..] : dataUrl); }
        catch { return Array.Empty<byte>(); }
    }

