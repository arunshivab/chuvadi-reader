    private void ShowExport()
    {
        _showExport = true;
        _expStatus = null;
        _expFolder = SaveFolders.SubFolder("Export");
    }

    private void CloseExport() => _showExport = false;

    private async Task ChangeExportFolder()
    {
        var folder = await Picker.PickFolderAsync();
        if (folder is not null)
        {
            _expFolder = folder;
        }
    }

    private async Task RunExport()
    {
        var active = Tabs.Active;
        if (active?.Path is null || string.IsNullOrEmpty(_expFolder))
        {
