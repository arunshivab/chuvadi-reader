@page "/reader"
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject TabsService Tabs
@inject IFilePicker Picker
@inject OpenDocumentService OpenDoc
@inject RecentFilesService Recents
@inject IJSRuntime JS
@inject BenchService Bench
@inject IImageClipboard Clip
@inject DocumentPropertiesService DocProps
@inject ExportService Export
@inject SaveFolderService SaveFolders
@inject PressService Press
@inject IAppStorage Storage
@inject RedactService Redact
@inject StampService Stamp
@inject RedactRequestService RedactHandoff
@inject IEntitlements Entitlements
@using ChuvadiReader.Core.Documents

<PageTitle>Chuvadi · Reader</PageTitle>

<div class="reader @(_reading ? "reading" : null) @(_drawerPinned && _drawerOpen ? "pinned" : null)" style="--reader-page-bg:@_pageBg">
    @{
        var tab = Tab;
        var doc = tab?.Session?.Document;
    }
    <header class="rtop">
        <div class="rtools">
            @if (doc is not null)
            {
                <button class="ricon" @onclick="() => GoTo(CurPage - PageStep)" disabled="@(CurPage <= 1)" aria-label="Previous page"><Icon Name="chevron-left" Size="16" /></button>
                <span class="rpagenav">
                    <input class="rpagebox" value="@_pageInput" @onchange="OnJumpChange" inputmode="numeric" aria-label="Page number" />
                    <span class="rpagetotal">/ @doc.PageCount</span>
                </span>
                <button class="ricon" @onclick="() => GoTo(CurPage + PageStep)" disabled="@(CurPage >= doc.PageCount)" aria-label="Next page"><Icon Name="chevron-right" Size="16" /></button>

                <span class="rsep"></span>
                <button class="ricon" @onclick="ZoomOut" disabled="@(CurScale <= 0.1)" aria-label="Zoom out"><Icon Name="zoom-out" Size="15" /></button>
                <span class="rzoom">@ZoomPct%</span>
                <button class="ricon" @onclick="ZoomIn" disabled="@(CurScale >= 8.0)" aria-label="Zoom in"><Icon Name="zoom-in" Size="15" /></button>

                <span class="rsep"></span>
                <button class="vbtn @(Tab?.FitMode == ReaderFitMode.Width ? "on" : null)" @onclick="FitWidth" title="Fit width"><Icon Name="fit-width" Size="18" /></button>
                <button class="vbtn @(Tab?.FitMode == ReaderFitMode.Page ? "on" : null)" @onclick="FitPage" title="Fit page"><Icon Name="fit-page" Size="18" /></button>
                <button class="vbtn" @onclick="ActualSize" title="Actual size (100%)"><Icon Name="actual-size" Size="18" /></button>

                <span class="rsep"></span>
                <button class="vbtn @(!TwoPageOn ? "on" : null)" @onclick="() => SetColumns(false)" title="Single page"><Icon Name="page-single" Size="18" /></button>
                <button class="vbtn @(TwoPageOn ? "on" : null)" @onclick="() => SetColumns(true)" title="Two-page"><Icon Name="page-facing" Size="18" /></button>

                <span class="rsep"></span>
                <button class="vbtn" @onclick="() => RotateScopeBy(-90)" title="Rotate left (scope in View ▸ Rotate)"><Icon Name="rotate-ccw" Size="18" /></button>
                <button class="vbtn" @onclick="() => RotateScopeBy(90)" title="Rotate right (scope in View ▸ Rotate)"><Icon Name="rotate-cw" Size="18" /></button>
                <button class="vbtn @(_tool == ReaderTool.Hand ? "on" : null)" @onclick="() => SetTool(ReaderTool.Hand)" title="Hand (pan)"><Icon Name="hand" Size="18" /></button>
                <button class="vbtn @(_bm ? "on" : null)" @onclick="ToggleBookmarks" title="Bookmarks"><Icon Name="library" Size="18" /></button>
                <button class="vbtn @(_tool == ReaderTool.Marquee ? "on" : null)" @onclick="() => SetTool(ReaderTool.Marquee)" title="Marquee zoom"><Icon Name="zoom-area" Size="18" /></button>
                <button class="vbtn @(_tool == ReaderTool.Loupe ? "on" : null)" @onclick="() => SetTool(ReaderTool.Loupe)" title="Loupe"><Icon Name="loupe" Size="18" /></button>
                <button class="vbtn @(_tool == ReaderTool.Snapshot ? "on" : null)" @onclick="() => SetTool(ReaderTool.Snapshot)" title="Snapshot a region"><Icon Name="crop" Size="18" /></button>
                <button class="vbtn @(Tab?.ScrollLocked == true ? "on" : null)" @onclick="ToggleScrollLock" title="Lock scrolling"><Icon Name="lock" Size="16" /></button>

                <span class="rsep"></span>
                <button class="vbtn @(_drawerOpen ? "on" : null)" @onclick="ToggleDrawer" title="View options"><Icon Name="eye" Size="16" /></button>
                <span class="rpc-wrap">
                    <button class="vbtn @(_pageColorOpen ? "on" : null)" @onclick="TogglePageColor" title="Page colour (view only)"><Icon Name="contrast" Size="16" /></button>
                    @if (_pageColorOpen)
                    {
                        <div class="rpc-pop" @onclick:stopPropagation="true">
                            <div class="rpc-h">Page colour <span class="rpc-sub">view only — not saved to file</span></div>
                            <div class="rpc-swatches">
                                @foreach (var (name, hex) in _pageBgPresets)
                                {
                                    <button class="rpc-sw @(SameColor(_pageBg, hex) ? "on" : null)" style="background:@hex"
                                            title="@name" @onclick="() => SetPageBg(hex)"></button>
                                }
                            </div>
                            <div class="rpc-custom">
                                <label>Custom</label>
                                <input type="color" value="@_pageBg" @oninput="OnCustomPageBg" />
                                <button class="rpc-reset" @onclick='() => SetPageBg("#ffffff")'>Reset</button>
                            </div>
                        </div>
                    }
                </span>
                <span class="rsep"></span>
                <button class="vbtn @(_markup ? "on" : null)" @onclick="ToggleMarkup" title="Edit"><Icon Name="edit" Size="16" /></button>
                <button class="vbtn @(Tab?.StampOpen == true ? "on" : null)" @onclick="ToggleStamp" title="Watermark &amp; header/footer"><Icon Name="stamp" Size="16" /></button>
                <button class="vbtn" @onclick="OpenInBench" title="Open in Bench"><Icon Name="grid-view" Size="16" /></button>
                @if (Entitlements.CanRedact)
                {
                    <button class="vbtn" @onclick="SendToRedact" title="Send to Redact"><Icon Name="redact" Size="16" /></button>
                }
            }
        </div>
    </header>

    @if (_bm && doc is not null)
    {
        <div class="bm-panel">
            <div class="bm-head">
                <span>Bookmarks</span>
                <button @onclick="ToggleBookmarks" aria-label="Close"><Icon Name="x" Size="15" /></button>
            </div>
            <div class="bm-acts">
                <button class="bm-act" @onclick="BmAddCurrent" title="Add a bookmark at the current page"><Icon Name="plus" Size="13" /> Add</button>
                <button class="bm-act" @onclick="() => BmMove(-1)" disabled="@(_bmSel is null)" title="Move up"><Icon Name="chevron-up" Size="13" /></button>
                <button class="bm-act" @onclick="() => BmMove(1)" disabled="@(_bmSel is null)" title="Move down"><Icon Name="chevron-down" Size="13" /></button>
                <button class="bm-act" @onclick="BmIndent" disabled="@(_bmSel is null)" title="Indent (nest under the entry above)"><Icon Name="chevron-right" Size="13" /></button>
                <button class="bm-act" @onclick="BmOutdent" disabled="@(_bmSel is null)" title="Outdent"><Icon Name="chevron-left" Size="13" /></button>
                <button class="bm-act del" @onclick="BmDelete" disabled="@(_bmSel is null)" title="Delete"><Icon Name="trash" Size="13" /></button>
            </div>
            <div class="bm-tree">
                @if (_bmTree is null || _bmTree.Count == 0)
                {
                    <div class="bm-empty">No bookmarks in this document. Use <strong>Add</strong> to create one at the current page, then Save.</div>
                }
                else
                {
                    @foreach (var (node, depth) in BmFlat())
                    {
                        <div class="bm-row @(ReferenceEquals(node, _bmSel) ? "sel" : null)" style="padding-left:@(8 + depth * 16)px" @onclick="() => BmSelect(node)">
                            @if (ReferenceEquals(node, _bmRenaming))
                            {
                                <input class="bm-rename" value="@node.Title" @oninput="e => node.Title = e.Value?.ToString() ?? string.Empty" @onblur="BmEndRename" @onkeydown="BmRenameKey" @onclick:stopPropagation="true" />
                            }
                            else
                            {
                                <span class="bm-title" @ondblclick="() => BmBeginRename(node)" title="Double-click to rename">@(string.IsNullOrWhiteSpace(node.Title) ? "(untitled)" : node.Title)</span>
                            }
                            <button class="bm-go" @onclick:stopPropagation="true" @onclick="() => BmGo(node)" title="Go to page @(node.PageIndex + 1)">p@(node.PageIndex + 1)</button>
                        </div>
                    }
                }
            </div>
            <div class="bm-foot">
                <span class="bm-status">@_bmStatus</span>
                <button class="bm-save" @onclick="BmSave" disabled="@_bmBusy">@(_bmBusy ? "saving…" : "Save bookmarks")</button>
            </div>
        </div>
    }

    @if (_markup && doc is not null)
    {
        <div class="mk-rail">
            <div class="mk-tools">
                <button class="mk-tool @(_mkTool == "text" ? "on" : null)" @onclick='() => SetMkTool("text")' title="Add text"><Icon Name="text-box" Size="15" /> Text</button>
                <button class="mk-tool @(_mkTool == "image" ? "on" : null)" @onclick="AddImageViaPicker" title="Add image"><Icon Name="image" Size="15" /> Image</button>
                <button class="mk-tool @(_mkTool == "rect" ? "on" : null)" @onclick='() => SetMkTool("rect")' title="Rectangle"><Icon Name="shape-rect" Size="15" /> Rect</button>
                <button class="mk-tool @(_mkTool == "line" ? "on" : null)" @onclick='() => SetMkTool("line")' title="Line"><Icon Name="minus" Size="15" /> Line</button>
                <button class="mk-tool @(_sigOpen ? "on" : null)" @onclick="OpenSignature" title="Add signature"><Icon Name="sign" Size="15" /> Sign</button>
            </div>

            @* Redaction relocated to the Redact destination (/redact). Markup is overlay-only. *@
            @if (_selText is { } sel)
            {
                <span class="mk-style">
                    <select class="mk-sel" value="@sel.FontFamily" @onchange="e => SetFont(sel, e)">
                        <option value="Helvetica">Helvetica</option>
                        <option value="Times">Times</option>
                        <option value="Courier">Courier</option>
                    </select>
                    <button class="mk-tg @(sel.Bold ? "on" : null)" @onclick="() => { sel.Bold = !sel.Bold; }" title="Bold"><b>B</b></button>
                    <button class="mk-tg @(sel.Italic ? "on" : null)" @onclick="() => { sel.Italic = !sel.Italic; }" title="Italic"><i>I</i></button>
                    <input class="mk-num" type="number" min="6" max="200" step="1" value="@sel.FontSizePt" @onchange="e => SetSize(sel, e)" title="Size (pt)" />
                    <span class="mk-aligns">
                        <button class="mk-tg @(sel.Align == "left" ? "on" : null)" @onclick='() => sel.Align = "left"' title="Left">⯇</button>
                        <button class="mk-tg @(sel.Align == "center" ? "on" : null)" @onclick='() => sel.Align = "center"' title="Center">≡</button>
                        <button class="mk-tg @(sel.Align == "right" ? "on" : null)" @onclick='() => sel.Align = "right"' title="Right">⯈</button>
                        <button class="mk-tg @(sel.Align == "justify" ? "on" : null)" @onclick='() => sel.Align = "justify"' title="Justify">☰</button>
                    </span>
                    <label class="mk-swatch custom on" title="Text colour" style="background:@sel.ColorHex">
                        <input type="color" value="@sel.ColorHex" @onchange="e => SetTextColor(sel, e)" />
                    </label>
                    <span class="mk-rot"><Icon Name="rotate-cw" Size="13" /><input class="mk-num" type="number" min="-180" max="180" step="1" value="@sel.Rotation" @onchange="e => SetRotation(sel, e)" title="Rotation (°)" />°</span>
                    <button class="mk-tg del" @onclick="() => RemoveSelectedText()" title="Delete text">&times;</button>
                </span>
            }
            else if (_selShape is { } ssel)
            {
                <span class="mk-style">
                    <span class="mk-style-lbl">@(ssel.Kind == ShapeKind.Line ? "Line" : "Rectangle")</span>
                    <span class="mk-stroke-lbl">Stroke</span>
                    <label class="mk-swatch custom on" title="Stroke colour" style="background:@ssel.StrokeHex">
                        <input type="color" value="@ssel.StrokeHex" @onchange="e => SetShapeStroke(ssel, e)" />
                    </label>
                    <input class="mk-num" type="number" min="0.25" max="60" step="0.25" value="@ssel.StrokeWidthPt" @onchange="e => SetShapeWidth(ssel, e)" title="Stroke width (pt)" />
                    @if (ssel.Kind == ShapeKind.Rectangle)
                    {
                        <span class="mk-fill-grp">
                            <button class="mk-tg @(string.IsNullOrEmpty(ssel.FillHex) ? null : "on")" @onclick="() => ToggleShapeFill(ssel)" title="Toggle fill">Fill</button>
                            @if (!string.IsNullOrEmpty(ssel.FillHex))
                            {
                                <label class="mk-swatch custom on" title="Fill colour" style="background:@ssel.FillHex">
                                    <input type="color" value="@ssel.FillHex" @onchange="e => SetShapeFill(ssel, e)" />
                                </label>
                            }
                        </span>
                    }
                    <button class="mk-tg del" @onclick="() => RemoveSelectedShape()" title="Delete shape">&times;</button>
                </span>
            }
            else if (_selImage is { } isel)
            {
                <span class="mk-style">
                    <span class="mk-style-lbl">Image</span>
                    <button class="mk-tg @(isel.Lock ? "on" : null)" @onclick="() => ToggleImageLock(isel)" title="@(isel.Lock ? "Aspect locked" : "Aspect unlocked")"><Icon Name="lock" Size="13" /></button>
                    <button class="mk-tg" @onclick="AddImageViaPicker" title="Replace / add another image"><Icon Name="image" Size="13" /></button>
                    <span class="mk-note" title="The library can't apply image opacity yet (v40)">full opacity</span>
                    <button class="mk-tg del" @onclick="() => RemoveSelectedImage()" title="Delete image">&times;</button>
                </span>
            }
            else
            {
                <span class="mk-hint">
                    @(_mkTool switch
                    {
                        "text" => "Click to place a text box, or drag to size one.",
                        "rect" => "Drag to draw a rectangle.",
                        "line" => "Drag to draw a line.",
                        "image" => "Pick an image, or paste / drop one onto the page.",
                        _ => "Click to place a text box, or drag to size one.",
                    })
                </span>
            }

            <span class="mk-spacer"></span>
            @if (_mkStatus is not null)
            {
                <span class="mk-status @(_mkError ? "err" : null)">@_mkStatus</span>
                @if (_mkSavedPath is not null)
                {
                    <button class="mk-open" @onclick="OpenRedacted">Open it</button>
                }
            }
            <span class="mk-count">@TextCount text · @ShapeCount shape@(ShapeCount == 1 ? "" : "s") · @ImageCount image@(ImageCount == 1 ? "" : "s")</span>
            <button class="mk-btn" @onclick="ClearMarkup" disabled="@(OverlayCount == 0 || _mkSaving)">Clear</button>
            @if (OverlayCount > 0)
            {
                <button class="mk-btn" @onclick="SaveInPlace" disabled="@_mkSaving" title="Overwrite the open file">@(_mkSaving ? "Saving…" : "Save")</button>
            }
            <button class="mk-btn primary" @onclick="SaveMarkup" disabled="@(OverlayCount == 0 || _mkSaving)" title="Save to a new file">@(_mkSaving ? "Saving…" : "Save as new PDF")</button>
            <button class="mk-btn" @onclick="ToggleMarkup">Done</button>
        </div>
    }

    @if (_showProps)
    {
        <div @onclick="CloseProperties" style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:60;display:flex;align-items:center;justify-content:center">
            <div @onclick:stopPropagation="true" style="width:440px;max-width:90%;max-height:82%;overflow:auto;background:var(--chvd-surface-mid);border:var(--chvd-stroke) solid var(--chvd-border);border-radius:12px;padding:18px 20px;color:var(--chvd-ink);font-family:var(--chvd-sans-display)">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
                    <span style="font-family:var(--chvd-serif-display);font-size:18px">Document properties</span>
                    <button @onclick="CloseProperties" aria-label="Close" style="background:none;border:none;color:var(--chvd-ink-muted);cursor:pointer"><Icon Name="x" Size="16" /></button>
                </div>
                @if (_props is null)
                {
                    <div style="font-family:var(--chvd-mono);font-size:12px;color:var(--chvd-ink-muted)">reading…</div>
                }
                else
                {
                    <table style="width:100%;font-size:13px;border-collapse:collapse">
                        @foreach (var (label, value) in PropRows())
                        {
                            <tr>
                                <td style="color:var(--chvd-ink-muted);font-family:var(--chvd-mono);font-size:11px;padding:5px 12px 5px 0;vertical-align:top;white-space:nowrap">@label</td>
                                <td style="padding:5px 0;word-break:break-word">@value</td>
                            </tr>
                        }
                    </table>
                }
            </div>
        </div>
    }

    @if (_showExport)
    {
        <div @onclick="CloseExport" style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:60;display:flex;align-items:center;justify-content:center">
            <div @onclick:stopPropagation="true" style="width:470px;max-width:92%;background:var(--chvd-surface-mid);border:var(--chvd-stroke) solid var(--chvd-border);border-radius:12px;padding:18px 20px;color:var(--chvd-ink);font-family:var(--chvd-sans-display)">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
                    <span style="font-family:var(--chvd-serif-display);font-size:18px">Export as image</span>
                    <button @onclick="CloseExport" aria-label="Close" style="background:none;border:none;color:var(--chvd-ink-muted);cursor:pointer"><Icon Name="x" Size="16" /></button>
                </div>

                <div style="font-family:var(--chvd-mono);font-size:11px;color:var(--chvd-ink-muted);margin-bottom:7px">format</div>
                <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px">
                    @foreach (var f in _formats)
                    {
                        <button @onclick="() => _expFormat = f" style="@Chip(_expFormat == f)">@f.ToString().ToUpperInvariant()</button>
                    }
                </div>

                <div style="font-family:var(--chvd-mono);font-size:11px;color:var(--chvd-ink-muted);margin-bottom:7px">pages</div>
                <div style="display:flex;gap:6px;margin-bottom:16px">
                    <button @onclick="() => _expAll = false" style="@Chip(!_expAll)">This page (@CurPage)</button>
                    <button @onclick="() => _expAll = true" style="@Chip(_expAll)">All pages@(Doc is not null ? $" ({Doc.PageCount})" : "")</button>
                </div>

                @if (_expFormat != ExportFormat.Svg)
                {
                    <div style="font-family:var(--chvd-mono);font-size:11px;color:var(--chvd-ink-muted);margin-bottom:7px">resolution</div>
                    <div style="display:flex;gap:6px;margin-bottom:18px">
                        @foreach (var d in _dpis)
                        {
                            <button @onclick="() => _expDpi = d" style="@Chip(_expDpi == d)">@d dpi</button>
                        }
                    </div>
                }

                <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;font-family:var(--chvd-mono);font-size:11px;color:var(--chvd-ink-muted)">
                    <Icon Name="folder" Size="13" />
                    <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@_expFolder">@_expFolder</span>
                    <button @onclick="ChangeExportFolder" style="background:none;border:none;color:var(--chvd-binding);cursor:pointer;font-family:var(--chvd-mono);font-size:11px">change…</button>
                </div>

                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
                    <span style="font-family:var(--chvd-serif-body);font-size:12px;color:var(--chvd-ink-muted);flex:1">@(_expStatus ?? "Saved files are never overwritten.")</span>
                    <button @onclick="RunExport" disabled="@_expBusy" style="font-family:var(--chvd-mono);font-size:13px;padding:8px 18px;border-radius:8px;border:none;cursor:pointer;background:var(--chvd-binding);color:var(--chvd-surface-lo);@(_expBusy ? "opacity:0.6" : "")">@(_expBusy ? "exporting…" : "Export →")</button>
                </div>
            </div>
        </div>
    }

    @if (_showPress)
    {
        <div @onclick="ClosePress" style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:60;display:flex;align-items:center;justify-content:center">
            <div @onclick:stopPropagation="true" style="width:500px;max-width:94%;max-height:88%;overflow:auto;background:var(--chvd-surface-mid);border:var(--chvd-stroke) solid var(--chvd-border);border-radius:12px;padding:18px 20px;color:var(--chvd-ink);font-family:var(--chvd-sans-display)">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
                    <span style="font-family:var(--chvd-serif-display);font-size:18px">Press</span>
                    <button @onclick="ClosePress" aria-label="Close" style="background:none;border:none;color:var(--chvd-ink-muted);cursor:pointer"><Icon Name="x" Size="16" /></button>
                </div>

                <div style="font-family:var(--chvd-mono);font-size:11px;color:var(--chvd-ink-muted);margin-bottom:7px">quality preset</div>
                <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px">
                    @foreach (var p in _presets)
                    {
                        <button @onclick="() => _pressPreset = p" style="@Chip(_pressPreset == p)">@p.ToString()</button>
                    }
                </div>

                @if (_pressPreset == PressPreset.Custom)
                {
                    <div style="background:var(--chvd-surface-lo);border:var(--chvd-stroke) solid var(--chvd-border-soft);border-radius:10px;padding:12px 14px;margin-bottom:14px">
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                            <span style="font-family:var(--chvd-mono);font-size:11px;color:var(--chvd-ink-muted);width:96px">jpeg quality</span>
                            <input type="range" min="10" max="95" step="1" @bind="_pressQuality" @bind:event="oninput" style="flex:1" />
                            <span style="font-family:var(--chvd-mono);font-size:12px;width:28px;text-align:right">@_pressQuality</span>
                        </div>
                        <label style="display:flex;align-items:center;gap:8px;font-size:12px;margin-bottom:10px;cursor:pointer">
                            <input type="checkbox" @bind="_pressRecompress" /> recompress images
                        </label>
                        <div style="display:flex;gap:14px">
                            <label style="flex:1;font-family:var(--chvd-mono);font-size:11px;color:var(--chvd-ink-muted)">min stream bytes
                                <input type="number" @bind="_pressMinStream" style="width:100%;margin-top:3px;background:var(--chvd-surface-hi);border:var(--chvd-stroke) solid var(--chvd-border);border-radius:6px;color:var(--chvd-ink);padding:4px 6px;font-family:var(--chvd-mono);font-size:12px" />
                            </label>
                            <label style="flex:1;font-family:var(--chvd-mono);font-size:11px;color:var(--chvd-ink-muted)">min image pixels
                                <input type="number" @bind="_pressMinPixels" style="width:100%;margin-top:3px;background:var(--chvd-surface-hi);border:var(--chvd-stroke) solid var(--chvd-border);border-radius:6px;color:var(--chvd-ink);padding:4px 6px;font-family:var(--chvd-mono);font-size:12px" />
                            </label>
                        </div>
                    </div>
                }

                <label style="display:flex;align-items:center;gap:8px;font-size:12px;margin-bottom:@(_pressUseTarget ? "8px" : "14px");cursor:pointer">
                    <input type="checkbox" @bind="_pressUseTarget" /> aim for a target size
                </label>
                @if (_pressUseTarget)
                {
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px">
                        <input type="number" step="0.1" min="0.1" @bind="_pressTargetMb" style="width:90px;background:var(--chvd-surface-hi);border:var(--chvd-stroke) solid var(--chvd-border);border-radius:6px;color:var(--chvd-ink);padding:5px 8px;font-family:var(--chvd-mono);font-size:13px" />
                        <span style="font-family:var(--chvd-mono);font-size:12px;color:var(--chvd-ink-muted)">MB — steps quality down until it fits</span>
                    </div>
                }

                <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;font-family:var(--chvd-mono);font-size:11px;color:var(--chvd-ink-muted)">
                    <Icon Name="folder" Size="13" />
                    <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@_pressFolder">@_pressFolder</span>
                    <button @onclick="ChangePressFolder" style="background:none;border:none;color:var(--chvd-binding);cursor:pointer;font-family:var(--chvd-mono);font-size:11px">change…</button>
                </div>

                @if (_pressResult is not null)
                {
                    <div style="background:var(--chvd-surface-lo);border:var(--chvd-stroke) solid var(--chvd-border-soft);border-radius:10px;padding:12px 14px;margin-bottom:14px">
                        <div style="font-size:15px;margin-bottom:6px">@SizeOf(_pressResult.BeforeBytes) → <span style="color:var(--chvd-binding)">@SizeOf(_pressResult.AfterBytes)</span> <span style="font-family:var(--chvd-mono);font-size:12px;color:var(--chvd-ink-muted)">(@_pressResult.SavedPercent.ToString("0.#")% smaller)</span></div>
                        <div style="font-family:var(--chvd-mono);font-size:11px;color:var(--chvd-ink-muted)">@_pressResult.ImagesRecompressed images · @_pressResult.StreamsCompressed streams · @_pressResult.ObjectsRemoved objects removed</div>
                        <button @onclick="OpenPressResult" style="margin-top:10px;font-family:var(--chvd-mono);font-size:12px;color:var(--chvd-binding);background:none;border:var(--chvd-stroke) solid var(--chvd-binding);border-radius:6px;padding:5px 12px;cursor:pointer">open pressed file</button>
                    </div>
                }

                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
                    <span style="font-family:var(--chvd-serif-body);font-size:12px;color:var(--chvd-ink-muted);flex:1">@(_pressStatus ?? "A new …-pressed.pdf is created; the original is untouched.")</span>
                    <button @onclick="RunPress" disabled="@_pressBusy" style="font-family:var(--chvd-mono);font-size:13px;padding:8px 18px;border-radius:8px;border:none;cursor:pointer;background:var(--chvd-binding);color:var(--chvd-surface-lo);@(_pressBusy ? "opacity:0.6" : "")">@(_pressBusy ? "pressing…" : "Press →")</button>
                </div>
            </div>
        </div>
    }

    @if (tab is null)
    {
        <div class="rempty">
            <Icon Name="file-pdf" Size="40" />
            <div class="rempty-t">Open a document to start reading</div>
            <button class="rempty-btn" @onclick="OpenViaPicker">Fetch…</button>
        </div>
    }
    else if (tab.IsLoading)
    {
        <div class="rempty">
            <div class="rload-icon"><Icon Name="file-pdf" Size="40" /></div>
            <div class="rempty-t">Opening @tab.FileName…</div>
        </div>
    }
    else if (tab.Error is not null)
    {
        <div class="rempty">
            <Icon Name="file-pdf" Size="40" />
            <div class="rempty-t">@tab.Error</div>
            <button class="rempty-btn" @onclick="OpenViaPicker">Fetch…</button>
        </div>
    }
    else if (tab.Session is { Document.IsXfaForm: true })
    {
        <div class="rempty">
            <Icon Name="file-pdf" Size="40" />
            <div class="rempty-t">@tab.FileName is a dynamic XFA form, which Chuvadi can't display.</div>
            <div class="rempty-sub">This form's content lives entirely in a separate XFA layer with no static page to draw. Open it in Adobe Acrobat to view or fill it. (Hybrid XFA forms that have page content open normally.)</div>
        </div>
    }
    else if (tab.Session is not null)
    {
        var session = tab.Session;
        <div class="rdesk @LayoutClass @(CurScale > 1.001 ? "zoomed" : null) @(Tab?.ScrollLocked == true ? "locked" : null)"
             style="--rpage-zoom:@Zoom" tabindex="-1" @ref="_desk">
            @foreach (var n in _pages)
            {
                <div class="rpage-wrap" data-page="@n" @key="n">
                    <div class="rpage @(_curl ? "curl" : null)">
                        @if (session.TryGetRenderedSvg(n, out var svg))
                        {
                            <PageSvg Svg="@svg" Rotation="@RotationFor(n)" />
                        }
                        else
                        {
                            <div class="rpage-load">page @(n + 1)</div>
                        }
                        @if (_markup)
                        {
                            <div class="mk-layer @(_mkTool == "text" ? "textmode" : null) @((_mkTool == "rect" || _mkTool == "line") ? "drawmode" : null)" data-page="@n"
                                 @onpointerdown="e => MkDown(e, n)" @onpointermove="MkMove" @onpointerup="MkUp">
                                @if (_texts.TryGetValue(n, out var tboxes))
                                {
                                    @foreach (var t in tboxes)
                                    {
                                        var tb = t;
                                        var isSel = ReferenceEquals(_selText, tb);
                                        <div class="mk-text @(isSel ? "sel" : null)"
                                             style="left:@Pct(tb.X);top:@Pct(tb.Y);width:@Pct(tb.W);height:@Pct(tb.H);transform:rotate(@Deg(tb.Rotation)deg)"
                                             @onpointerdown:stopPropagation="true" @onpointerdown="() => SelectText(n, tb)">
                                            <textarea class="mk-ta" spellcheck="false"
                                                      style="@TextStyle(tb)"
                                                      @bind="tb.Text" @bind:event="oninput"
                                                      @onfocus="() => SelectText(n, tb)"></textarea>
                                            @if (isSel)
                                            {
                                                <span class="mk-th move" title="Move"
                                                      @onpointerdown:stopPropagation="true" @onpointerdown="e => StartMove(e, n, tb)">✣</span>
                                                <span class="mk-th resize" title="Resize"
                                                      @onpointerdown:stopPropagation="true" @onpointerdown="e => StartResize(e, n, tb)"></span>
                                            }
                                        </div>
                                    }
                                }
                                @if (_textDraft is { } td && _textDraftPage == n)
                                {
                                    <div class="mk-text draft" style="left:@Pct(td.X);top:@Pct(td.Y);width:@Pct(td.W);height:@Pct(td.H)"></div>
                                }

                                @* Shapes: rectangles as boxes, lines as an SVG overlay. *@
                                @if (_shapes.TryGetValue(n, out var shapeList))
                                {
                                    @foreach (var s in shapeList.Where(s => s.Kind == ShapeKind.Rectangle))
                                    {
                                        var sb = s;
                                        var selS = ReferenceEquals(_selShape, sb);
                                        <div class="mk-shape rect @(selS ? "sel" : null)"
                                             style="left:@Pct(sb.X);top:@Pct(sb.Y);width:@Pct(sb.W);height:@Pct(sb.H);border-color:@sb.StrokeHex;border-width:@(ShapeBorderPx(sb.StrokeWidthPt))px;background:@(string.IsNullOrEmpty(sb.FillHex) ? "transparent" : sb.FillHex)"
                                             @onpointerdown:stopPropagation="true" @onpointerdown="e => StartMoveShape(e, n, sb)">
                                            @if (selS)
                                            {
                                                <span class="mk-th resize" title="Resize"
                                                      @onpointerdown:stopPropagation="true" @onpointerdown="e => StartResizeShape(e, n, sb)"></span>
                                            }
                                        </div>
                                    }

                                    <svg class="mk-shape-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
                                        @foreach (var s in shapeList.Where(s => s.Kind == ShapeKind.Line))
                                        {
                                            var sb = s;
                                            var selS = ReferenceEquals(_selShape, sb);
                                            <line x1="@F(sb.X * 100)" y1="@F(sb.Y * 100)" x2="@F((sb.X + sb.W) * 100)" y2="@F((sb.Y + sb.H) * 100)"
                                                  stroke="@sb.StrokeHex" stroke-width="@F(sb.StrokeWidthPt)" stroke-linecap="round"
                                                  vector-effect="non-scaling-stroke" class="@(selS ? "sel" : null)" />
                                            <line x1="@F(sb.X * 100)" y1="@F(sb.Y * 100)" x2="@F((sb.X + sb.W) * 100)" y2="@F((sb.Y + sb.H) * 100)"
                                                  stroke="transparent" stroke-width="12" vector-effect="non-scaling-stroke"
                                                  style="pointer-events:stroke;cursor:move"
                                                  @onpointerdown:stopPropagation="true" @onpointerdown="e => StartMoveShape(e, n, sb)" />
                                        }
                                    </svg>

                                    @foreach (var s in shapeList.Where(s => s.Kind == ShapeKind.Line && ReferenceEquals(_selShape, s)))
                                    {
                                        var sb = s;
                                        <span class="mk-line-end" style="left:@Pct(sb.X);top:@Pct(sb.Y)" title="Move start"
                                              @onpointerdown:stopPropagation="true" @onpointerdown="e => StartLineEnd(e, n, sb, false)"></span>
                                        <span class="mk-line-end" style="left:@Pct(sb.X + sb.W);top:@Pct(sb.Y + sb.H)" title="Move end"
                                              @onpointerdown:stopPropagation="true" @onpointerdown="e => StartLineEnd(e, n, sb, true)"></span>
                                    }
                                }
                                @if (_shapeDraft is { } sd && _shapeDraftPage == n)
                                {
                                    @if (_mkTool == "line")
                                    {
                                        <svg class="mk-shape-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
                                            <line x1="@F(sd.X * 100)" y1="@F(sd.Y * 100)" x2="@F((sd.X + sd.W) * 100)" y2="@F((sd.Y + sd.H) * 100)"
                                                  stroke="@_shapeStroke" stroke-width="@F(_shapeStrokeWidth)" stroke-linecap="round"
                                                  vector-effect="non-scaling-stroke" stroke-dasharray="4 3" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <div class="mk-shape rect draft" style="left:@Pct(sd.X);top:@Pct(sd.Y);width:@Pct(sd.W);height:@Pct(sd.H);border-color:@_shapeStroke"></div>
                                    }
                                }

                                @* Images. *@
                                @if (_images.TryGetValue(n, out var imageList))
                                {
                                    @foreach (var im in imageList)
                                    {
                                        var ib = im;
                                        var selI = ReferenceEquals(_selImage, ib);
                                        <div class="mk-image @(selI ? "sel" : null)"
                                             style="left:@Pct(ib.X);top:@Pct(ib.Y);width:@Pct(ib.W);height:@Pct(ib.H)"
                                             @onpointerdown:stopPropagation="true" @onpointerdown="e => StartMoveImage(e, n, ib)">
                                            <img src="@ib.DataUrl" draggable="false" />
                                            @if (selI)
                                            {
                                                <span class="mk-th resize" title="Resize"
                                                      @onpointerdown:stopPropagation="true" @onpointerdown="e => StartResizeImage(e, n, ib)"></span>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                        @if (_findOpen && _findByPage.TryGetValue(n, out var pageHits))
                        {
                            @foreach (var fm in pageHits)
                            {
                                var isCur = ReferenceEquals(fm, CurrentFindMatch);
                                @foreach (var hb in fm.Boxes)
                                {
                                    <div class="rfind-hl @(isCur ? "cur" : null)"
                                         style="left:@Pct(hb.X);top:@Pct(hb.Y);width:@Pct(hb.W);height:@Pct(hb.H * 1.3)"></div>
                                }
                            }
                        }
                        @if (Tab?.StampOpen == true)
                        {
                            <StampPreview Watermark="Tab!.Watermark" HeaderFooter="Tab!.HeaderFooter"
                                          PageNumber="n + 1" TotalPages="doc?.PageCount ?? 1"
                                          FileName="@(Tab?.FileName ?? "document.pdf")" />
                        }
                        @if (_curl)
                        {
                            <span class="rcurl"></span>
                        }
                    </div>
                    @if (doc is not null)
                    {
                        <button class="rpage-send" title="Send page @(n + 1) to a desk"
                                @onclick="() => ToggleSendMenu(n)" @onclick:stopPropagation="true">
                            <Icon Name="grid-view" Size="14" />
                        </button>
                        @if (_sendMenuPage == n)
                        {
                            <div class="rpage-send-menu" @onclick:stopPropagation="true">
                                <div class="rsm-h">Send page @(n + 1) to…</div>
                                @foreach (var d in Bench.Desks)
                                {
                                    var dd = d;
                                    <button class="rsm-item" @onclick="() => SendPageToDesk(n, dd.Id)">
                                        <Icon Name="grid-view" Size="13" /> <span>@DeskLabel(dd)</span>
                                    </button>
                                }
                                <button class="rsm-item rsm-new" @onclick="() => SendPageToNewDesk(n)" disabled="@(!Bench.CanAddDesk)" title="@(Bench.CanAddDesk ? "Add a new desk" : "30-desk limit reached")">
                                    <Icon Name="plus" Size="13" /> <span>New desk</span>
                                </button>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }

    @if (_markup && doc is not null && _sigOpen)
    {
        <div class="rdrawer sigdrawer">
            <div class="rdrawer-h">
                <span>Add signature</span>
                <span class="rd-h-btns">
                    <button @onclick="CloseSignature" aria-label="Close"><Icon Name="x" Size="15" /></button>
                </span>
            </div>

            <div class="sig-modes">
                <button class="sig-mode @(_sigMode == "type" ? "on" : null)" @onclick='() => _sigMode = "type"'>Type</button>
                <button class="sig-mode @(_sigMode == "upload" ? "on" : null)" @onclick='() => _sigMode = "upload"'>Upload</button>
            </div>

            @if (_sigMode == "type")
            {
                <input class="stamp-in" placeholder="Type your name" maxlength="60" @bind="_sigText" @bind:event="oninput" />
                <div class="stamp-row">
                    <select class="stamp-sel" @bind="_sigFontName">
                        @foreach (var f in _sigFonts)
                        {
                            <option value="@f.Name">@f.Name</option>
                        }
                    </select>
                    <input type="color" @bind="_sigColor" @bind:event="oninput" title="Ink colour" />
                </div>
                <div class="sig-preview" style="@SigPreviewStyle">@(string.IsNullOrWhiteSpace(_sigText) ? "Your signature" : _sigText)</div>
                <button class="sig-place" disabled="@(string.IsNullOrWhiteSpace(_sigText))" @onclick="PlaceTypedSignature">Place signature</button>
            }
            else
            {
                <p class="sig-hint">Pick a PNG or JPG of your signature — a transparent PNG sits best on the page.</p>
                <button class="sig-place" @onclick="UploadSignature">Choose image…</button>
            }

            @if (_sigError is { } se)
            {
                <div class="sig-err">@se</div>
            }
            else
            {
                <p class="sig-note">Placed signatures are normal overlays — drag, resize, or delete them, then Save As.</p>
            }
        </div>
    }

    @if (doc is not null && Tab?.StampOpen == true)
    {
        var t = Tab!;
        var wm = t.Watermark;
        var hf = t.HeaderFooter;
        <div class="rdrawer stampdrawer">
            <div class="rdrawer-h">
                <span>Watermark &amp; header/footer</span>
                <span class="rd-h-btns">
                    <button @onclick="ToggleStamp" aria-label="Close"><Icon Name="x" Size="15" /></button>
                </span>
            </div>

            <div class="rd-grp">WATERMARK</div>
            <input class="stamp-in" placeholder="Watermark text (blank = off)" @bind="wm.Text" @bind:event="oninput" />
            <div class="stamp-row">
                <select class="stamp-sel" @bind="wm.FontFamily">
                    <option value="Helvetica">Helvetica</option>
                    <option value="Times">Times</option>
                    <option value="Courier">Courier</option>
                </select>
                <button class="stamp-chip @(wm.Bold ? "on" : null)" @onclick="() => wm.Bold = !wm.Bold"><b>B</b></button>
                <button class="stamp-chip @(wm.Italic ? "on" : null)" @onclick="() => wm.Italic = !wm.Italic"><i>I</i></button>
                <input type="color" @bind="wm.ColorHex" @bind:event="oninput" title="Colour" />
            </div>
            <div class="stamp-row">
                <label>Size</label>
                <input type="range" min="8" max="144" step="1" @bind="wm.FontSize" @bind:event="oninput" />
                <span class="stamp-val">@(((int)wm.FontSize))</span>
            </div>
            <div class="stamp-row">
                <label>Opacity</label>
                <input type="range" min="0.05" max="1" step="0.05" @bind="wm.Opacity" @bind:event="oninput" />
                <span class="stamp-val">@(((int)(wm.Opacity * 100)))%</span>
            </div>
            <div class="stamp-row">
                <label>Angle</label>
                @foreach (var a in new[] { 0, 45, 90, 315 })
                {
                    <button class="stamp-chip @((int)wm.RotationDegrees == a ? "on" : null)" @onclick="() => wm.RotationDegrees = a">@(a)°</button>
                }
            </div>
            <label class="stamp-toggle"><input type="checkbox" @bind="wm.AllPages" /> All pages</label>
            @if (!wm.AllPages)
            {
                <div class="stamp-row">
                    <label>Pages</label>
                    <input type="number" min="1" class="stamp-num" @bind="wm.FromPage" /> –
                    <input type="number" min="0" class="stamp-num" @bind="wm.ToPage" placeholder="end" />
                </div>
            }

            <div class="rd-grp">HEADER / FOOTER</div>
            <label class="stamp-toggle"><input type="checkbox" @bind="hf.HeaderEnabled" /> Header</label>
            @if (hf.HeaderEnabled)
            {
                <div class="stamp-slots">
                    <BandSlotEditor @bind-Value="hf.HeaderLeft" Placeholder="left" />
                    <BandSlotEditor @bind-Value="hf.HeaderCenter" Placeholder="center" />
                    <BandSlotEditor @bind-Value="hf.HeaderRight" Placeholder="right" />
                </div>
            }
            <label class="stamp-toggle"><input type="checkbox" @bind="hf.FooterEnabled" /> Footer</label>
            @if (hf.FooterEnabled)
            {
                <div class="stamp-slots">
                    <BandSlotEditor @bind-Value="hf.FooterLeft" Placeholder="left" />
                    <BandSlotEditor @bind-Value="hf.FooterCenter" Placeholder="center" />
                    <BandSlotEditor @bind-Value="hf.FooterRight" Placeholder="right" />
                </div>
            }
            <div class="stamp-row">
                <label>Size</label>
                <input type="range" min="6" max="24" step="1" @bind="hf.FontSize" @bind:event="oninput" />
                <span class="stamp-val">@(((int)hf.FontSize))</span>
                <input type="color" @bind="hf.ColorHex" @bind:event="oninput" title="Text colour" />
            </div>
            <div class="stamp-row">
                <label class="stamp-toggle"><input type="checkbox" @bind="hf.BackgroundEnabled" /> Band fill</label>
                @if (hf.BackgroundEnabled)
                {
                    <input type="color" @bind="hf.BackgroundHex" @bind:event="oninput" />
                }
            </div>
            <label class="stamp-toggle"><input type="checkbox" @bind="hf.AllPages" /> All pages</label>
            @if (!hf.AllPages)
            {
                <div class="stamp-row">
                    <label>Pages</label>
                    <input type="number" min="1" class="stamp-num" @bind="hf.FromPage" /> –
                    <input type="number" min="0" class="stamp-num" @bind="hf.ToPage" placeholder="end" />
                </div>
            }
            <div class="stamp-note">Fit: Overlay (Shrink fits await a library fix).</div>

            <div class="stamp-actions">
                <button class="mk-btn" @onclick="StampSaveInPlace" disabled="@(!HasStamp || _stampSaving)" title="Overwrite the open file">@(_stampSaving ? "Saving…" : "Save")</button>
                <button class="mk-btn primary" @onclick="StampSaveAs" disabled="@(!HasStamp || _stampSaving)" title="Save to a new file">@(_stampSaving ? "Saving…" : "Save as new PDF")</button>
            </div>
            @if (_stampStatus is { } st)
            {
                <div class="rd-status @(_stampError ? "err" : null)">@st</div>
            }
        </div>
    }

    @if (_snapMenuOpen && _snapBase64 is not null)
    {
        <div class="rsnap-backdrop" @onclick="CloseSnapMenu"></div>
        <div class="rsnap-menu" @onclick:stopPropagation="true">
            <div class="rsnap-head">Snapshot · page @(_snapPage + 1)</div>
            <img class="rsnap-preview" src="data:image/png;base64,@_snapBase64" alt="snapshot preview" />
            @if (!_snapDeskMenu)
            {
                <button class="rsnap-item" @onclick="SnapshotSave"><Icon Name="download" Size="15" /> <span>Save as PNG…</span></button>
                <button class="rsnap-item" @onclick="SnapshotCopy"><Icon Name="copy" Size="15" /> <span>Copy to clipboard</span></button>
                <button class="rsnap-item" @onclick="() => _snapDeskMenu = true"><Icon Name="grid-view" Size="15" /> <span>Send to desk…</span></button>
            }
            else
            {
                <div class="rsnap-desks">
                    @foreach (var dd in Bench.Desks)
                    {
                        <button class="rsnap-item" @onclick="() => SnapshotToDesk(dd.Id)"><Icon Name="grid-view" Size="13" /> <span>@DeskLabel(dd)</span></button>
                    }
                    <button class="rsnap-item rsnap-new" @onclick="SnapshotToNewDesk" disabled="@(!Bench.CanAddDesk)" title="@(Bench.CanAddDesk ? "Add a new desk" : "30-desk limit reached")"><Icon Name="plus" Size="13" /> <span>New desk</span></button>
                </div>
            }
            @if (_snapStatus is { } ss)
            {
                <div class="rsnap-status">@ss</div>
            }
        </div>
    }

    @if (doc is not null && _findOpen)
    {
        <div class="rfind">
            <input class="rfind-box" placeholder="Find in document…" value="@_findQuery"
                   @ref="_findBoxRef"
                   @oninput="e => _findQuery = e.Value?.ToString() ?? string.Empty"
                   @onfocus="OnFindFocus" @onkeydown="OnFindKey" />
            <button class="rfind-chip @(_findWholeWord ? "on" : null)" @onclick="ToggleWholeWord" title="Whole word">word</button>
            <span class="rfind-count">@FindCountLabel</span>
            @if (_findStatus is { } fs)
            {
                <span class="rfind-note">@fs</span>
            }
            <button class="rfind-nav" @onclick="PrevMatch" disabled="@(_findMatches.Count == 0)" title="Previous (Shift+Enter)"><Icon Name="chevron-up" Size="15" /></button>
            <button class="rfind-nav" @onclick="NextMatch" disabled="@(_findMatches.Count == 0)" title="Next (Enter)"><Icon Name="chevron-down" Size="15" /></button>
            <button class="rfind-x" @onclick="CloseFind" title="Close (Esc)"><Icon Name="x" Size="14" /></button>
        </div>
    }

    @if (doc is not null && _drawerOpen)
    {
        <div class="rdrawer">
            <div class="rdrawer-h">
                <span>View</span>
                <span class="rd-h-btns">
                    <button class="@(_drawerPinned ? "on" : null)" @onclick="TogglePin" title="@(_drawerPinned ? "Unpin" : "Pin to right")"><Icon Name="pin" Size="14" /></button>
                    <button @onclick="ToggleDrawer" aria-label="Close"><Icon Name="x" Size="15" /></button>
                </span>
            </div>

            <div class="rd-grp">FIT</div>
            <button class="rd-item @(Tab?.FitMode == ReaderFitMode.Width ? "on" : null)" @onclick="FitWidth"><Icon Name="fit-width" Size="17" /> <span>Fit width</span></button>
            <button class="rd-item @(Tab?.FitMode == ReaderFitMode.Page ? "on" : null)" @onclick="FitPage"><Icon Name="fit-page" Size="17" /> <span>Fit page</span></button>
            <button class="rd-item" @onclick="ActualSize"><Icon Name="actual-size" Size="17" /> <span>Actual size (100%)</span></button>

            <div class="rd-grp">ZOOM</div>
            <div class="rd-presets">
                @foreach (var p in _zoomPresets)
                {
