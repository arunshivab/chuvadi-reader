    private static string TextStyle(TextBox tb)
    {
        var fam = tb.FontFamily switch
        {
            "Times" => "'Times New Roman',Times,serif",
            "Courier" => "'Courier New',monospace",
            _ => "'Helvetica Neue',Arial,sans-serif",
        };
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        return $"font-family:{fam};font-size:{tb.FontSizePt.ToString(inv)}px;color:{tb.ColorHex};"
             + $"text-align:{tb.Align};line-height:{tb.LineHeight.ToString(inv)};"
             + $"font-weight:{(tb.Bold ? "700" : "400")};font-style:{(tb.Italic ? "italic" : "normal")}";
    }

    private void ClearMarkup()
    {
        _texts.Clear();
        _shapes.Clear();
        _images.Clear();
        _selText = null; _selShape = null; _selImage = null;
        _mkStatus = null; _mkSavedPath = null;
