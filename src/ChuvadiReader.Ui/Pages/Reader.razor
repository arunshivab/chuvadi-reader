    }

    private void RotateCurrent(int delta) => RotatePages(CurPage - 1, CurPage - 1, delta);

    private void RotateScopeBy(int delta)
    {
        var tab = Tabs.Active;
        if (tab?.Session is null)
        {
            return;
        }

        var last = tab.Session.Document.PageCount - 1;
        var (from, to) = _rotScope switch
        {
            RotateScopeKind.Document => (0, last),
            RotateScopeKind.Onward => (CurPage - 1, last),
            _ => (CurPage - 1, CurPage - 1),
        };
        RotatePages(from, to, delta);
    }

    private void RotatePages(int from, int to, int delta)
    {
        var tab = Tabs.Active;
        if (tab is null)
        {
            return;
        }

        PushUndo();
        for (var i = from; i <= to; i++)
        {
            var cur = tab.PageRotations.TryGetValue(i, out var r) ? r : 0;
            var next = ((cur + delta) % 360 + 360) % 360;
            if (next == 0)
            {
                tab.PageRotations.Remove(i);
            }
            else
            {
                tab.PageRotations[i] = next;
            }
        }

        StateHasChanged();
    }

    private async Task SetTool(ReaderTool tool)
    {
        _tool = _tool == tool ? ReaderTool.None : tool;
        if (_js is not null)
        {
            try { await _js.InvokeVoidAsync("setTool", _desk, ToolStr(_tool)); }
            catch { }
        }
        StateHasChanged();
    }

    private static string ToolStr(ReaderTool t) => t switch
    {
        ReaderTool.Hand => "hand",
        ReaderTool.Marquee => "area",
        ReaderTool.Loupe => "loupe",
        ReaderTool.Snapshot => "snapshot",
        _ => "none",
    };

