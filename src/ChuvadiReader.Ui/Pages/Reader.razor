    private async Task FitWidth()
    {
        PushUndo();
        if (Tabs.Active is { } t) { t.TwoPage = false; t.Continuous = true; }
        StateHasChanged();
        await Task.Delay(30);
        await ApplyFit(ReaderFitMode.Width);
    }

    private async Task FitPage()
    {
        PushUndo();
        if (Tabs.Active is { } t) { t.TwoPage = false; t.Continuous = false; }
        StateHasChanged();
        await Task.Delay(30);
        await ApplyFit(ReaderFitMode.Page);
    }

    private async Task ApplyFit(ReaderFitMode mode)
    {
        var tab = Tabs.Active;
        if (tab?.Session is null || _js is null)
        {
            return;
        }

        try
        {
            var s = await _js.InvokeAsync<double>("measureFit", _desk, mode == ReaderFitMode.Width ? "width" : "page");
            if (s > 0)
            {
                tab.Scale = s;
                tab.FitMode = mode;
                StateHasChanged();
            }
        }
        catch { }
    }

    private void ActualSize()
    {
        PushUndo();
        if (Tabs.Active is { } t)
        {
            t.Scale = 1.0;
            t.FitMode = ReaderFitMode.Free;
