    }

    private async Task SetColumns(bool two)
    {
        var tab = Tabs.Active;
        if (tab is null)
        {
            return;
        }

        PushUndo();
        tab.TwoPage = two;
        StateHasChanged();

        if (tab.FitMode != ReaderFitMode.Free)
        {
            await Task.Delay(40);   // let the desk re-render with the new column class
            await ApplyFit(tab.FitMode);
        }
    }

