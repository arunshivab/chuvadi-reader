    private static string MimeForPath(string path) =>
        (System.IO.Path.GetExtension(path) ?? "").ToLowerInvariant() switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".gif" => "image/gif",
            ".bmp" => "image/bmp",
            ".webp" => "image/webp",
            ".tif" or ".tiff" => "image/tiff",
            _ => "image/png",
        };

    /// <summary>Reads pixel dimensions from a PNG, JPEG, GIF or BMP header without decoding the
    /// whole image. Returns (0,0) if it can't be determined (callers fall back to a square box).</summary>
    private static (int W, int H) ImagePixelSize(byte[] b)
    {
        try
        {
            // PNG
            if (b.Length > 24 && b[0] == 0x89 && b[1] == 0x50 && b[2] == 0x4E && b[3] == 0x47)
            {
                int w = (b[16] << 24) | (b[17] << 16) | (b[18] << 8) | b[19];
                int h = (b[20] << 24) | (b[21] << 16) | (b[22] << 8) | b[23];
                return (w, h);
            }
            // GIF
            if (b.Length > 10 && b[0] == (byte)'G' && b[1] == (byte)'I' && b[2] == (byte)'F')
            {
                int w = b[6] | (b[7] << 8);
                int h = b[8] | (b[9] << 8);
                return (w, h);
            }
            // BMP
            if (b.Length > 26 && b[0] == (byte)'B' && b[1] == (byte)'M')
            {
                int w = b[18] | (b[19] << 8) | (b[20] << 16) | (b[21] << 24);
                int h = b[22] | (b[23] << 8) | (b[24] << 16) | (b[25] << 24);
                return (w, Math.Abs(h));
            }
            // JPEG — scan for a SOF marker.
            if (b.Length > 4 && b[0] == 0xFF && b[1] == 0xD8)
            {
                int i = 2;
                while (i + 9 < b.Length)
                {
                    if (b[i] != 0xFF) { i++; continue; }
                    int marker = b[i + 1];
                    if (marker is >= 0xC0 and <= 0xCF && marker != 0xC4 && marker != 0xC8 && marker != 0xCC)
                    {
                        int h = (b[i + 5] << 8) | b[i + 6];
                        int w = (b[i + 7] << 8) | b[i + 8];
                        return (w, h);
                    }
                    int len = (b[i + 2] << 8) | b[i + 3];
                    if (len <= 0) break;
                    i += 2 + len;
                }
            }
        }
        catch { }
        return (0, 0);
    }

    private void SetFont(TextBox tb, ChangeEventArgs e) => tb.FontFamily = e.Value?.ToString() ?? "Helvetica";
