    // Lazy-render trigger from the IntersectionObserver.
    private void EnsureRendered(int n)
    {
        var session = Tabs.Active?.Session;
        if (session is null || session.TryGetRenderedSvg(n, out _) || !_rendering.Add(n))
        {
            return;
        }

        _ = RenderOneAsync(session, n);
    }

    private async Task RenderOneAsync(IPdfSession session, int n)
    {
        try
        {
            await session.RenderPageSvgAsync(n);
        }
        catch
        {
            // A failed page stays a placeholder.
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task RenderPage(int n)
    {
        EnsureRendered(n);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnPageVisible(int page)
    {
        var tab = Tabs.Active;
        if (tab?.Session is null)
        {
            return Task.CompletedTask;
        }

        page = Math.Clamp(page, 1, tab.Session.Document.PageCount);
        if (page != tab.CurrentPage)
        {
            tab.CurrentPage = page;
            _pageInput = page.ToString();
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

