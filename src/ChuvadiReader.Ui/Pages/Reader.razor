    private async Task AddImageViaPicker()
    {
        SetMkTool("image");
        if (!_markup) return;
        EnsureMarkupDoc();
        IReadOnlyList<string> paths;
        try { paths = await Picker.PickImagesAsync(); }
        catch { return; }
        if (paths is null || paths.Count == 0) return;

        // Place onto the page currently most in view.
        int page = Math.Clamp(CurPage - 1, 0, (Doc?.PageCount ?? 1) - 1);
        await CacheLayerRect(page);   // so the initial height respects the image's aspect ratio
        var first = paths[0];
        try
        {
            var bytes = await Task.Run(() => System.IO.File.ReadAllBytes(first));
            var mime = MimeForPath(first);
            AddImageBox(page, bytes, mime);
        }
        catch (Exception ex)
        {
            _mkStatus = $"Could not load image: {ex.Message}";
            _mkError = true;
        }
        StateHasChanged();
    }

    /// <summary>Called from JS when an image is pasted or dropped (base64 payload).</summary>
    [JSInvokable]
    public void OnImageDropped(int page, double fx, double fy, string base64, string mime)
    {
        if (!_markup) return;
        if (Doc is null) return;
        EnsureMarkupDoc();
        try
        {
            var bytes = Convert.FromBase64String(base64);
            int p = Math.Clamp(page, 0, Doc.PageCount - 1);
            AddImageBox(p, bytes, string.IsNullOrEmpty(mime) ? "image/png" : mime, fx, fy);
            InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    [JSInvokable]
    public void OnImagePasted(string base64, string mime)
    {
        if (!_markup) return;
        if (Doc is null) return;
        int page = Math.Clamp(CurPage - 1, 0, Doc.PageCount - 1);
        OnImageDropped(page, -1, -1, base64, mime);
    }

    private void AddImageBox(int page, byte[] bytes, string mime, double fx = -1, double fy = -1)
    {
        if (bytes is null || bytes.Length == 0) return;
        var (natW, natH) = ImagePixelSize(bytes);
        double aspect = natH > 0 ? (double)natW / natH : 1.0;

        // Default width 30% of the page; height from aspect against the cached layer rect
        // (fall back to a square-ish box if we can't measure the layer yet).
        double w = 0.30;
        double h = 0.30;
        if (_mkRect.W > 0 && _mkRect.H > 0 && aspect > 0)
        {
            var pxW = w * _mkRect.W;
            var pxH = pxW / aspect;
            h = Clamp01(pxH / _mkRect.H);
        }
        double x = fx >= 0 ? Clamp01(fx - w / 2) : Clamp01(0.5 - w / 2);
        double y = fy >= 0 ? Clamp01(fy - h / 2) : Clamp01(0.5 - h / 2);
        if (x + w > 1) x = 1 - w;
        if (y + h > 1) y = 1 - h;

        var ib = new ImageBox
        {
            X = x, Y = y, W = w, H = h,
            Bytes = bytes, Aspect = aspect, Lock = true, Opacity = 1.0,
            DataUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}",
        };
        if (!_images.TryGetValue(page, out var list))
        {
            list = new List<ImageBox>();
            _images[page] = list;
        }
        list.Add(ib);
        _selImage = ib; _selImagePage = page;
        _selText = null; _selShape = null;
        _mkStatus = null; _mkSavedPath = null;
    }

