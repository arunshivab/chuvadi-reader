    [JSInvokable]
    public void OnScroll(double top)
    {
        // Keep the active tab's scroll position fresh in memory as the user scrolls, so
        // returning from the dashboard restores it even if teardown-time interop fails.
        if (Tabs.Active is { } tab)
        {
            tab.ScrollTop = top;
        }
