    private async Task SendPageToDesk(int page, Guid deskId)
    {
        _sendMenuPage = null;
        var active = Tabs.Active;
        if (active?.Path is null) return;
        try
        {
            var sourceIndex = await Bench.EnsureSourceAsync(active.Path, active.FileName);
            if (sourceIndex < 0) return;
            Bench.AddPageToDesk(deskId, sourceIndex, page);
            var desk = Bench.Desks.FirstOrDefault(d => d.Id == deskId);
            ShowToast($"Page {page + 1} → {(desk is null ? "desk" : DeskLabel(desk))}");
        }
        catch (Exception ex)
        {
            ShowToast($"Couldn't send page: {ex.Message}");
        }
    }

    private async Task SendPageToNewDesk(int page)
    {
        if (!Bench.CanAddDesk) return;
        var desk = Bench.AddDesk();
        await SendPageToDesk(page, desk.Id);
    }

    private void ShowToast(string message)
    {
        _toast = message;
        _toastCts?.Cancel();
        _toastCts = new System.Threading.CancellationTokenSource();
        var token = _toastCts.Token;
        _ = Task.Run(async () =>
        {
            try { await Task.Delay(2600, token); } catch { return; }
            if (token.IsCancellationRequested) return;
            _toast = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    // ── Watermark + header/footer (Stamp panel) — config lives on the active tab ──
    private bool _stampSaving;
    private string? _stampStatus;
    private bool _stampError;

    private bool HasStamp =>
        Tab is { } t && (!string.IsNullOrWhiteSpace(t.Watermark.Text) || t.HeaderFooter.HasAnyContent);

    private void ToggleStamp()
    {
        if (Tab is not { } t) return;
        t.StampOpen = !t.StampOpen;
        _stampStatus = null;
        if (t.StampOpen && _markup) ToggleMarkup(); // don't run markup + stamp at once
    }

    private async Task StampSaveAs()
    {
        var active = Tabs.Active;
        if (active?.Path is null || !HasStamp) return;
        var suggested = System.IO.Path.GetFileNameWithoutExtension(active.Path) + "-stamped.pdf";
        var output = await Picker.PickSavePdfAsync(suggested);
        if (string.IsNullOrWhiteSpace(output)) return;
        await RunStamp(output!, inPlace: false);
    }

    private async Task StampSaveInPlace()
    {
        var active = Tabs.Active;
        if (active?.Path is null || !HasStamp) return;
        var dir = System.IO.Path.GetDirectoryName(active.Path) ?? "";
        var temp = System.IO.Path.Combine(dir, "~" + System.IO.Path.GetFileNameWithoutExtension(active.Path) + ".stamp-tmp.pdf");
        await RunStamp(temp, inPlace: true, finalPath: active.Path);
    }

    private async Task RunStamp(string output, bool inPlace, string? finalPath = null)
    {
        var active = Tabs.Active;
        if (active?.Path is null) return;

        _stampSaving = true; _stampStatus = null; _stampError = false;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var wm = string.IsNullOrWhiteSpace(active.Watermark.Text) ? null : active.Watermark;
            var hf = active.HeaderFooter.HasAnyContent ? active.HeaderFooter : null;
            await Stamp.ApplyToFileAsync(active.Path, output, wm, hf, active.FileName);

            if (inPlace && finalPath is not null)
            {
                await Tabs.ReloadActiveAsync(async () =>
                {
                    try
                    {
                        if (System.IO.File.Exists(finalPath)) System.IO.File.Replace(output, finalPath, null);
                        else System.IO.File.Move(output, finalPath);
                    }
                    catch
                    {
                        System.IO.File.Copy(output, finalPath, true);
                        try { System.IO.File.Delete(output); } catch { }
                    }
                    await Task.CompletedTask;
                });
                // The stamp is now baked into the file; retire the live preview so it doesn't
                // double over the reloaded page, and confirm with a toast.
                active.StampOpen = false;
                _stampStatus = null;
                ShowToast($"Saved → {System.IO.Path.GetFileName(finalPath)}");
            }
            else
            {
                _stampStatus = $"Saved → {System.IO.Path.GetFileName(output)}";
            }
            _stampError = false;
        }
        catch (Exception ex)
        {
            _stampStatus = ex.Message;
            _stampError = true;
        }
        finally
        {
            _stampSaving = false;
            StateHasChanged();
        }
    }

