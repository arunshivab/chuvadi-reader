    // ── Find in document (Ctrl+F) ──
    private bool _findOpen;
    private string _findQuery = "";
    private bool _findWholeWord;
    private bool _findSearching;
    private string? _findStatus;
    private List<RedactService.RedactSearchMatch> _findMatches = new();
    private Dictionary<int, List<RedactService.RedactSearchMatch>> _findByPage = new();
    private int _findIndex = -1;
    private ElementReference _findBoxRef;
    private string? _lastFindQuery;

    private RedactService.RedactSearchMatch? CurrentFindMatch =>
        _findIndex >= 0 && _findIndex < _findMatches.Count ? _findMatches[_findIndex] : null;

    private string FindCountLabel =>
        _findSearching ? "…"
        : _findMatches.Count == 0 ? (_lastFindQuery is null ? "" : "0/0")
        : $"{_findIndex + 1}/{_findMatches.Count}";

    [JSInvokable]
    public async Task OpenFind()
    {
        _findOpen = true;
        StateHasChanged();
        await Task.Yield();
        try { await _findBoxRef.FocusAsync(); } catch { }
    }

    private void ToggleWholeWord()
    {
        _findWholeWord = !_findWholeWord;
        if (!string.IsNullOrWhiteSpace(_findQuery)) _ = RunFindSearch();
    }

    private void CloseFind()
    {
        _findOpen = false;
        ClearFind();
    }

    private void ClearFind()
    {
        _findMatches = new();
        _findByPage = new();
        _findIndex = -1;
        _findStatus = null;
        _lastFindQuery = null;
    }

    private async Task OnFindFocus()
    {
        if (!string.IsNullOrEmpty(_findQuery)) return;   // never clobber a typed query
        if (_js is null) return;
        try
        {
            var sel = await _js.InvokeAsync<string?>("selectedText");
            if (!string.IsNullOrWhiteSpace(sel))
            {
                _findQuery = sel!.Trim();
                StateHasChanged();
                await RunFindSearch();
            }
        }
        catch { }
    }

    private async Task OnFindKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            // Re-search when the query changed; otherwise step to the next/previous match.
            if (!string.Equals(_findQuery, _lastFindQuery, StringComparison.Ordinal)) await RunFindSearch();
            else if (e.ShiftKey) await PrevMatch();
            else await NextMatch();
        }
        else if (e.Key == "Escape")
        {
            CloseFind();
        }
    }

    private async Task RunFindSearch()
    {
        var path = Tab?.Path;
        if (path is null || string.IsNullOrWhiteSpace(_findQuery)) return;

        _findSearching = true; _findStatus = null;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var found = await Redact.SearchAsync(path, _findQuery, caseSensitive: false, wholeWord: _findWholeWord);
            _findMatches = found.Where(f => f.Boxes.Count > 0).ToList();
            _findByPage = _findMatches.GroupBy(m => m.PageIndex).ToDictionary(g => g.Key, g => g.ToList());
            _lastFindQuery = _findQuery;
            _findIndex = _findMatches.Count > 0 ? 0 : -1;
            if (_findIndex == 0) await JumpToFindMatch();
        }
        catch (Exception ex)
        {
            _findStatus = "Search failed: " + ex.Message;
        }
        finally
        {
            _findSearching = false;
            StateHasChanged();
        }
    }

    private async Task NextMatch()
    {
        if (_findMatches.Count == 0) return;
        _findIndex = (_findIndex + 1) % _findMatches.Count;
        await JumpToFindMatch();
    }

    private async Task PrevMatch()
    {
        if (_findMatches.Count == 0) return;
        _findIndex = (_findIndex - 1 + _findMatches.Count) % _findMatches.Count;
        await JumpToFindMatch();
    }

    private async Task JumpToFindMatch()
    {
        var m = CurrentFindMatch;
        if (m is null || _js is null) return;
        try { await _js.InvokeVoidAsync("scrollToPage", _desk, m.PageIndex); } catch { }
        StateHasChanged();
    }

    // ── Bookmarks panel (#41): read, navigate, edit, save ────────────────────────
    private bool _bm;
    private List<BookmarkNode>? _bmTree;
    private BookmarkNode? _bmSel;
    private BookmarkNode? _bmRenaming;
    private string? _bmStatus;
    private bool _bmBusy;
    private readonly OutlineService _outline = new();

    private void ToggleBookmarks()
    {
        _bm = !_bm;
        if (_bm) LoadBookmarks();
    }

    private void LoadBookmarks()
    {
        _bmStatus = null; _bmSel = null; _bmRenaming = null;
        var path = Tab?.Path;
        try { _bmTree = path is null ? new() : _outline.Read(path).Select(n => n.Clone()).ToList(); }
        catch { _bmTree = new(); }
    }

    private IEnumerable<(BookmarkNode node, int depth)> BmFlat()
    {
        var list = new List<(BookmarkNode, int)>();
        void Walk(List<BookmarkNode> ns, int d)
        {
            foreach (var n in ns) { list.Add((n, d)); Walk(n.Children, d + 1); }
        }
        if (_bmTree is not null) Walk(_bmTree, 0);
        return list;
    }

    private void BmSelect(BookmarkNode n) => _bmSel = n;

    private async Task BmGo(BookmarkNode n)
    {
        _bmSel = n;
        if (_js is not null) { try { await _js.InvokeVoidAsync("scrollToPage", _desk, n.PageIndex); } catch { } }
    }

    private void BmBeginRename(BookmarkNode n) { _bmSel = n; _bmRenaming = n; }
    private void BmEndRename() => _bmRenaming = null;
    private void BmRenameKey(KeyboardEventArgs e) { if (e.Key is "Enter" or "Escape") _bmRenaming = null; }

    private void BmAddCurrent()
    {
        _bmTree ??= new();
        var page = Math.Max(0, (Tab?.CurrentPage ?? 1) - 1);
        var node = new BookmarkNode($"Page {page + 1}", page);
        _bmTree.Add(node);
        _bmSel = node; _bmRenaming = node;
    }

    private bool BmLocate(BookmarkNode target, List<BookmarkNode> list, BookmarkNode? owner,
        out List<BookmarkNode> outList, out int idx, out BookmarkNode? outOwner)
    {
        for (var i = 0; i < list.Count; i++)
        {
            if (ReferenceEquals(list[i], target)) { outList = list; idx = i; outOwner = owner; return true; }
            if (BmLocate(target, list[i].Children, list[i], out outList, out idx, out outOwner)) return true;
        }
        outList = null!; idx = -1; outOwner = null; return false;
    }

    private void BmMove(int dir)
    {
        if (_bmSel is null || _bmTree is null) return;
        if (!BmLocate(_bmSel, _bmTree, null, out var list, out var idx, out _)) return;
        var j = idx + dir;
        if (j < 0 || j >= list.Count) return;
        (list[idx], list[j]) = (list[j], list[idx]);
    }

    private void BmIndent()
    {
        if (_bmSel is null || _bmTree is null) return;
        if (!BmLocate(_bmSel, _bmTree, null, out var list, out var idx, out _)) return;
        if (idx == 0) return; // no preceding sibling to nest under
        var prev = list[idx - 1];
        list.RemoveAt(idx);
        prev.Children.Add(_bmSel);
    }

    private void BmOutdent()
    {
        if (_bmSel is null || _bmTree is null) return;
        if (!BmLocate(_bmSel, _bmTree, null, out var list, out var idx, out var owner)) return;
        if (owner is null) return; // already top-level
        if (!BmLocate(owner, _bmTree, null, out var ownerList, out var ownerIdx, out _)) return;
        list.RemoveAt(idx);
        ownerList.Insert(ownerIdx + 1, _bmSel);
    }

    private void BmDelete()
    {
        if (_bmSel is null || _bmTree is null) return;
        if (!BmLocate(_bmSel, _bmTree, null, out var list, out var idx, out _)) return;
        list.RemoveAt(idx);
        _bmSel = null; _bmRenaming = null;
    }

    private async Task BmSave()
    {
        var path = Tab?.Path;
        if (path is null || _bmTree is null) return;
        _bmBusy = true; _bmStatus = null; StateHasChanged();
        try
        {
            var output = System.IO.Path.Combine(System.IO.Path.GetTempPath(), $"chuvadi-toc-{Guid.NewGuid():N}.pdf");
            await _outline.WriteToFileAsync(path, output, _bmTree);
            await Tabs.ReloadActiveAsync(async () =>
            {
                try
                {
                    if (System.IO.File.Exists(path)) System.IO.File.Replace(output, path, null);
                    else System.IO.File.Move(output, path);
                }
                catch
                {
                    System.IO.File.Copy(output, path, true);
                    try { System.IO.File.Delete(output); } catch { }
                }
                await Task.CompletedTask;
            });
            _bmStatus = $"Saved {BmFlat().Count()} bookmark(s)";
        }
        catch (Exception ex) { _bmStatus = ex.Message; }
        finally { _bmBusy = false; StateHasChanged(); }
    }

    private static string Pct(double f) =>
        (f * 100).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";
    private static string Deg(double d) => d.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private static string F(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    // On-screen rectangle border thickness (px) — a readable preview of the stroke width in points.
    private static string ShapeBorderPx(double strokeWidthPt) =>
        Math.Clamp(strokeWidthPt, 1, 12).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static double Clamp01(double v) => v < 0 ? 0 : v > 1 ? 1 : v;

    private async Task CheckTaggedAsync()
    {
        var path = Tab?.Path;
        if (path is null) { _mkTagged = false; _mkTaggedPath = null; return; }
        if (path == _mkTaggedPath) return;
        _mkTaggedPath = path;
        var tagged = false;
        try { tagged = await Task.Run(() => Redact.IsTagged(path)); } catch { }
        _mkTagged = tagged;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleMarkup()
    {
        _markup = !_markup;
        _mkStatus = null; _mkSavedPath = null;
        _mkMode = MkMode.None; _textDraft = null; _shapeDraft = null;
        _selText = null; _selShape = null; _selImage = null;
        if (_markup)
        {
            _ = CheckTaggedAsync();
            if (_js is not null) _ = _js.InvokeVoidAsync("enableImageDrops");
        }
        else
        {
            if (_js is not null) _ = _js.InvokeVoidAsync("disableImageDrops");
        }
    }

    private void SetMkTool(string tool)
    {
        _mkTool = tool;
        _selText = null; _selShape = null; _selImage = null;
        _mkStatus = null; _mkSavedPath = null;
    }

    private void EnsureMarkupDoc()
    {
        var path = Tab?.Path;
        if (path != _mkDocPath)
        {
            _mkDocPath = path;
            _texts.Clear();
            _shapes.Clear();
            _images.Clear();
            _selText = null; _selShape = null; _selImage = null;
            _mkStatus = null; _mkSavedPath = null;
        }
    }

    private async Task<bool> CacheLayerRect(int page)
    {
        try
        {
            var r = await JS.InvokeAsync<MkRect?>("chuvadiReaderMkRect", page);
            if (r is null || r.width <= 0 || r.height <= 0) return false;
            _mkRect = (r.left, r.top, r.width, r.height);
            return true;
        }
        catch { return false; }
    }

    private async Task MkDown(PointerEventArgs e, int page)
    {
        if (!_markup || e.Button != 0) return;
        EnsureMarkupDoc();
        if (!await CacheLayerRect(page)) return;

        _mkStartX = Clamp01((e.ClientX - _mkRect.L) / _mkRect.W);
        _mkStartY = Clamp01((e.ClientY - _mkRect.T) / _mkRect.H);
        _mkStatus = null; _mkSavedPath = null;

        if (_mkTool == "rect" || _mkTool == "line")
        {
            _selShape = null;
            _mkMode = MkMode.ShapeDraw;
            _shapeDraftPage = page;
            _shapeDraft = new NormBox(_mkStartX, _mkStartY, 0, 0);
        }
        else if (_mkTool == "image")
        {
            // Image is placed via the picker / paste / drop, not by dragging on the page.
            _mkMode = MkMode.None;
        }
        else
        {
            _selText = null;
            _mkMode = MkMode.TextDraw;
            _textDraftPage = page;
            _textDraft = new NormBox(_mkStartX, _mkStartY, 0, 0);
        }
    }

    private void MkMove(PointerEventArgs e)
    {
        if (_mkMode == MkMode.None) return;
        var cx = Clamp01((e.ClientX - _mkRect.L) / _mkRect.W);
        var cy = Clamp01((e.ClientY - _mkRect.T) / _mkRect.H);

        switch (_mkMode)
        {
            case MkMode.TextDraw:
                _textDraft = new NormBox(Math.Min(_mkStartX, cx), Math.Min(_mkStartY, cy),
                                         Math.Abs(cx - _mkStartX), Math.Abs(cy - _mkStartY));
                break;
            case MkMode.MoveText when _dragText is { } d:
                d.X = Clamp01(_dragOX + (cx - _mkStartX));
                d.Y = Clamp01(_dragOY + (cy - _mkStartY));
                if (d.X + d.W > 1) d.X = 1 - d.W;
                if (d.Y + d.H > 1) d.Y = 1 - d.H;
                break;
            case MkMode.ResizeText when _dragText is { } d:
                d.W = Math.Clamp(_dragOW + (cx - _mkStartX), 0.03, 1 - d.X);
                d.H = Math.Clamp(_dragOH + (cy - _mkStartY), 0.02, 1 - d.Y);
                break;

            case MkMode.ShapeDraw:
                if (_mkTool == "line")
                {
                    // Free endpoints (signed), so any angle is allowed.
                    _shapeDraft = new NormBox(_mkStartX, _mkStartY, cx - _mkStartX, cy - _mkStartY);
                }
                else
                {
                    _shapeDraft = new NormBox(Math.Min(_mkStartX, cx), Math.Min(_mkStartY, cy),
                                              Math.Abs(cx - _mkStartX), Math.Abs(cy - _mkStartY));
                }
                break;

            case MkMode.MoveShape when _dragShape is { } s:
                if (s.Kind == ShapeKind.Line)
                {
                    // Translate both endpoints, keeping them on-page.
                    var nx = _dragOX + (cx - _mkStartX);
                    var ny = _dragOY + (cy - _mkStartY);
                    var minX = Math.Min(0, s.W); var maxX = Math.Max(0, s.W);
                    var minY = Math.Min(0, s.H); var maxY = Math.Max(0, s.H);
                    s.X = Math.Clamp(nx, -minX, 1 - maxX);
                    s.Y = Math.Clamp(ny, -minY, 1 - maxY);
                }
                else
                {
                    s.X = Clamp01(_dragOX + (cx - _mkStartX));
                    s.Y = Clamp01(_dragOY + (cy - _mkStartY));
                    if (s.X + s.W > 1) s.X = 1 - s.W;
                    if (s.Y + s.H > 1) s.Y = 1 - s.H;
                }
                break;
            case MkMode.ResizeShape when _dragShape is { } s:
                s.W = Math.Clamp(_dragOW + (cx - _mkStartX), 0.01, 1 - s.X);
                s.H = Math.Clamp(_dragOH + (cy - _mkStartY), 0.01, 1 - s.Y);
                break;
            case MkMode.MoveLineEnd when _dragShape is { } s:
                if (_lineEndIsEnd)
                {
                    s.W = cx - s.X;
                    s.H = cy - s.Y;
                }
                else
                {
                    var endX = s.X + s.W; var endY = s.Y + s.H;
                    s.X = cx; s.Y = cy;
                    s.W = endX - cx; s.H = endY - cy;
                }
                break;

            case MkMode.MoveImage when _dragImage is { } im:
                im.X = Clamp01(_dragOX + (cx - _mkStartX));
                im.Y = Clamp01(_dragOY + (cy - _mkStartY));
                if (im.X + im.W > 1) im.X = 1 - im.W;
                if (im.Y + im.H > 1) im.Y = 1 - im.H;
                break;
            case MkMode.ResizeImage when _dragImage is { } im:
                var rw = Math.Clamp(_dragOW + (cx - _mkStartX), 0.02, 1 - im.X);
                im.W = rw;
                if (im.Lock && _mkRect.W > 0 && _mkRect.H > 0 && im.Aspect > 0)
                {
                    // Keep the on-screen pixel aspect of the source image.
                    var pxW = rw * _mkRect.W;
                    var pxH = pxW / im.Aspect;
                    im.H = Math.Clamp(pxH / _mkRect.H, 0.02, 1 - im.Y);
                }
                else
                {
                    im.H = Math.Clamp(_dragOH + (cy - _mkStartY), 0.02, 1 - im.Y);
                }
                break;
        }
    }

    private void MkUp(PointerEventArgs e)
    {
        switch (_mkMode)
        {
            case MkMode.TextDraw:
                {
                    var d = _textDraft ?? new NormBox(_mkStartX, _mkStartY, 0, 0);
                    // Tiny drag = a click → default-sized box anchored at the click point.
                    var w = d.W < 0.04 ? 0.34 : d.W;
                    var h = d.H < 0.03 ? 0.06 : d.H;
                    var x = Math.Min(d.X, 1 - w);
                    var y = Math.Min(d.Y, 1 - h);
                    var tb = new TextBox { X = Clamp01(x), Y = Clamp01(y), W = w, H = h };
                    if (!_texts.TryGetValue(_textDraftPage, out var tlist))
                    {
                        tlist = new List<TextBox>();
                        _texts[_textDraftPage] = tlist;
                    }
                    tlist.Add(tb);
                    _selText = tb;
                    _selTextPage = _textDraftPage;
                }
                break;
            case MkMode.ShapeDraw:
                {
                    var d = _shapeDraft ?? new NormBox(_mkStartX, _mkStartY, 0, 0);
                    if (_mkTool == "line")
                    {
                        // Need a minimum length; a bare click does nothing.
                        if (Math.Abs(d.W) > 0.01 || Math.Abs(d.H) > 0.01)
                        {
                            var sb = new ShapeBox
                            {
                                Kind = ShapeKind.Line,
                                X = Clamp01(d.X), Y = Clamp01(d.Y), W = d.W, H = d.H,
                                StrokeHex = _shapeStroke, StrokeWidthPt = _shapeStrokeWidth,
                            };
                            AddShape(_shapeDraftPage, sb);
                        }
                    }
                    else
                    {
                        // Tiny drag = a click → default-sized rectangle at the click point.
                        var w = d.W < 0.02 ? 0.20 : d.W;
                        var h = d.H < 0.02 ? 0.12 : d.H;
                        var x = Math.Min(d.X, 1 - w);
                        var y = Math.Min(d.Y, 1 - h);
                        var sb = new ShapeBox
                        {
                            Kind = ShapeKind.Rectangle,
                            X = Clamp01(x), Y = Clamp01(y), W = w, H = h,
                            FillHex = _shapeFill, StrokeHex = _shapeStroke, StrokeWidthPt = _shapeStrokeWidth,
                        };
                        AddShape(_shapeDraftPage, sb);
                    }
                }
                break;
        }

        _mkMode = MkMode.None;
        _textDraft = null; _shapeDraft = null;
        _textDraftPage = -1; _shapeDraftPage = -1;
        _dragText = null; _dragShape = null; _dragImage = null;
    }

