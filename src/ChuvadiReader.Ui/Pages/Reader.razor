    private static readonly SigFont[] _sigFonts =
    {
        new("Script",  "",       "'Segoe Script','Brush Script MT','Lucida Handwriting',cursive"),
        new("Elegant", "italic", "'Gabriola','Palatino Linotype','Book Antiqua',serif"),
