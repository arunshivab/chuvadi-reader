    };
    private SigFont CurrentSigFont => _sigFonts.FirstOrDefault(f => f.Name == _sigFontName) ?? _sigFonts[0];
    private string SigCanvasFont => $"{CurrentSigFont.Style} 72px {CurrentSigFont.Family}".Trim();
    private string SigPreviewStyle =>
        $"font-style:{(string.IsNullOrEmpty(CurrentSigFont.Style) ? "normal" : CurrentSigFont.Style)};"
