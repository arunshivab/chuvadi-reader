    private Dictionary<int, PageText> BuildTextsDict() =>
        _texts
            .Where(kv => kv.Value.Any(t => !string.IsNullOrEmpty(t.Text)))
            .ToDictionary(
                kv => kv.Key,
                kv => new PageText(RotationFor(kv.Key),
                    kv.Value.Where(t => !string.IsNullOrEmpty(t.Text))
                        .Select(t => new TextAnno(t.X, t.Y, t.W, t.H, t.Text, t.FontFamily,
                            t.Bold, t.Italic, t.FontSizePt, t.ColorHex, t.Align, t.Rotation, t.LineHeight))
                        .ToList() as IReadOnlyList<TextAnno>));

    private Dictionary<int, PageShape> BuildShapesDict() =>
        _shapes
            .Where(kv => kv.Value.Count > 0)
            .ToDictionary(
                kv => kv.Key,
                kv => new PageShape(RotationFor(kv.Key),
                    kv.Value.Select(s => new ShapeAnno(
                            s.X, s.Y, s.W, s.H, s.Kind,
                            s.Kind == ShapeKind.Rectangle ? s.FillHex : null,
                            s.StrokeHex, s.StrokeWidthPt, 0))
                        .ToList() as IReadOnlyList<ShapeAnno>));

    private Dictionary<int, PageImage> BuildImagesDict() =>
        _images
            .Where(kv => kv.Value.Any(i => i.Bytes.Length > 0))
            .ToDictionary(
                kv => kv.Key,
                kv => new PageImage(RotationFor(kv.Key),
                    kv.Value.Where(i => i.Bytes.Length > 0)
                        .Select(i => new ImageAnno(i.X, i.Y, i.W, i.H, i.Bytes, 0, i.Opacity))
                        .ToList() as IReadOnlyList<ImageAnno>));

    private async Task SaveInPlace()
    {
        var active = Tabs.Active;
        // Overlay-only save.
        if (active?.Path is null || OverlayCount == 0) return;

        _mkSaving = true; _mkStatus = null; _mkSavedPath = null; _mkError = false;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var src = active.Path;
            var texts = BuildTextsDict();
            var imgs = BuildImagesDict();
            var shps = BuildShapesDict();
            var dir = System.IO.Path.GetDirectoryName(src) ?? "";
            var temp = System.IO.Path.Combine(dir, "~" + System.IO.Path.GetFileNameWithoutExtension(src) + ".chuvadi-tmp.pdf");

            // Build the edited file beside the original (no redactions here).
            await Redact.FlattenToFileAsync(src, temp, new Dictionary<int, PageRedaction>(), _mkColor, texts, imgs, shps);

            // Release the open document, swap the file in, then reopen in place.
            await Tabs.ReloadActiveAsync(async () =>
            {
                try
                {
                    if (System.IO.File.Exists(src)) System.IO.File.Replace(temp, src, null);
                    else System.IO.File.Move(temp, src);
                }
                catch
                {
                    System.IO.File.Copy(temp, src, true);
                    try { System.IO.File.Delete(temp); } catch { }
                }
                await Task.CompletedTask;
            });

            // Flattened into the file now — clear the editable overlays.
            _texts.Clear();
            _shapes.Clear();
            _images.Clear();
            _selText = null; _selShape = null; _selImage = null;
            _mkStatus = $"Saved to {System.IO.Path.GetFileName(src)}";
            _mkError = false;
        }
        catch (Exception ex)
        {
            _mkStatus = ex.Message;
            _mkError = true;
        }
        finally
        {
            _mkSaving = false;
            StateHasChanged();
        }
    }

    private async Task SaveMarkup()
    {
        var active = Tabs.Active;
        if (active?.Path is null || OverlayCount == 0) return;

        var suggested = System.IO.Path.GetFileNameWithoutExtension(active.Path) + "-edited.pdf";
        var output = await Picker.PickSavePdfAsync(suggested);
        if (string.IsNullOrWhiteSpace(output)) return;

        _mkSaving = true; _mkStatus = null; _mkSavedPath = null; _mkError = false;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var texts = BuildTextsDict();
            var imgs = BuildImagesDict();
            var shps = BuildShapesDict();

            await Redact.FlattenToFileAsync(active.Path, output!, new Dictionary<int, PageRedaction>(), _mkColor, texts, imgs, shps);
            _mkSavedPath = output;
            _mkStatus = $"Saved → {System.IO.Path.GetFileName(output)}";
            _mkError = false;
        }
        catch (Exception ex)
        {
            _mkStatus = ex.Message;
            _mkError = true;
        }
        finally
        {
            _mkSaving = false;
            StateHasChanged();
        }
    }

    private async Task OpenRedacted()
    {
        if (_mkSavedPath is null) return;
        var name = System.IO.Path.GetFileName(_mkSavedPath);
        var format = DocumentFormatExtensions.FromPath(_mkSavedPath);
        await Recents.TouchAsync(new RecentItem(name, _mkSavedPath, format, DateTimeOffset.Now, false));
        await Tabs.OpenAsync(_mkSavedPath, name, format);
        _markup = false;
        _mkStatus = null; _mkSavedPath = null;
    }

    private sealed class MkRect
    {
        public double left { get; set; }
        public double top { get; set; }
        public double width { get; set; }
        public double height { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        Tabs.Changed += OnTabsChanged;
        OpenDoc.Requested += OnOpenRequestedLive;

        // Rebuild the strip from the last session (no-op after the first time).
        await Tabs.RestoreAsync();

        // A pending request from the dashboard/recents opens (or focuses) a tab.
        await OpenPendingAsync();

        SyncActive();
    }

    // A file dropped on the window (or any open request) while the reader is already
    // open: navigation to /reader is a no-op, so consume the pending open directly.
    private void OnOpenRequestedLive() => _ = InvokeAsync(OpenPendingAsync);

    private async Task OpenPendingAsync()
    {
        if (string.IsNullOrEmpty(OpenDoc.PendingPath))
        {
            return;
        }

        var path = OpenDoc.PendingPath!;
        var name = OpenDoc.PendingName ?? System.IO.Path.GetFileName(path);
        var format = DocumentFormatExtensions.FromPath(path);
        _pendingJumpPage = OpenDoc.PendingPage;
        OpenDoc.Clear();
        await Recents.TouchAsync(new RecentItem(name, path, format, DateTimeOffset.Now, false));
        await Tabs.OpenAsync(path, name, format);
        StateHasChanged();
    }

    private void OnTabsChanged()
    {
        if (Tabs.Tabs.Count == 0)
        {
            // Last document closed — leave the reader for the dashboard.
            Nav.NavigateTo("/");
            return;
        }

        SyncActive();
        InvokeAsync(StateHasChanged);
    }

    // Detect when the active tab (or its loaded page count) changed, and rebuild the
    // page list so the desk re-points to the new document and restores its scroll.
    private void SyncActive()
    {
        var tab = Tabs.Active;
        var id = tab?.Id;
        var pageCount = tab?.Session?.Document.PageCount ?? 0;

        if (id != _activeId)
        {
            _activeId = id;
            _shownPageCount = pageCount;
            _pageInput = (tab?.CurrentPage ?? 1).ToString();
            _rendering.Clear();
            _pages = pageCount > 0 ? Enumerable.Range(0, pageCount).ToList() : new();
            _loadGen++;
            _restoreScroll = pageCount > 0;
            _pageColorOpen = false;
            if (tab?.Path != _pageBgPath) _ = LoadPageBgAsync(tab?.Path);
            if (tab?.Path != _mkDocPath)
            {
                _mkDocPath = tab?.Path;
                _texts.Clear();
                _shapes.Clear();
                _images.Clear();
                _selText = null; _selShape = null; _selImage = null;
                _mkStatus = null; _mkSavedPath = null; _mkMode = MkMode.None; _textDraft = null; _shapeDraft = null;
                _mkTagged = false; _mkTaggedPath = null;
                if (_markup) _ = CheckTaggedAsync();
            }
        }
        else if (pageCount != _shownPageCount)
        {
            _shownPageCount = pageCount;
            _pageInput = (tab?.CurrentPage ?? 1).ToString();
            _rendering.Clear();
            _pages = pageCount > 0 ? Enumerable.Range(0, pageCount).ToList() : new();
            _loadGen++;
            _restoreScroll = pageCount > 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var tab = Tabs.Active;
        if (tab?.Session is null)
        {
            return;
        }

        if (tab.Session.Document.IsXfaForm)
        {
            return;   // no desk is rendered for XFA documents
        }

        if (_js is null)
        {
            try
            {
                _js = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ChuvadiReader.Ui/js/reader.js");
                _ref = DotNetObjectReference.Create(this);
            }
            catch
            {
                return;
            }
        }

        if (_observedGen != _loadGen)
        {
            _observedGen = _loadGen;
            try { await _js.InvokeVoidAsync("init", _desk, _ref); }
            catch { }

            if (_tool != ReaderTool.None)
            {
                try { await _js.InvokeVoidAsync("setTool", _desk, ToolStr(_tool)); }
                catch { }
            }

            if (!_initiallyFitted.Contains(tab.Id))
            {
                // First time this document is shown — open it fitted to the page.
                _initiallyFitted.Add(tab.Id);
                _restoreScroll = false;
                tab.TwoPage = false;
                tab.Continuous = false;
                await ApplyFit(ReaderFitMode.Page);
            }
            else if (_restoreScroll)
            {
                _restoreScroll = false;
                try { await _js.InvokeVoidAsync("setScrollTop", _desk, tab.ScrollTop); }
                catch { }
            }

            if (_pendingJumpPage is { } jump)
            {
                _pendingJumpPage = null;
                await GoTo(jump);
            }
        }
    }

    private async Task OpenViaPicker()
    {
        var path = await Picker.PickDocumentAsync();
        if (string.IsNullOrEmpty(path))
        {
            return;
        }

        var name = System.IO.Path.GetFileName(path);
        var format = DocumentFormatExtensions.FromPath(path);
        await Recents.TouchAsync(new RecentItem(name, path, format, DateTimeOffset.Now, false));
        await Tabs.OpenAsync(path, name, format);
    }

