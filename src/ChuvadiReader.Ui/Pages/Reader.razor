@code {
    private async Task OpenInBench()
    {
        var active = Tabs.Active;
        if (active?.Path is null)
        {
            return;
        }

        await Bench.AddSourceAsync(active.Path, active.FileName);
        Nav.NavigateTo("/bench");
    }

    private async Task SendToRedact()
    {
        var active = Tabs.Active;
        if (active?.Path is null) return;

        // If there are unsaved overlays (text/shapes/images), flatten them into a temp PDF
        // so the shapes travel into Redact baked in; otherwise send the original file.
        if (OverlayCount > 0)
        {
            try
            {
                var temp = System.IO.Path.Combine(
                    System.IO.Path.GetTempPath(),
                    System.IO.Path.GetFileNameWithoutExtension(active.Path) + "-toredact-" + Guid.NewGuid().ToString("N").Substring(0, 8) + ".pdf");
                await Redact.FlattenToFileAsync(
                    active.Path, temp,
                    new Dictionary<int, PageRedaction>(), _mkColor,
                    BuildTextsDict(), BuildImagesDict(), BuildShapesDict());
                RedactHandoff.Request(temp, active.FileName);
                Nav.NavigateTo("/redact");
                return;
            }
            catch
            {
                // Fall back to sending the original if flattening fails.
            }
        }

        RedactHandoff.Request(active.Path, active.FileName);
        Nav.NavigateTo("/redact");
    }

    private async Task ShowProperties()
    {
        var active = Tabs.Active;
        if (active?.Path is null)
        {
            return;
        }

        _showProps = true;
        _props = null;
        StateHasChanged();
        try
        {
            _props = await DocProps.ReadAsync(active.Path);
        }
        catch
        {
            _props = new DocProperties(System.IO.Path.GetFileName(active.Path),
                null, null, null, null, null, null, null, null,
                active.Session?.Document.PageCount ?? 0, "—", false, null, false, false, 0);
        }
    }

