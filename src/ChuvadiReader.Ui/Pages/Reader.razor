    [JSInvokable]
    public void ZoomKey(int dir)
    {
        if (Tabs.Active is not { } t)
        {
            return;
        }

        t.Scale = dir > 0 ? Math.Min(8.0, t.Scale + 0.25)
                : dir < 0 ? Math.Max(0.1, t.Scale - 0.25)
                : 1.0;
        t.FitMode = ReaderFitMode.Free;
        StateHasChanged();
    }

    [JSInvokable]
    public Task NavPage(int delta) => GoTo(CurPage + delta);

    private async Task GoTo(int page)
    {
        var tab = Tabs.Active;
        if (tab?.Session is null)
        {
            return;
        }

        page = Math.Clamp(page, 1, tab.Session.Document.PageCount);
        tab.CurrentPage = page;
        _pageInput = page.ToString();

        if (_js is not null)
        {
            try { await _js.InvokeVoidAsync("scrollToPage", _desk, page - 1); }
            catch { }
        }
    }

    private async Task OnJumpChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var p))
        {
            await GoTo(p);
        }
        else
        {
            _pageInput = CurPage.ToString();
        }

        if (_js is not null)
        {
            try { await _js.InvokeVoidAsync("focusDesk"); }
            catch { }
        }
    }

    private void ZoomIn()
    {
        if (Tabs.Active is { } t)
        {
            t.Scale = Math.Min(8.0, t.Scale + 0.25);
            t.FitMode = ReaderFitMode.Free;
        }
    }

    private void ZoomOut()
    {
        if (Tabs.Active is { } t)
        {
            t.Scale = Math.Max(0.1, t.Scale - 0.25);
            t.FitMode = ReaderFitMode.Free;
        }
    }

    // ── view system ──────────────────────────────────────────────────────────
    private bool _hoverEnabled = true;
    private bool _drawerOpen;
    private bool _drawerPinned;
    private bool _reading;
    private ReaderTool _tool = ReaderTool.None;
    private RotateScopeKind _rotScope = RotateScopeKind.Page;
    private double _loupeRadius = 84;
    private double _loupeMag = 2.2;
    private static readonly int[] _zoomPresets = { 50, 75, 100, 125, 150, 200, 400 };

    // Per-tab view undo (rotation + layout/fit only; zoom & scroll are not undone).
    private readonly Dictionary<ReaderTab, Stack<ViewSnapshot>> _undo = new();

    private sealed record ViewSnapshot(
        Dictionary<int, int> Rotations, bool TwoPage, bool Continuous, bool CoverAlone,
        ReaderFitMode FitMode, double Scale);

    private enum RotateScopeKind { Page, Onward, Document }

    private int PageStep => TwoPageOn ? 2 : 1;

    private int ZoomPct => (int)Math.Round(CurScale * 100);
    private bool TwoPageOn => Tab?.TwoPage == true;
    private bool ContinuousOn => Tab?.Continuous == true;
    private string LayoutClass
    {
        get
        {
            var cls = TwoPageOn ? (Tab?.CoverAlone == true ? "two cover" : "two") : "";
            if (!ContinuousOn)
            {
                cls = (cls.Length > 0 ? cls + " " : "") + "snap";
            }
            return cls;
        }
    }

    private int RotationFor(int pageIndex) =>
        Tab is { } t && t.PageRotations.TryGetValue(pageIndex, out var r) ? r : 0;

    private void TogglePin() => _drawerPinned = !_drawerPinned;

    private async Task SetLoupe(double radius, double mag)
    {
        _loupeRadius = radius;
        _loupeMag = mag;
        if (_js is not null)
        {
            try { await _js.InvokeVoidAsync("configLoupe", radius, mag); }
            catch { }
        }
    }

    // Snapshot the undoable view-state of the active tab before a change.
    private void PushUndo()
    {
        var tab = Tabs.Active;
        if (tab is null)
        {
            return;
        }

        if (!_undo.TryGetValue(tab, out var stack))
        {
            stack = new Stack<ViewSnapshot>();
            _undo[tab] = stack;
        }

        stack.Push(new ViewSnapshot(
            new Dictionary<int, int>(tab.PageRotations), tab.TwoPage, tab.Continuous,
            tab.CoverAlone, tab.FitMode, tab.Scale));

        if (stack.Count > 50)
        {
            // keep the stack bounded
            var keep = stack.ToArray()[..50];
            stack.Clear();
            for (var i = keep.Length - 1; i >= 0; i--)
            {
                stack.Push(keep[i]);
            }
        }
    }

    [JSInvokable]
    public void Undo()
    {
        var tab = Tabs.Active;
        if (tab is null || !_undo.TryGetValue(tab, out var stack) || stack.Count == 0)
        {
            return;
        }

        var s = stack.Pop();
        tab.PageRotations.Clear();
        foreach (var kv in s.Rotations)
        {
            tab.PageRotations[kv.Key] = kv.Value;
        }
        tab.TwoPage = s.TwoPage;
        tab.Continuous = s.Continuous;
        tab.CoverAlone = s.CoverAlone;
        tab.FitMode = s.FitMode;
        tab.Scale = s.Scale;
        StateHasChanged();
    }

