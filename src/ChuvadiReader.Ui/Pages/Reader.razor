    private IEnumerable<(string Label, string Value)> PropRows()
    {
        if (_props is null)
        {
            yield break;
        }

        yield return ("File", _props.FileName);
        if (_props.Title is not null) yield return ("Title", _props.Title);
        if (_props.Author is not null) yield return ("Author", _props.Author);
        if (_props.Subject is not null) yield return ("Subject", _props.Subject);
        if (_props.Keywords is not null) yield return ("Keywords", _props.Keywords);
        if (_props.Creator is not null) yield return ("Creator", _props.Creator);
        if (_props.Producer is not null) yield return ("Producer", _props.Producer);
        if (_props.Created is not null) yield return ("Created", _props.Created);
        if (_props.Modified is not null) yield return ("Modified", _props.Modified);
        yield return ("Pages", _props.PageCount.ToString());
        yield return ("Page size", _props.PageSize);
        yield return ("Encryption", _props.Encrypted ? (_props.Encryption ?? "Encrypted") : "None");
        yield return ("XFA form", _props.IsXfa ? "Yes" : "No");
        yield return ("Fast web view", _props.Linearized ? "Yes" : "No");
        yield return ("File size", SizeOf(_props.SizeBytes));
    }

    private static string SizeOf(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double s = bytes;
        var i = 0;
        while (s >= 1024 && i < units.Length - 1)
        {
            s /= 1024;
            i++;
        }

        return $"{s:0.#} {units[i]}";
    }

