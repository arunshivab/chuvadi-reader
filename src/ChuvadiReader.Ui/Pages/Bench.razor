    private async Task RunExport(Guid deskId)
    {
        if (_expPdf)
        {
            var path = await Picker.PickSavePdfAsync(SafeFileName(DeskName(deskId)));
            if (string.IsNullOrEmpty(path))
            {
                return;
            }

            _expBusy = true; StateHasChanged();
            try
            {
                if (_expSelectedOnly && BenchSvc.SelectedInDesk(deskId) > 0)
                {
                    await BenchSvc.LiftDeskAsync(deskId, path);
                }
                else
                {
                    await BenchSvc.BindDeskAsync(deskId, path);
                }

                _expDesk = null;
                _status = $"Exported PDF: {System.IO.Path.GetFileName(path)}";
                _error = false; _resultPath = path;
            }
            catch (Exception ex) { _status = ex.Message; _error = true; }
            finally { _expBusy = false; StateHasChanged(); }
            return;
        }

        _expBusy = true; StateHasChanged();
        try
        {
            var n = await BenchSvc.ExportDeskAsync(deskId, _expFolder, _expFormat, _expDpi, _expSelectedOnly);
            _expDesk = null;
            _status = $"Exported {n} image{(n == 1 ? "" : "s")} into {_expFolder}";
            _error = false; _resultPath = null;
        }
        catch (Exception ex) { _status = ex.Message; _error = true; }
        finally { _expBusy = false; StateHasChanged(); }
    }

    private static string SafeFileName(string name)
    {
        var safe = string.IsNullOrWhiteSpace(name) ? "desk" : name.Trim();
        foreach (var c in System.IO.Path.GetInvalidFileNameChars())
        {
            safe = safe.Replace(c, '_');
        }
        return safe;
    }

