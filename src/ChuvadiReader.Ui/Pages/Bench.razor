    /// <summary>Parses a page-range string like "1-5, 8, 10-12" (1-based, inclusive) into a
    /// distinct, ordered list of 0-based page indices. Empty/invalid yields null (= all pages).</summary>
    private static List<int>? ParseRange(string text, int pageCount)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var result = new List<int>();
        var seen = new HashSet<int>();
        foreach (var partRaw in text.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
        {
            var part = partRaw.Trim();
            if (part.Length == 0) continue;
            var dash = part.IndexOf('-');
            if (dash > 0 && dash < part.Length - 1)
            {
                if (int.TryParse(part[..dash].Trim(), out var a) && int.TryParse(part[(dash + 1)..].Trim(), out var b))
                {
                    if (a > b) (a, b) = (b, a);
                    for (var n = a; n <= b; n++)
                    {
                        var i = n - 1;
                        if (i >= 0 && i < pageCount && seen.Add(i)) result.Add(i);
                    }
                }
            }
            else if (int.TryParse(part, out var single))
            {
                var i = single - 1;
                if (i >= 0 && i < pageCount && seen.Add(i)) result.Add(i);
            }
        }
        return result.Count == 0 ? null : result;
    }

