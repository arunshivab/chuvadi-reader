    private const double PtPerIn = 72.0;
    private const double PtPerCm = 28.3464567;
    private double UnitToPt(double v) => _mUnit == "cm" ? v * PtPerCm : v * PtPerIn;
    private double PtToUnit(double pt) => _mUnit == "cm" ? pt / PtPerCm : pt / PtPerIn;

    private void OpenMargins(Guid pageId)
