        if (m is not null)
        {
            _mT = Math.Round(PtToUnit(m.Top), 3);
            _mR = Math.Round(PtToUnit(m.Right), 3);
            _mB = Math.Round(PtToUnit(m.Bottom), 3);
            _mL = Math.Round(PtToUnit(m.Left), 3);
        }
        else { _mT = _mR = _mB = _mL = 0; }
    }

    private void SetMarginUnit(string unit)
    {
        if (unit == _mUnit) return;
        double f = unit == "cm" ? 2.54 : 1.0 / 2.54; // in→cm ×2.54, cm→in ÷2.54
        _mT = Math.Round(_mT * f, 3); _mR = Math.Round(_mR * f, 3);
        _mB = Math.Round(_mB * f, 3); _mL = Math.Round(_mL * f, 3);
        _mUnit = unit;
    }

    private void MarginDefault()
    {
        double v = _mUnit == "cm" ? Math.Round(0.5 * 2.54, 3) : 0.5; // 0.5 in = 1.27 cm
        _mT = _mR = _mB = _mL = v;
    }

    private void ApplyMarginsToPages(Guid pageId, bool allPages)
    {
        var total = UnitToPt(_mT) + UnitToPt(_mR) + UnitToPt(_mB) + UnitToPt(_mL);
