    private void SetImpLayout(string layout)
    {
        _impLayout = layout;
        (_impRows, _impCols) = layout switch
        {
            "2" => (1, 2),
            "4" => (2, 2),
            "6" => (3, 2),
            "9" => (3, 3),
            _ => (_impRows, _impCols),
        };
    }

    private async Task RunImpose(Guid deskId)
    {
        _impBusy = true; _status = null; _error = false; StateHasChanged();
        await Task.Yield();
        try
        {
            ChuvadiReader.Core.Reader.Desk? nd;
            if (_impMode == "booklet")
            {
                nd = await BenchSvc.BookletToNewDeskAsync(deskId, _impSheet, _impGutter);
            }
            else
            {
                var r = Math.Clamp(_impRows, 1, 6);
                var c = Math.Clamp(_impCols, 1, 6);
                nd = await BenchSvc.NupToNewDeskAsync(deskId, r, c, _impSheet, _impGutter);
            }
            _status = nd is null ? "Nothing to impose (or desk limit reached)." : $"Imposed \u2192 new desk \u201C{nd.Name}\u201D";
            _error = nd is null;
        }
        catch (Exception ex) { _status = ex.Message; _error = true; }
        finally { _impBusy = false; _imposeDesk = null; StateHasChanged(); }
    }

