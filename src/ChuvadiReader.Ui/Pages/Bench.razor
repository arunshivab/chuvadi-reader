    private IEnumerable<(string Label, string Value)> PropRows(ChuvadiReader.Core.Documents.DocProperties p)
    {
        var rows = new (string, string?)[]
        {
            ("File", p.FileName),
            ("Title", p.Title),
            ("Author", p.Author),
            ("Subject", p.Subject),
            ("Keywords", p.Keywords),
            ("Pages", p.PageCount.ToString()),
            ("Page size", p.PageSize),
            ("Size", Fmt(p.SizeBytes)),
            ("Created", p.Created),
            ("Modified", p.Modified),
            ("Producer", p.Producer),
            ("Creator", p.Creator),
            ("Encrypted", p.Encrypted ? (p.Encryption ?? "yes") : null),
            ("Linearized", p.Linearized ? "yes (fast web view)" : null),
            ("XFA form", p.IsXfa ? "yes" : null),
        };

        foreach (var (label, value) in rows)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                yield return (label, value!);
            }
        }
    }

    private static string Fmt(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = { "B", "KB", "MB", "GB" };
        double v = bytes;
        var i = 0;
        while (v >= 1024 && i < units.Length - 1) { v /= 1024; i++; }
        return $"{v:0.#} {units[i]}";
    }

