@page "/bench"
@inject BenchService BenchSvc
@inject IFilePicker Picker
@inject SaveFolderService SaveFolders
@inject OpenDocumentService OpenDoc
@inject NavigationManager Nav
@inject IAppStorage Storage
@inject IJSRuntime JS
@inject PressService Press
@inject DocumentPropertiesService DocProps
@inject SessionService Session
@inject RedactRequestService RedactReq
@inject BenchDropService BenchDrop
@implements IAsyncDisposable

<PageTitle>Chuvadi · Bench</PageTitle>

<div class="bench">
    @if (_busy)
    {
        <div class="bench-busy">
            <div class="bench-busy-card"><span class="bspin big"></span><span>@(_busyLabel ?? "Working…")</span></div>
        </div>
    }
    <div class="bench-bar">
        <a class="bench-back" href="/" title="Back to dashboard"><Icon Name="chevron-left" Size="15" /></a>
        <span class="bench-name">Bench</span>
        <div class="session-wrap">
            <button class="bench-session" @onclick="ToggleSessionMenu" title="Save or open a bench session"><Icon Name="save" Size="13" /> Session <span class="caret">▾</span></button>
            @if (_sessionMenu)
            {
                <div class="session-menu">
                    <button @onclick="SaveSession" disabled="@(_busy || (BenchSvc.IsEmpty && !BenchSvc.HasSources))">Save session…</button>
                    <button @onclick="OpenSession" disabled="@_busy">Open session…</button>
                </div>
            }
        </div>
        <span style="flex:1"></span>
        <button class="bench-reset" @onclick="ConfirmReset" disabled="@(_busy || (!BenchSvc.HasSources && BenchSvc.IsEmpty))" title="Clear the bench"><Icon Name="rotate-ccw" Size="13" /> Reset</button>
        <span class="bt-sep"></span>
        <button class="bench-hist" @onclick="Undo" disabled="@(_busy || !BenchSvc.CanUndo)" title="Undo (Ctrl+Z)" aria-label="Undo"><Icon Name="rotate-ccw" Size="14" /></button>
        <button class="bench-hist flip" @onclick="Redo" disabled="@(_busy || !BenchSvc.CanRedo)" title="Redo (Ctrl+Y)" aria-label="Redo"><Icon Name="rotate-ccw" Size="14" /></button>
        <span class="bt-sep"></span>
        <span class="bench-view">
            <button class="bv @(_perRow == 1 ? "on" : null)" @onclick="() => SetPerRow(1)" title="One desk per row"><Icon Name="square" Size="15" /></button>
            <button class="bv @(_perRow == 2 ? "on" : null)" @onclick="() => SetPerRow(2)" title="Two desks per row"><Icon Name="columns" Size="15" /></button>
            <button class="bv @(_perRow == 3 ? "on" : null)" @onclick="() => SetPerRow(3)" title="Three desks per row"><Icon Name="grid-view" Size="15" /></button>
        </span>
        <span class="bt-sep"></span>
        <button class="bt bt-fetch" @onclick="FetchFile" disabled="@(_busy || _fetching)"><Icon Name="folder" Size="15" /> Fetch File</button>
        <button class="bt bt-bind" @onclick="BindAll" disabled="@(_busy || BenchSvc.IsEmpty)"><Icon Name="save" Size="15" /> Bind all</button>
        <button class="bt" @onclick="CombineAll" disabled="@(_busy || BenchSvc.IsEmpty)" title="Combine every desk into one PDF"><Icon Name="merge" Size="15" /> Combine</button>
        <button class="bt" @onclick="AddDesk" disabled="@(_busy || !BenchSvc.CanAddDesk)" title="@(BenchSvc.CanAddDesk ? "Add a desk" : "30-desk limit reached")"><Icon Name="plus" Size="15" /> Add desk</button>
        @if (BenchSvc.SelectedCount > 0)
        {
            <button class="bt" @onclick="ExtractSelected" disabled="@(_busy || !BenchSvc.CanAddDesk)" title="@(BenchSvc.CanAddDesk ? "Move the selected pages into a new desk" : "30-desk limit reached")"><Icon Name="upload" Size="15" /> Extract (@BenchSvc.SelectedCount)</button>
        }
        @if (BenchSvc.SelectedCount == 2)
        {
            <button class="bt" @onclick="OpenCompare" disabled="@_busy" title="Compare the two selected pages side by side"><Icon Name="columns" Size="15" /> Compare</button>
        }
    </div>

    @if (_status is not null)
    {
        <div class="bench-status @(_error ? "err" : "ok")">
            @_status
            @if (_resultPath is not null && !_error)
            {
                <button class="bench-status-open" @onclick="OpenResult">Open</button>
            }
            <button class="bench-status-x" @onclick="() => _status = null" aria-label="Dismiss"><Icon Name="x" Size="13" /></button>
        </div>
    }

    <div class="bench-main" @ref="_grid">
        <aside class="bench-shelf" style="--shelf-thumb:@(ShelfThumbPx)px">
            <div class="shelf-head">Shelf</div>
            @if (_fetching)
            {
                <div class="shelf-loading"><span class="bspin"></span> Opening file…</div>
            }
            @if (!BenchSvc.HasSources && !_fetching)
            {
                <div class="shelf-empty">
                    <Icon Name="folder" Size="20" />
                    <span>Fetch a PDF to start.</span>
                    <button class="bt bt-fetch" @onclick="FetchFile" disabled="@_fetching"><Icon Name="folder" Size="14" /> Fetch a file</button>
                </div>
            }
            else if (BenchSvc.HasSources)
            {
                <button class="shelf-add" @onclick="FetchFile" disabled="@_fetching" title="Fetch another PDF onto the shelf">
                    <Icon Name="folder" Size="14" /><span>Add a file</span>
                </button>
                <div class="shelf-zoom" title="Thumbnail size">
                    <Icon Name="loupe" Size="12" />
                    <input type="range" min="0" max="3" step="1" value="@_shelfThumbStep"
                           @oninput="e => SetShelfThumb(e.Value?.ToString())" aria-label="Thumbnail size" />
                </div>
                @if (BenchSvc.Sources.Count > 1)
                {
                    <div class="shelf-tools">
                        <button class="shelf-tool" @onclick="ToggleCollapseAll" title="@(BenchSvc.AllCollapsed ? "Expand every file" : "Collapse every file")">
                            <Icon Name="@(BenchSvc.AllCollapsed ? "chevron-down" : "chevron-right")" Size="12" />
                            <span>@(BenchSvc.AllCollapsed ? "Expand all" : "Collapse all")</span>
                        </button>
                        <button class="shelf-tool" @onclick="ToggleInterleave" title="Weave two files page-for-page (A1, B1, A2, B2 …) into a new desk">
                            <Icon Name="merge" Size="12" />
                            <span>Interleave</span>
                        </button>
                    </div>
                    @if (_interleaveOpen)
                    {
                        <div class="shelf-interleave">
                            <div class="il-row">
                                <span class="il-lbl">A</span>
                                <select value="@_ilA" @onchange="e => _ilA = ParseIdx(e.Value, _ilA)">
                                    @foreach (var s in BenchSvc.Sources)
                                    {
                                        <option value="@s.Index">@s.FileName</option>
                                    }
                                </select>
                            </div>
                            <div class="il-row">
                                <span class="il-lbl">B</span>
                                <select value="@_ilB" @onchange="e => _ilB = ParseIdx(e.Value, _ilB)">
                                    @foreach (var s in BenchSvc.Sources)
                                    {
                                        <option value="@s.Index">@s.FileName</option>
                                    }
                                </select>
                            </div>
                            <div class="il-acts">
                                <button class="bt sm bt-prime" @onclick="DoInterleave" disabled="@(_ilA == _ilB)" title="@(_ilA == _ilB ? "Pick two different files" : "Build the interleaved desk")">Weave into desk</button>
                                <button class="bt sm" @onclick="ToggleInterleave">Cancel</button>
                            </div>
                        </div>
                    }
                }
                @foreach (var s in BenchSvc.Sources)
                {
                    <div class="shelf-src">
                        <div class="shelf-srch" data-shelf-all="@s.Index" title="Drag the whole file onto a desk">
                            <div class="shelf-srch-top">
                                <span class="shelf-srcname" title="@s.FileName">@s.FileName</span>
                                <button class="shelf-ic" @onclick="() => OpenProps(s.Path)" title="Properties"><Icon Name="info" Size="14" /></button>
                            </div>
                            <div class="shelf-srch-bot">
                                <button class="shelf-collapse" @onclick="() => ToggleCollapse(s.Index)" aria-label="@(s.Collapsed ? "Expand" : "Collapse")"><Icon Name="@(s.Collapsed ? "chevron-right" : "chevron-down")" Size="14" /></button>
                                <span class="src-dot @SrcClass(s.Index)"></span>
                                <span class="shelf-srcct">@(BenchSvc.HasPageFilter(s.Index) ? $"{BenchSvc.VisiblePages(s.Index).Count}/{s.PageCount}" : s.PageCount.ToString())</span>
                                <span class="shelf-bot-gap"></span>
                                <button class="shelf-ic shelf-ord" @onclick="() => BenchSvc.MoveSource(s.Index, -1)" title="Move up" aria-label="Move up">&#8593;</button>
                                <button class="shelf-ic shelf-ord" @onclick="() => BenchSvc.MoveSource(s.Index, 1)" title="Move down" aria-label="Move down">&#8595;</button>
                                <button class="shelf-ic" @onclick="() => OpenPress(s.Path)" title="Press"><Icon Name="compress" Size="14" /></button>
                                <button class="shelf-ic shelf-close" @onclick="() => CloseSource(s.Index)" title="Close file" aria-label="Close file">&times;</button>
                            </div>
                        </div>
                        @if (!s.Collapsed)
                        {
                            <div class="shelf-filter">
                                <div class="sf-row">
                                    <input class="sf-input" placeholder="Search this file…" value="@GetSrcQuery(s.Index)"
                                           @oninput="e => SetSrcQuery(s.Index, e.Value?.ToString())"
                                           @onkeydown="e => OnSearchKey(e, s.Index)" />
                                    <button class="sf-go" @onclick="() => RunSrcSearch(s.Index)" disabled="@_srcSearching.Contains(s.Index)" title="Search this file" aria-label="Search">
                                        @if (_srcSearching.Contains(s.Index)) { <span class="bspin sf-spin"></span> } else { <Icon Name="loupe" Size="13" /> }
                                    </button>
                                </div>
                                <div class="sf-row">
                                    <input class="sf-input sf-range" placeholder="Pages e.g. 1-5, 8" value="@GetSrcRange(s.Index)"
                                           @oninput="e => SetSrcRange(s.Index, e.Value?.ToString())"
                                           @onkeydown="e => OnRangeKey(e, s.Index)" />
                                    <button class="sf-go" @onclick="() => ApplyRange(s.Index)" title="Show only these pages" aria-label="Apply range"><Icon Name="check" Size="13" /></button>
                                    @if (BenchSvc.HasPageFilter(s.Index))
                                    {
                                        <button class="sf-clear" @onclick="() => ClearFilter(s.Index)" title="Show every page">All</button>
                                    }
                                </div>
                                @if (_srcMatches.TryGetValue(s.Index, out var matches) && matches.Count > 0)
                                {
                                    <div class="sf-results">
                                        <span class="sf-rcount">@matches.Count page@(matches.Count == 1 ? "" : "s"):</span>
                                        @foreach (var mp in matches)
                                        {
                                            <button class="sf-chip" @onclick="() => JumpToPage(s.Index, mp)" title="Jump to page @(mp + 1)">@(mp + 1)</button>
                                        }
                                        <button class="sf-only @(BenchSvc.HasPageFilter(s.Index) ? "on" : null)" @onclick="() => ShowOnlyMatches(s.Index)" title="Show only the matching pages">Only matches</button>
                                    </div>
                                }
                                else if (_srcSearched.Contains(s.Index) && !_srcSearching.Contains(s.Index))
                                {
                                    <div class="sf-results"><span class="sf-noresult">No matches</span></div>
                                }
                            </div>
                            <div class="shelf-pgs">
                                @foreach (var pi in BenchSvc.VisiblePages(s.Index))
                                {
                                    <div class="shelf-pg @SrcClass(s.Index)" data-shelf="@($"{s.Index}:{pi}")" title="Drag page @(pi + 1) onto a desk">
                                        @if (BenchSvc.TryGetSourceThumb(s.Index, pi, out var svg))
                                        {
                                            <div class="thumb">@((MarkupString)svg)</div>
                                        }
                                        else
                                        {
                                            <span class="pgn">@(pi + 1)</span>
                                        }
                                        <span class="shelf-pgnum">@(pi + 1)</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </aside>

        <section class="bench-desks" style="--desk-cols:@_perRow">
            @foreach (var desk in BenchSvc.Desks)
            {
                var deskId = desk.Id;
                var sel = BenchSvc.SelectedInDesk(deskId);
                <div class="desk @(_perRow == 3 ? "compact" : null)" style="@(desk.ColorHex is { } dcol ? $"--desk-accent:{dcol}" : "")">
                    <div class="desk-h">
                        <button class="desk-swatch @(desk.ColorHex is null ? "empty" : null)" style="@(desk.ColorHex is { } sc ? $"background:{sc}" : "")" @onclick="() => ToggleDeskPalette(deskId)" title="Desk colour" aria-label="Desk colour"></button>
                        <input class="desk-name" value="@desk.Name"
                               @onchange="@(e => RenameDesk(deskId, e.Value?.ToString()))"
                               spellcheck="false" />
                        @if (desk.Watermark is not null)
                        {
                            <span class="desk-wm" title="Watermark: @desk.Watermark.Text">WM</span>
                        }
                        @if (desk.HeaderFooter is not null)
                        {
                            <span class="desk-wm desk-hf" title="Header / footer set">HF</span>
                        }
                        @if (desk.Numbering is not null)
                        {
                            <span class="desk-wm desk-num" title="@NumberingChipTitle(desk.Numbering)">№</span>
                        }
                        <button class="desk-wm desk-bm @(desk.AddBookmarks ? "on" : "off")" @onclick="() => BenchSvc.SetDeskBookmarks(deskId, !desk.AddBookmarks)" title="@(desk.AddBookmarks ? "Bookmarks added on Bind (one per source, originals nested) — click to turn off" : "No bookmarks on Bind — click to turn on")">BM</button>
                        <span class="desk-count">@desk.Pages.Count pg</span>
                        @if (!desk.IsEmpty)
                        {
                            <button class="desk-sel" @onclick="() => BenchSvc.SelectAllInDesk(deskId)" title="Select all pages on this desk (Ctrl+A)" aria-label="Select all">All</button>
                            <button class="desk-sel" @onclick="() => BenchSvc.InvertSelectionInDesk(deskId)" title="Invert selection on this desk" aria-label="Invert selection">Inv</button>
                        }
                        @if (!string.IsNullOrEmpty(desk.NormalizeSize))
                        {
                            <span class="desk-wm desk-size-chip" title="Every page normalised to @desk.NormalizeSize at Bind / Export">@(desk.NormalizeSize == "Letter" ? "LTR" : "A4")</span>
                        }
                        <button class="desk-ord" @onclick="() => BenchSvc.MoveDesk(deskId, -1)" title="Move desk left" aria-label="Move left">&#8592;</button>
                        <button class="desk-ord" @onclick="() => BenchSvc.MoveDesk(deskId, 1)" title="Move desk right" aria-label="Move right">&#8594;</button>
                        <button class="desk-dup" @onclick="() => DuplicateDesk(deskId)" disabled="@(!BenchSvc.CanAddDesk)" title="Duplicate this desk (pages + settings)" aria-label="Duplicate desk"><Icon Name="copy" Size="13" /></button>
                        @if (!desk.IsEmpty)
                        {
                            <button class="desk-clear" @onclick="() => ClearDesk(deskId)" title="Delete all pages on this desk" aria-label="Delete all pages">Clear</button>
                        }
                        <button class="desk-more" @onclick="() => ToggleDeskMenu(deskId)" title="More desk actions" aria-label="More actions">⋯</button>
                        <button class="desk-del" @onclick="() => RemoveDesk(deskId)" title="Delete desk" aria-label="Delete desk"><Icon Name="trash" Size="14" /></button>
                    </div>
                    @if (_deskMenu == deskId)
                    {
                        <div class="desk-menu">
                            <button @onclick="() => OpenDeskInReader(deskId)" disabled="@(_busy || desk.IsEmpty)"><Icon Name="reader" Size="13" /> Open in Reader</button>
                            <button @onclick="() => SendDeskToRedact(deskId)" disabled="@(_busy || desk.IsEmpty)"><Icon Name="redact" Size="13" /> Send to Redact</button>
                            <div class="desk-menu-sep"></div>
                            <button @onclick="() => SaveDeskAsTemplate(deskId)" disabled="@_busy">Save as template…</button>
                            @if (_templates.Count == 0)
                            {
                                <div class="desk-menu-note">No templates yet</div>
                            }
                            else
                            {
                                <div class="desk-menu-label">Apply template</div>
                                @foreach (var t in _templates)
                                {
                                    <button class="desk-menu-tpl" @onclick="() => ApplyDeskTemplate(deskId, t)" disabled="@_busy" title="Apply &quot;@t.Name&quot; settings to this desk">@t.Name</button>
                                }
                            }
                        </div>
                    }
                    @if (_deskPalette == deskId)
                    {
                        <div class="desk-palette">
                            @foreach (var col in _deskColors)
                            {
                                <button class="dp-sw @(string.Equals(desk.ColorHex, col, StringComparison.OrdinalIgnoreCase) ? "on" : null)" style="background:@col" @onclick="() => PickDeskColour(deskId, col)" title="@col" aria-label="Set colour"></button>
                            }
                            <button class="dp-none" @onclick="() => PickDeskColour(deskId, null)" title="No colour">None</button>
                        </div>
                    }

                    <div class="desk-drop" data-desk="@deskId">
                        @if (desk.IsEmpty)
                        {
                            <div class="desk-empty">Drag pages here</div>
                        }
                        else
                        {
                            @foreach (var page in desk.Pages)
                            {
                                var pg = page;
                                <div class="bpage @SrcClass(pg.SourceIndex) @(BenchSvc.IsSelected(pg.Id) ? "sel" : null)" data-bench-id="@pg.Id">
                                    <div class="bpage-body">
                                        <div class="bthumb" style="transform:rotate(@(pg.Rotation)deg)">
                                            @if (pg.IsBlank)
                                            {
                                                <div class="blankpg" style="@BlankStyle(pg)"></div>
                                            }
                                            else if (pg.IsImage)
                                            {
                                                <img class="bthumb-img" src="@ImageSrc(pg)" alt="(image)" />
                                            }
                                            else if (BenchSvc.TryGetThumb(pg, out var tsvg))
                                            {
                                                @((MarkupString)tsvg)
                                            }
                                            else
                                            {
                                                <span class="pgn">·</span>
                                            }
                                            @{
                                                var pgIndex = desk.Pages.IndexOf(pg);
                                                var wmForPage = desk.Watermark is { } dw && (dw.AllPages || BenchSvc.IsSelected(pg.Id)) ? dw : null;
                                            }
                                            @if (!pg.IsBlank && !pg.IsImage && (wmForPage is not null || desk.HeaderFooter is not null))
                                            {
                                                <StampPreview Watermark="wmForPage" HeaderFooter="desk.HeaderFooter"
                                                              PageNumber="pgIndex + 1" TotalPages="desk.Pages.Count"
                                                              FileName="@(string.IsNullOrWhiteSpace(desk.Name) ? "document.pdf" : desk.Name + ".pdf")" />
                                            }
                                            @if (pg.Crop is { } cr)
                                            {
                                                <div class="bcrop-mask" style="left:@Pct(cr.X);top:@Pct(cr.Y);width:@Pct(cr.W);height:@Pct(cr.H)"></div>
                                            }
                                        </div>
                                        <div class="bbadges">
                                            @if (pg.IsBlank)
                                            {
                                                <span class="bbadge type">blank</span>
                                            }
                                            else if (pg.IsImage)
                                            {
                                                <span class="bbadge type">image</span>
                                            }
                                            @if (pg.Rotation != 0)
                                            {
                                                <span class="bbadge rot" title="Rotated @(pg.Rotation)°">@(pg.Rotation)°</span>
                                            }
                                            @if (pg.Crop is not null)
                                            {
                                                <span class="bbadge edit" title="Cropped">crop</span>
                                            }
                                            @if (pg.Margins is not null)
                                            {
                                                <span class="bbadge edit" title="Margins set">margin</span>
                                            }
                                        </div>
                                        @if (BenchSvc.IsSelected(pg.Id))
                                        {
                                            <span class="bcheck"><Icon Name="check" Size="11" /></span>
                                        }
                                        <div class="bpage-acts">
                                            <button class="bpeek" data-peek="@pg.Id" title="Peek"><Icon Name="loupe" Size="12" /></button>
                                            <button @onclick="() => DuplicatePage(pg.Id)" title="Duplicate"><Icon Name="copy" Size="12" /></button>
                                            <button @onclick="() => TurnPage(pg.Id)" title="Rotate"><Icon Name="refresh" Size="12" /></button>
                                            <button @onclick="() => SplitHere(pg.Id)" title="Split desk here"><Icon Name="split" Size="12" /></button>
                                            <button class="@(pg.Crop != null ? "bcrop-on" : null)" @onclick="() => OpenCrop(pg.Id)" title="@(pg.Crop != null ? "Cropped — edit or clear" : "Crop this page")"><Icon Name="square" Size="12" /></button>
                                            <button class="@(pg.Margins != null ? "bcrop-on" : null)" @onclick="() => OpenMargins(pg.Id)" title="@(pg.Margins != null ? "Margins set — edit or clear" : "Add margins (inset content)")"><Icon Name="compress" Size="12" /></button>
                                        </div>
                                    </div>
                                    <div class="bpage-num @(pg.IsBlank || pg.IsImage ? "lbl" : null)">@PageLabel(pg)</div>
                                </div>
                            }
                        }
                    </div>

                    <div class="desk-foot">
                        <div class="desk-foot-acts">
                            <button class="bt sm" @onclick="() => FetchImageToDesk(deskId)" title="Fetch image"><Icon Name="file-image" Size="13" /><span class="btxt">Image</span></button>
                            <button class="bt sm" @onclick="() => AddBlank(deskId)" title="Add blank page"><Icon Name="file" Size="13" /><span class="btxt">Blank</span></button>
                            <button class="bt sm" @onclick="() => ReverseDesk(deskId)" disabled="@(desk.Pages.Count < 2)" title="Reverse page order"><Icon Name="rotate-ccw" Size="13" /><span class="btxt">Reverse</span></button>
                            <button class="bt sm" @onclick="() => SortDesk(deskId)" disabled="@(desk.Pages.Count < 2)" title="Sort pages into source order"><Icon Name="menu" Size="13" /><span class="btxt">Sort</span></button>
                            <button class="bt sm" @onclick="() => OpenImpose(deskId)" disabled="@(desk.IsEmpty || !BenchSvc.CanAddDesk)" title="N-up / booklet imposition → new desk"><Icon Name="columns" Size="13" /><span class="btxt">Impose</span></button>
                            <button class="bt sm @(desk.Numbering is not null ? "on" : null)" @onclick="() => OpenNumbering(deskId)" disabled="@desk.IsEmpty" title="Page / Bates numbering"><Icon Name="hash" Size="13" /><span class="btxt">Number</span></button>
                            <select class="bt sm desk-size" title="Normalise every page to this size at Bind / Export" @onchange="e => SetDeskSize(deskId, e.Value?.ToString())">
                                <option value="" selected="@string.IsNullOrEmpty(desk.NormalizeSize)">Size: original</option>
                                <option value="A4" selected="@(desk.NormalizeSize == "A4")">Size: A4</option>
                                <option value="Letter" selected="@(desk.NormalizeSize == "Letter")">Size: Letter</option>
                            </select>
                        </div>
                        <span class="desk-foot-sp"></span>
                        <span class="desk-selinfo">@(sel > 0 ? $"{sel} sel" : "")</span>
                        @if (sel > 0)
                        {
                            <button class="bt sm bt-del" @onclick="() => DeleteSelected(deskId)" title="Delete selected pages"><Icon Name="trash" Size="13" /><span class="btxt">Delete (@sel)</span></button>
                        }
                        <div class="desk-foot-out">
                            <button class="bt sm" @onclick="() => OpenWatermark(deskId)" title="Watermark"><Icon Name="watermark" Size="13" /><span class="btxt">Watermark</span></button>
                            <button class="bt sm" @onclick="() => OpenHeaderFooter(deskId)" title="Header / footer"><Icon Name="text-box" Size="13" /><span class="btxt">Footer</span></button>
                            <button class="bt sm" @onclick="() => OpenScatter(deskId)" disabled="@desk.IsEmpty" title="Scatter"><Icon Name="split" Size="13" /><span class="btxt">Scatter</span></button>
                            <button class="bt sm" @onclick="() => OpenExport(deskId)" disabled="@desk.IsEmpty" title="Export"><Icon Name="download" Size="13" /><span class="btxt">Export</span></button>
                            <button class="bt sm" @onclick="() => LiftDesk(deskId)" disabled="@(_busy || sel == 0)" title="Lift selected"><Icon Name="upload" Size="13" /><span class="btxt">Lift@(sel > 0 ? $" ({sel})" : "")</span></button>
                            <button class="bt sm bt-bind" @onclick="() => BindDesk(deskId)" disabled="@(_busy || desk.IsEmpty)" title="Bind desk"><Icon Name="save" Size="13" /><span class="btxt">Bind</span></button>
                        </div>
                    </div>
                </div>
            }

            @if (BenchSvc.CanAddDesk)
            {
                <button class="desk-add" @onclick="AddDesk" title="Add another desk">
                    <Icon Name="plus" Size="22" />
                    <span>Add desk</span>
                </button>
            }
        </section>
    </div>

    @if (_wmDesk is { } wmId)
    {
        <div class="modal-scrim" @onclick="CloseWatermark">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <span>Watermark · @(DeskName(wmId))</span>
                    <button @onclick="CloseWatermark" aria-label="Close"><Icon Name="x" Size="16" /></button>
                </div>
                <label class="modal-lbl">Text</label>
                <input class="modal-input" @bind="_wmText" @bind:event="oninput" placeholder="e.g. DRAFT, CONFIDENTIAL" />

                <label class="modal-lbl">Font</label>
                <div class="seg">
                    <select class="hf-fmt wm-fontsel" @bind="_wmFamily">
                        <option value="Helvetica">Helvetica (Sans)</option>
                        <option value="Times">Times (Serif)</option>
                        <option value="Courier">Courier (Mono)</option>
                    </select>
                    <button class="@(_wmBold ? "on" : null)" @onclick="() => _wmBold = !_wmBold" style="font-weight:700">B</button>
                    <button class="@(_wmItalic ? "on" : null)" @onclick="() => _wmItalic = !_wmItalic" style="font-style:italic">I</button>
                    <span style="width:6px"></span>
                    <label class="modal-lbl" style="margin:0 4px 0 0">Size</label>
                    <select class="hf-fmt" @bind="_wmSize">
                        @foreach (var s in new[] { 24, 28, 32, 36, 40, 48, 56, 64, 72, 96, 120, 144 })
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                    <input type="number" class="wm-angle" min="6" max="400" @bind="_wmSize" title="Custom size" />
                </div>

                <label class="modal-lbl">Colour</label>
                <div class="wm-swatches">
                    @foreach (var sw in WmSwatches)
                    {
                        <button class="wm-sw @(string.Equals(_wmColor, sw.Hex, StringComparison.OrdinalIgnoreCase) ? "on" : null)"
                                style="background:@sw.Hex" title="@sw.Name" @onclick="() => _wmColor = sw.Hex"></button>
                    }
                    <span class="wm-sw-custom">
                        <input type="color" class="wm-color" @bind="_wmColor" @bind:event="oninput" title="Custom colour" />
                        <span>Custom</span>
                    </span>
                </div>

                <label class="modal-lbl">Orientation</label>
                <div class="seg">
                    <button class="@(_wmRotation == 0 ? "on" : null)" @onclick="() => _wmRotation = 0">Horizontal</button>
                    <button class="@(_wmRotation == 90 ? "on" : null)" @onclick="() => _wmRotation = 90">Vertical</button>
                    <button class="@(_wmRotation == 45 ? "on" : null)" @onclick="() => _wmRotation = 45" title="Bottom-left to top-right">Diagonal ↗</button>
                    <button class="@(_wmRotation == 315 ? "on" : null)" @onclick="() => _wmRotation = 315" title="Top-left to bottom-right">Diagonal ↘</button>
                    <input type="number" class="wm-angle" min="0" max="359" value="@((int)_wmRotation)" title="Custom angle"
                           @oninput="@(e => _wmRotation = double.TryParse(e.Value?.ToString(), out var v) ? ((v % 360) + 360) % 360 : _wmRotation)" />
                </div>

                <label class="modal-lbl">Opacity — @((int)(_wmOpacity * 100))%</label>
                <input type="range" min="5" max="100" step="5" value="@((int)(_wmOpacity * 100))"
                       @oninput="@(e => _wmOpacity = (double.TryParse(e.Value?.ToString(), out var v) ? v : 25) / 100.0)" style="width:100%" />

                <label class="modal-lbl">Apply to</label>
                <div class="seg">
                    <button class="@(_wmAll ? "on" : null)" @onclick="() => _wmAll = true">All pages</button>
                    <button class="@(!_wmAll ? "on" : null)" @onclick="() => _wmAll = false" disabled="@(BenchSvc.SelectedInDesk(wmId) == 0)">Selected (@BenchSvc.SelectedInDesk(wmId))</button>
                </div>

                <div class="wm-preview">
                    <span style="font-family:@WmPreviewFont; font-weight:@(_wmBold ? "700" : "400"); font-style:@(_wmItalic ? "italic" : "normal"); color:@_wmColor; opacity:@_wmOpacity.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture); transform:rotate(@((-_wmRotation).ToString("0", System.Globalization.CultureInfo.InvariantCulture))deg)">@(string.IsNullOrWhiteSpace(_wmText) ? "preview" : _wmText)</span>
                </div>
                <div class="modal-foot">
                    @if (DeskHasWatermark(wmId))
                    {
                        <button class="ghost" @onclick="() => ClearWatermark(wmId)">Remove watermark</button>
                    }
                    <span style="flex:1"></span>
                    <button class="primary" @onclick="() => ApplyWatermark(wmId)">Set watermark</button>
                </div>
                <p class="modal-note">Applied to this desk's pages when you Bind or Lift.</p>
            </div>
        </div>
    }

    @if (_hfDesk is { } hfId)
    {
        <div class="modal-scrim" @onclick="CloseHeaderFooter">
            <div class="modal modal-wide" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <span>Header &amp; footer · @(DeskName(hfId))</span>
                    <button @onclick="CloseHeaderFooter" aria-label="Close"><Icon Name="x" Size="16" /></button>
                </div>

                <div class="hf-topline">
                    <div class="hf-fmtbar">
                        <label class="modal-lbl">Page</label>
                        <select class="hf-fmt" @bind="_hfPageFmt" @bind:after="RebuildBands">
                            <option value="">1, 2, 3</option>
                            <option value="roman">i, ii, iii</option>
                            <option value="ROMAN">I, II, III</option>
                            <option value="alpha">a, b, c</option>
                            <option value="ALPHA">A, B, C</option>
                        </select>
                        <label class="modal-lbl">Date</label>
                        <select class="hf-fmt" @bind="_hfDateFmt" @bind:after="RebuildBands">
                            <option value="yyyy-MM-dd">2026-06-17</option>
                            <option value="dd MMM yyyy">17 Jun 2026</option>
                            <option value="MMMM d, yyyy">June 17, 2026</option>
                            <option value="dd/MM/yyyy">17/06/2026</option>
                            <option value="MM/dd/yyyy">06/17/2026</option>
                        </select>
                        <label class="modal-lbl">Time</label>
                        <select class="hf-fmt" @bind="_hfTimeFmt" @bind:after="RebuildBands">
                            <option value="HH:mm">14:30</option>
                            <option value="hh:mm tt">02:30 PM</option>
                        </select>
                    </div>
                    <div class="hf-mode">
                        <span class="hf-sw-label @(_hfQuick ? "on" : null)" @onclick="() => SetMode(true)">Quick</span>
                        <button type="button" class="hf-switch @(_hfQuick ? null : "right")" role="switch"
                                aria-checked="@(!_hfQuick)" @onclick="() => SetMode(!_hfQuick)" title="Switch mode">
                            <span class="hf-switch-knob"></span>
                        </button>
                        <span class="hf-sw-label @(!_hfQuick ? "on" : null)" @onclick="() => SetMode(false)">Custom</span>
                    </div>
                </div>

                <div class="hf-row2">
                    @if (_hfQuick)
                    {
                        <span class="hf-mode-hint">Pick one field per slot.</span>
                    }
                    else
                    {
                        <div class="hf-chips">
                            <button class="chip" @onclick="() => InsertToken(PageToken())">Page #</button>
                            <button class="chip" @onclick="InsertPageOf">Page X of Y</button>
                            <button class="chip" @onclick='() => InsertToken("{total}")'>Total</button>
                            <button class="chip" @onclick='() => InsertToken("{filename}")'>Filename</button>
                            <button class="chip" @onclick='() => InsertToken("{filepath}")'>Full path</button>
                            <button class="chip" @onclick="InsertDate">Date</button>
                            <button class="chip" @onclick="InsertTime">Time</button>
                            <button class="chip" @onclick="InsertDateTime">Date+Time</button>
                        </div>
                    }
                </div>

                @* ── Header band ── *@
                <div class="hf-band">
                    <label class="hf-toggle"><input type="checkbox" @bind="_hfHeaderOn" /> Header</label>
                    @if (_hfQuick)
                    {
                        <div class="hf-grid @(_hfHeaderOn ? null : "off")">
                            @RenderSlot("H", "L")
                            @RenderSlot("H", "C")
                            @RenderSlot("H", "R")
                        </div>
                    }
                    else
                    {
                        <div class="hf-grid @(_hfHeaderOn ? null : "off")">
                            <input class="modal-input" placeholder="Left" @bind="_hfHL" @bind:event="oninput" @onfocus='() => _hfFocused = "HL"' disabled="@(!_hfHeaderOn)" />
                            <input class="modal-input" placeholder="Centre" @bind="_hfHC" @bind:event="oninput" @onfocus='() => _hfFocused = "HC"' disabled="@(!_hfHeaderOn)" />
                            <input class="modal-input" placeholder="Right" @bind="_hfHR" @bind:event="oninput" @onfocus='() => _hfFocused = "HR"' disabled="@(!_hfHeaderOn)" />
                        </div>
                    }
                </div>

                @* ── Footer band ── *@
                <div class="hf-band">
                    <label class="hf-toggle"><input type="checkbox" @bind="_hfFooterOn" /> Footer</label>
                    @if (_hfQuick)
                    {
                        <div class="hf-grid @(_hfFooterOn ? null : "off")">
                            @RenderSlot("F", "L")
                            @RenderSlot("F", "C")
                            @RenderSlot("F", "R")
                        </div>
                    }
                    else
                    {
                        <div class="hf-grid @(_hfFooterOn ? null : "off")">
                            <input class="modal-input" placeholder="Left" @bind="_hfFL" @bind:event="oninput" @onfocus='() => _hfFocused = "FL"' disabled="@(!_hfFooterOn)" />
                            <input class="modal-input" placeholder="Centre" @bind="_hfFC" @bind:event="oninput" @onfocus='() => _hfFocused = "FC"' disabled="@(!_hfFooterOn)" />
                            <input class="modal-input" placeholder="Right" @bind="_hfFR" @bind:event="oninput" @onfocus='() => _hfFocused = "FR"' disabled="@(!_hfFooterOn)" />
                        </div>
                    }
                </div>

                <div class="wm-row">
                    <div style="flex:1">
                        <label class="modal-lbl">Size — @((int)_hfSize)</label>
                        <input type="range" min="6" max="18" step="1" value="@((int)_hfSize)"
                               @oninput="@(e => _hfSize = double.TryParse(e.Value?.ToString(), out var v) ? v : 9)" style="width:100%" />
                    </div>
                    <div>
                        <label class="modal-lbl">Colour</label>
                        <input type="color" class="wm-color" @bind="_hfColor" @bind:event="oninput" />
                    </div>
                </div>

                <label class="modal-lbl">Page fit</label>
                <select class="hf-fmt hf-fit" @bind="_hfFit">
                    <option value="overlay">Overlay on content</option>
                    <option value="reserve">Shrink page to make room</option>
                    <option value="reserveIfIntruding">Shrink only if overlapping</option>
                </select>

                <div class="hf-bgline @(_hfFit == "overlay" ? "off" : null)">
                    <label class="hf-toggle" style="margin:0"><input type="checkbox" @bind="_hfBgOn" disabled="@(_hfFit == "overlay")" /> Band background</label>
                    <input type="color" class="wm-color" @bind="_hfBg" @bind:event="oninput" disabled="@(!_hfBgOn || _hfFit == "overlay")" />
                    @if (_hfFit == "overlay")
                    {
                        <span class="hf-mode-hint">needs a "Shrink" fit to show</span>
                    }
                </div>

                <label class="modal-lbl">Pages</label>
                <div class="seg">
                    <button class="@(_hfAll ? "on" : null)" @onclick="() => _hfAll = true">All pages</button>
                    <button class="@(!_hfAll ? "on" : null)" @onclick="() => _hfAll = false">Range</button>
                    @if (!_hfAll)
                    {
                        <span class="hf-range">
                            from <input type="number" min="1" class="wm-angle" @bind="_hfFrom" />
                            to <input type="number" min="0" class="wm-angle" @bind="_hfTo" placeholder="last" />
                        </span>
                    }
                </div>

                <div class="hf-preview">
                    @if (_hfHeaderOn && (HasText(_hfHL) || HasText(_hfHC) || HasText(_hfHR)))
                    {
                        <div class="hf-prow"><span>@HfSample(_hfHL)</span><span>@HfSample(_hfHC)</span><span>@HfSample(_hfHR)</span></div>
                    }
                    <div class="hf-prow hf-pbody">page body…</div>
                    @if (_hfFooterOn && (HasText(_hfFL) || HasText(_hfFC) || HasText(_hfFR)))
                    {
                        <div class="hf-prow"><span>@HfSample(_hfFL)</span><span>@HfSample(_hfFC)</span><span>@HfSample(_hfFR)</span></div>
                    }
                </div>

                <div class="modal-foot">
                    @if (DeskHasHeaderFooter(hfId) && (HasText(_hfHL) || HasText(_hfHC) || HasText(_hfHR)))
                    {
                        <button class="ghost" @onclick="ClearHeaderBand">Remove header</button>
                    }
                    @if (DeskHasHeaderFooter(hfId) && (HasText(_hfFL) || HasText(_hfFC) || HasText(_hfFR)))
                    {
                        <button class="ghost" @onclick="ClearFooterBand">Remove footer</button>
                    }
                    <span style="flex:1"></span>
                    <button class="primary" @onclick="() => ApplyHeaderFooterEdit(hfId)">Set header / footer</button>
                </div>
            </div>
        </div>
    }

    @if (_scatterDesk is { } scId)
    {
        <div class="modal-scrim" @onclick="CloseScatter">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <span>Scatter · @(DeskName(scId))</span>
                    <button @onclick="CloseScatter" aria-label="Close"><Icon Name="x" Size="16" /></button>
                </div>
                <p class="modal-body">Write every page of this desk as its own single-page PDF into:</p>
                <div class="folder-row">
                    <span class="folder-path" title="@_scatterFolder">@_scatterFolder</span>
                    <button class="link" @onclick="ChangeScatterFolder">change…</button>
                </div>
                <div class="modal-foot">
                    <span style="flex:1"></span>
                    <button class="primary" @onclick="() => RunScatter(scId)" disabled="@_busy">@(_busy ? "scattering…" : "Scatter →")</button>
                </div>
            </div>
        </div>
    }

    @if (_expDesk is { } exId)
    {
        <div class="modal-scrim" @onclick="CloseExport">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <span>Export · @(DeskName(exId))</span>
                    <button @onclick="CloseExport" aria-label="Close"><Icon Name="x" Size="16" /></button>
                </div>
                <label class="modal-lbl">Format</label>
                <div class="seg">
                    <button class="@(_expPdf ? "on" : null)" @onclick="() => _expPdf = true" title="Export as a single PDF (desk settings applied)">PDF</button>
                    @foreach (var f in _formats)
                    {
                        <button class="@(!_expPdf && _expFormat == f ? "on" : null)" @onclick="() => { _expPdf = false; _expFormat = f; }">@f.ToString().ToUpperInvariant()</button>
                    }
                </div>
                <label class="modal-lbl">Pages</label>
                <div class="seg">
                    <button class="@(_expSelectedOnly ? "on" : null)" @onclick="() => _expSelectedOnly = true" disabled="@(BenchSvc.SelectedInDesk(exId) == 0)">Selected (@BenchSvc.SelectedInDesk(exId))</button>
                    <button class="@(!_expSelectedOnly ? "on" : null)" @onclick="() => _expSelectedOnly = false">All</button>
                </div>
                @if (!_expPdf && _expFormat != ChuvadiReader.Core.Documents.ExportFormat.Svg)
                {
                    <label class="modal-lbl">Resolution</label>
                    <div class="seg">
                        @foreach (var d in _dpis)
                        {
                            <button class="@(_expDpi == d ? "on" : null)" @onclick="() => _expDpi = d">@d dpi</button>
                        }
                    </div>
                }
                @if (_expPdf)
                {
                    <p class="modal-note">You'll choose where to save the PDF. Watermark, header/footer, numbering and bookmarks are applied.</p>
                }
                else
                {
                    <div class="folder-row">
                        <span class="folder-path" title="@_expFolder">@_expFolder</span>
                        <button class="link" @onclick="ChangeExportFolder">change…</button>
                    </div>
                }
                <div class="modal-foot">
                    <span style="flex:1"></span>
                    <button class="primary" @onclick="() => RunExport(exId)" disabled="@_expBusy">@(_expBusy ? "exporting…" : (_expPdf ? "Save PDF →" : "Export →"))</button>
                </div>
            </div>
        </div>
    }

    @if (_imposeDesk is { } impId)
    {
        <div class="modal-scrim" @onclick="CloseImpose">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <span>Impose · @(DeskName(impId))</span>
                    <button @onclick="CloseImpose" aria-label="Close"><Icon Name="x" Size="16" /></button>
                </div>
                <label class="modal-lbl">Mode</label>
                <div class="seg">
                    <button class="@(_impMode == "nup" ? "on" : null)" @onclick='() => _impMode = "nup"'>N-up</button>
                    <button class="@(_impMode == "booklet" ? "on" : null)" @onclick='() => _impMode = "booklet"'>Booklet</button>
                </div>
                @if (_impMode == "nup")
                {
                    <label class="modal-lbl">Layout</label>
                    <div class="seg seg-wrap">
                        <button class="@(_impLayout == "2" ? "on" : null)" @onclick='() => SetImpLayout("2")'>2-up</button>
                        <button class="@(_impLayout == "4" ? "on" : null)" @onclick='() => SetImpLayout("4")'>4-up</button>
                        <button class="@(_impLayout == "6" ? "on" : null)" @onclick='() => SetImpLayout("6")'>6-up</button>
                        <button class="@(_impLayout == "9" ? "on" : null)" @onclick='() => SetImpLayout("9")'>9-up</button>
                        <button class="@(_impLayout == "custom" ? "on" : null)" @onclick='() => SetImpLayout("custom")'>Custom</button>
                    </div>
                    @if (_impLayout == "custom")
                    {
                        <div class="imp-custom">
                            <label class="imp-fld"><span>Rows</span><input type="number" min="1" max="6" @bind="_impRows" /></label>
                            <span class="imp-x">×</span>
                            <label class="imp-fld"><span>Cols</span><input type="number" min="1" max="6" @bind="_impCols" /></label>
                        </div>
                    }
                }
                else
                {
                    <p class="modal-note">Pages are reordered saddle-stitch and laid out 2-up per sheet side (padded to a multiple of four). Print double-sided, fold, and staple down the centre.</p>
                }
                <label class="modal-lbl">Sheet</label>
                <div class="seg">
                    <button class="@(_impSheet == "A4" ? "on" : null)" @onclick='() => _impSheet = "A4"'>A4</button>
                    <button class="@(_impSheet == "Letter" ? "on" : null)" @onclick='() => _impSheet = "Letter"'>Letter</button>
                </div>
                <label class="modal-lbl">Gutter</label>
                <div class="seg">
                    <button class="@(_impGutter == 0 ? "on" : null)" @onclick="() => _impGutter = 0">None</button>
                    <button class="@(_impGutter == 8 ? "on" : null)" @onclick="() => _impGutter = 8">Small</button>
                    <button class="@(_impGutter == 18 ? "on" : null)" @onclick="() => _impGutter = 18">Medium</button>
                </div>
                <div class="modal-foot">
                    <span style="flex:1"></span>
                    <button class="ghost" @onclick="CloseImpose">Cancel</button>
                    <button class="primary" @onclick="() => RunImpose(impId)" disabled="@_impBusy">@(_impBusy ? "imposing…" : "Impose →")</button>
                </div>
            </div>
        </div>
    }

    @if (_numberDesk is { } numId)
    {
        <div class="modal-scrim" @onclick="CloseNumbering">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <span>Numbering · @(DeskName(numId))</span>
                    <button @onclick="CloseNumbering" aria-label="Close"><Icon Name="x" Size="16" /></button>
                </div>
                <label class="modal-lbl">Style</label>
                <div class="seg">
                    <button class="@(_numStyle == NumberStyle.PageOnly ? "on" : null)" @onclick="() => _numStyle = NumberStyle.PageOnly">Page X</button>
                    <button class="@(_numStyle == NumberStyle.PageOfTotal ? "on" : null)" @onclick="() => _numStyle = NumberStyle.PageOfTotal">Page X of Y</button>
                    <button class="@(_numStyle == NumberStyle.Bates ? "on" : null)" @onclick="() => _numStyle = NumberStyle.Bates">Bates</button>
                </div>
                @if (_numStyle == NumberStyle.Bates)
                {
                    <div class="imp-custom">
                        <label class="imp-fld"><span>Prefix</span><input type="text" maxlength="16" @bind="_numPrefix" /></label>
                        <label class="imp-fld"><span>Start</span><input type="number" min="0" @bind="_numStart" /></label>
                        <label class="imp-fld"><span>Zero-pad</span><input type="number" min="0" max="10" @bind="_numPad" /></label>
                    </div>
                }
                else
                {
                    <div class="imp-custom">
                        <label class="imp-fld"><span>Start at</span><input type="number" min="0" @bind="_numStart" /></label>
                    </div>
                }
                <label class="modal-lbl">Position</label>
                <div class="seg seg-wrap">
                    <button class="@(_numPos == NumberPosition.BottomLeft ? "on" : null)" @onclick="() => _numPos = NumberPosition.BottomLeft">Btm-left</button>
                    <button class="@(_numPos == NumberPosition.BottomCenter ? "on" : null)" @onclick="() => _numPos = NumberPosition.BottomCenter">Btm-centre</button>
                    <button class="@(_numPos == NumberPosition.BottomRight ? "on" : null)" @onclick="() => _numPos = NumberPosition.BottomRight">Btm-right</button>
                    <button class="@(_numPos == NumberPosition.TopLeft ? "on" : null)" @onclick="() => _numPos = NumberPosition.TopLeft">Top-left</button>
                    <button class="@(_numPos == NumberPosition.TopRight ? "on" : null)" @onclick="() => _numPos = NumberPosition.TopRight">Top-right</button>
                </div>
                <label class="modal-lbl">Font size</label>
                <div class="seg">
                    @foreach (var fs in _numSizes)
                    {
                        <button class="@(_numSize == fs ? "on" : null)" @onclick="() => _numSize = fs">@fs</button>
                    }
                </div>
                <label class="modal-lbl">Pages</label>
                <div class="seg">
                    <button class="@(_numAll ? "on" : null)" @onclick="() => _numAll = true">All</button>
                    <button class="@(!_numAll ? "on" : null)" @onclick="() => _numAll = false">Range</button>
                </div>
                @if (!_numAll)
                {
                    <div class="imp-custom">
                        <label class="imp-fld"><span>From</span><input type="number" min="1" @bind="_numFrom" /></label>
                        <span class="imp-x">–</span>
                        <label class="imp-fld"><span>To (0 = last)</span><input type="number" min="0" @bind="_numTo" /></label>
                    </div>
                }
                <label class="modal-lbl">First page</label>
                <div class="seg seg-wrap">
                    <button class="@(_numFirst == FirstPageMode.Number ? "on" : null)" @onclick="() => _numFirst = FirstPageMode.Number">Number it</button>
                    <button class="@(_numFirst == FirstPageMode.SkipKeepCount ? "on" : null)" @onclick="() => _numFirst = FirstPageMode.SkipKeepCount">Skip, keep count</button>
                    <button class="@(_numFirst == FirstPageMode.SkipRenumber ? "on" : null)" @onclick="() => _numFirst = FirstPageMode.SkipRenumber">Skip &amp; renumber</button>
                </div>
                <p class="modal-note">Preview: <strong>@NumPreview()</strong> · counts every page (blanks included) and applies at Bind / Export.</p>
                <div class="modal-foot">
                    @if (BenchSvc.FindDesk(numId)?.Numbering is not null)
                    {
                        <button class="ghost" @onclick="() => ClearNumbering(numId)">Clear</button>
                    }
                    <span style="flex:1"></span>
                    <button class="ghost" @onclick="CloseNumbering">Cancel</button>
                    <button class="primary" @onclick="() => ApplyNumberingToDesk(numId)">Apply</button>
                </div>
            </div>
        </div>
    }

    @if (_pressSrc is not null)
    {
        <div class="modal-scrim" @onclick="ClosePress">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <span>Press · @System.IO.Path.GetFileName(_pressSrc)</span>
                    <button @onclick="ClosePress" aria-label="Close"><Icon Name="x" Size="16" /></button>
                </div>
                <label class="modal-lbl">Strength</label>
                <div class="seg">
                    <button class="@(_pressPreset == PressPreset.Light ? "on" : null)" @onclick="() => _pressPreset = PressPreset.Light">Light</button>
                    <button class="@(_pressPreset == PressPreset.Balanced ? "on" : null)" @onclick="() => _pressPreset = PressPreset.Balanced">Balanced</button>
                    <button class="@(_pressPreset == PressPreset.Strong ? "on" : null)" @onclick="() => _pressPreset = PressPreset.Strong">Strong</button>
                </div>
                <p class="modal-note">@PresetHint(_pressPreset)</p>
                <div class="folder-row">
                    <span class="folder-path" title="@_pressFolder">@_pressFolder</span>
                    <button class="link" @onclick="ChangePressFolder">change…</button>
                </div>
                @if (_pressResult is { } r)
                {
                    <div class="press-result">Saved <b>@r.SavedPercent.ToString("0.#")%</b> · @Fmt(r.BeforeBytes) → @Fmt(r.AfterBytes)</div>
                }
                <div class="modal-foot">
                    @if (_pressResult is not null)
                    {
                        <button class="ghost" @onclick="OpenPressResult">Open</button>
                    }
                    <span style="flex:1"></span>
                    <button class="primary" @onclick="RunPress" disabled="@_pressBusy">@(_pressBusy ? "pressing…" : "Press →")</button>
                </div>
            </div>
        </div>
    }

    @if (_propsSrc is not null)
    {
        <div class="modal-scrim" @onclick="CloseProps">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <span>Properties · @System.IO.Path.GetFileName(_propsSrc)</span>
                    <button @onclick="CloseProps" aria-label="Close"><Icon Name="x" Size="16" /></button>
                </div>
                @if (_propsBusy)
                {
                    <p class="modal-body">Reading…</p>
                }
                else if (_props is { } p)
                {
                    <div class="prop-rows">
                        @foreach (var (label, val) in PropRows(p))
                        {
                            <div class="prop-row"><span class="prop-k">@label</span><span class="prop-v">@val</span></div>
                        }
                    </div>
                }
                else
                {
                    <p class="modal-body">Couldn't read properties.</p>
                }
            </div>
        </div>
    }

    @if (_showReset)
    {
        <div class="modal-scrim" @onclick="() => _showReset = false">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <span>Clear the bench?</span>
                    <button @onclick="() => _showReset = false" aria-label="Close"><Icon Name="x" Size="16" /></button>
                </div>
                <p class="modal-body">This removes every source and desk. Bound files already saved are untouched.</p>
                <div class="modal-foot">
                    <span style="flex:1"></span>
                    <button class="ghost" @onclick="() => _showReset = false">Cancel</button>
                    <button class="primary danger" @onclick="DoReset">Clear bench</button>
                </div>
            </div>
        </div>
    }
    @if (_cropPageId is { } cropId)
    {
        <div class="modal-scrim" @onclick="CancelCrop">
            <div class="modal crop-modal" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <span>Crop page</span>
                    <button @onclick="CancelCrop" aria-label="Close"><Icon Name="x" Size="16" /></button>
                </div>
                <p class="modal-note">Drag a rectangle over the page to mark the area, then pick how to apply it. Baked in at Bind; drag again to redraw.</p>
                <div class="crop-stage-wrap">
                    <div class="crop-stage">
                        @if (_cropThumb is { } t)
                        {
                            @((MarkupString)t)
                        }
                        <div class="crop-ov" @ref="_cropOvRef"
                             @onpointerdown="CropPointerDown" @onpointerdown:preventDefault="true"
                             @onpointermove="CropPointerMove"
                             @onpointerup="CropPointerUp">
                            @if (_cropHasSel)
                            {
                                <div class="crop-sel" style="left:@Px(_selX);top:@Px(_selY);width:@Px(_selW);height:@Px(_selH)"></div>
                            }
                        </div>
                    </div>
                </div>
                <div class="crop-modes">
                    <button class="cm" @onclick="() => ApplyCropMode(cropId, CropFit.Mask)" disabled="@(!_cropHasSel)" title="Keep the area; blank the rest of the page. Page size unchanged.">Blank rest</button>
                    <button class="cm" @onclick="() => ApplyCropMode(cropId, CropFit.ToSize)" disabled="@(!_cropHasSel)" title="Shrink the page down to exactly the selected area.">Crop to size</button>
                    <button class="cm" @onclick="() => ApplyCropMode(cropId, CropFit.FitPage)" disabled="@(!_cropHasSel)" title="Scale the area to fill the original page size (no margin).">Fit to page</button>
                    <button class="cm" @onclick="() => ApplyCropMode(cropId, CropFit.FitMargin)" disabled="@(!_cropHasSel)" title="Scale the area to fit the page with a default 0.5 in margin.">Fit + margin</button>
                </div>
                <div class="modal-foot">
                    @if (BenchSvc.HasCrop(cropId))
                    {
                        <button class="ghost" @onclick="() => ClearCrop(cropId)">Clear crop</button>
                    }
                    <span style="flex:1"></span>
                    <button class="ghost" @onclick="CancelCrop">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (_marginsPageId is { } marginId)
    {
        <div class="modal-scrim" @onclick="CancelMargins">
            <div class="modal margins-modal" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <span>Add margins</span>
                    <button @onclick="CancelMargins" aria-label="Close"><Icon Name="x" Size="16" /></button>
                </div>
                <p class="modal-note">The page keeps its size; its content scales to fit inside the margins. Set each side, then apply to this page or every page on the desk.</p>
                <div class="mg-row">
                    <span class="mg-lbl">Units</span>
                    <div class="mg-units">
                        <button class="@(_mUnit == "in" ? "on" : null)" @onclick='() => SetMarginUnit("in")'>in</button>
                        <button class="@(_mUnit == "cm" ? "on" : null)" @onclick='() => SetMarginUnit("cm")'>cm</button>
                    </div>
                    <span style="flex:1"></span>
                    <button class="mg-default" @onclick="MarginDefault">Default (0.5 in)</button>
                </div>
                <div class="mg-grid">
                    <label class="mg-fld"><span>Top</span><input type="number" min="0" step="0.05" @bind="_mT" /></label>
                    <label class="mg-fld"><span>Right</span><input type="number" min="0" step="0.05" @bind="_mR" /></label>
                    <label class="mg-fld"><span>Bottom</span><input type="number" min="0" step="0.05" @bind="_mB" /></label>
                    <label class="mg-fld"><span>Left</span><input type="number" min="0" step="0.05" @bind="_mL" /></label>
                </div>
                <div class="modal-foot">
                    @if (BenchSvc.HasMargins(marginId))
                    {
                        <button class="ghost" @onclick="() => ClearMargins(marginId)">Clear</button>
                    }
                    <span style="flex:1"></span>
                    <button class="ghost" @onclick="CancelMargins">Cancel</button>
                    <button class="ghost" @onclick="() => ApplyMarginsToPages(marginId, false)">This page</button>
                    <button class="primary" @onclick="() => ApplyMarginsToPages(marginId, true)">All pages</button>
                </div>
            </div>
        </div>
    }

    @if (_compareOpen && _comparePair is { } cp)
    {
        <div class="modal-scrim" @onclick="CloseCompare">
            <div class="modal modal-wide cmp-modal" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <span>Compare pages</span>
                    <button class="modal-x" @onclick="CloseCompare" aria-label="Close"><Icon Name="x" Size="14" /></button>
                </div>
                <div class="cmp-grid">
                    <div class="cmp-col">
                        <div class="cmp-cap">@PageLabel(cp.A)@CompareDeskSuffix(cp.A)</div>
                        <div class="cmp-stage">
                            @{
                                string? svgA = null;
                                if (!cp.A.IsBlank && !cp.A.IsImage)
                                {
                                    BenchSvc.TryGetThumb(cp.A, out svgA);
                                }
                            }
                            <div class="cmp-page" style="@PageAspectStyle(svgA);transform:rotate(@(cp.A.Rotation)deg)">
                                @if (cp.A.IsBlank)
                                {
                                    <div class="cmp-blank" style="@BlankStyle(cp.A)"></div>
                                }
                                else if (cp.A.IsImage)
                                {
                                    <img class="cmp-img" src="@ImageSrc(cp.A)" alt="(image)" />
                                }
                                else if (svgA is not null)
                                {
                                    @((MarkupString)ResponsiveSvg(svgA))
                                }
                            </div>
                        </div>
                    </div>
                    <div class="cmp-col">
                        <div class="cmp-cap">@PageLabel(cp.B)@CompareDeskSuffix(cp.B)</div>
                        <div class="cmp-stage">
                            @{
                                string? svgB = null;
                                if (!cp.B.IsBlank && !cp.B.IsImage)
                                {
                                    BenchSvc.TryGetThumb(cp.B, out svgB);
                                }
                            }
                            <div class="cmp-page" style="@PageAspectStyle(svgB);transform:rotate(@(cp.B.Rotation)deg)">
                                @if (cp.B.IsBlank)
                                {
                                    <div class="cmp-blank" style="@BlankStyle(cp.B)"></div>
                                }
                                else if (cp.B.IsImage)
                                {
                                    <img class="cmp-img" src="@ImageSrc(cp.B)" alt="(image)" />
                                }
                                else if (svgB is not null)
                                {
                                    @((MarkupString)ResponsiveSvg(svgB))
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <p class="modal-note">Showing the two selected pages. Close and select a different pair to compare others.</p>
            </div>
        </div>
    }
</div>

@code {
    private ElementReference _grid;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Bench>? _ref;
    private bool _dirty = true;

    private bool _busy;
    private string? _busyLabel;
    private bool _error;
    private string? _status;
    private string? _resultPath;

    private Guid? _deskMenu;
    private bool _sessionMenu;
    private List<DeskTemplateDto> _templates = new();
    private int _perRow = 1;
    private bool _fetching;
    private readonly Dictionary<Guid, string> _imgCache = new();

    private bool _compareOpen;
    private (BenchPage A, BenchPage B)? _comparePair;

    // Interleave (item 13) shelf picker
    private bool _interleaveOpen;
    private int _ilA;
    private int _ilB = 1;

    // Crop (item 14) modal — Blazor-native drag
    private Guid? _cropPageId;
    private string? _cropThumb;
    private ElementReference _cropOvRef;
    private double _cropOvW, _cropOvH, _sx0, _sy0, _selX, _selY, _selW, _selH;
    private bool _cropDrawing, _cropHasSel;

    // Margins dialog state.
    private Guid? _marginsPageId;
    private string _mUnit = "in";
    private double _mT, _mR, _mB, _mL;

    // Source filter / search state (#19, #25) — keyed by source index.
    private readonly Dictionary<int, string> _srcQuery = new();
    private readonly Dictionary<int, string> _srcRange = new();
    private readonly Dictionary<int, List<int>> _srcMatches = new();
    private readonly HashSet<int> _srcSearching = new();
    private readonly HashSet<int> _srcSearched = new();

    // Shelf thumbnail size (#27): step 0..3 → px.
    private int _shelfThumbStep = 1;
    private static readonly int[] _shelfThumbSteps = { 40, 56, 76, 104 };
    private int ShelfThumbPx => _shelfThumbSteps[Math.Clamp(_shelfThumbStep, 0, _shelfThumbSteps.Length - 1)];

    private static readonly ChuvadiReader.Core.Documents.ExportFormat[] _formats =
        { ChuvadiReader.Core.Documents.ExportFormat.Svg, ChuvadiReader.Core.Documents.ExportFormat.Png,
          ChuvadiReader.Core.Documents.ExportFormat.Jpg, ChuvadiReader.Core.Documents.ExportFormat.Bmp };
    private static readonly int[] _dpis = { 96, 150, 220, 300 };

    protected override async Task OnInitializedAsync()
    {
        BenchSvc.EnsureDesk();
        BenchSvc.Changed += OnBenchChanged;
        BenchDrop.SetBenchActive(true);
        BenchDrop.FilesDropped += OnFilesDropped;
        try
        {
            var saved = await Storage.GetAsync("bench.perRow");
            if (int.TryParse(saved, out var n) && n is >= 1 and <= 3)
            {
                _perRow = n;
            }
        }
        catch { /* default to 1 */ }
    }

    private void OnBenchChanged()
    {
        _dirty = true;
        InvokeAsync(StateHasChanged);
    }

    // #21 — files dropped from Explorer while the Bench is open are added to the shelf.
    private void OnFilesDropped(IReadOnlyList<string> paths)
        => _ = InvokeAsync(() => AddDroppedFiles(paths));

    private async Task AddDroppedFiles(IReadOnlyList<string> paths)
    {
        var pdfs = paths
            .Where(p => string.Equals(System.IO.Path.GetExtension(p), ".pdf", StringComparison.OrdinalIgnoreCase))
            .ToList();
        var skipped = paths.Count - pdfs.Count;

        var added = 0;
        foreach (var p in pdfs)
        {
            try
            {
                await BenchSvc.AddSourceAsync(p, System.IO.Path.GetFileName(p));
                added++;
            }
            catch (Exception ex)
            {
                _error = true;
                _status = $"Couldn't add {System.IO.Path.GetFileName(p)}: {ex.Message}";
            }
        }

        if (added > 0)
        {
            _error = false;
            _status = skipped > 0
                ? $"Added {added} file{(added == 1 ? "" : "s")} to the shelf · {skipped} non-PDF skipped."
                : $"Added {added} file{(added == 1 ? "" : "s")} to the shelf.";
        }
        else if (skipped > 0)
        {
            _error = true;
            _status = "Only PDF files can be added to the shelf.";
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ChuvadiReader.Ui/js/bench.js");
            _ref ??= DotNetObjectReference.Create(this);
            if (_dirty)
            {
                _dirty = false;
                await _module.InvokeVoidAsync("init", _grid, _ref, true);
            }
        }
        catch (JSException)
        {
            // Drag/lazy-thumb conveniences unavailable; static layout still renders.
        }
    }

    [JSInvokable]
    public async Task RenderThumb(string pageId)
    {
        if (!Guid.TryParse(pageId, out var id)) return;
        var page = BenchSvc.Desks.SelectMany(d => d.Pages).FirstOrDefault(p => p.Id == id);
        if (page is null || page.IsBlank || page.IsImage) return;
        if (BenchSvc.TryGetThumb(page, out _)) { StateHasChanged(); return; }
        await BenchSvc.RenderThumbAsync(page);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task RenderShelfThumb(int sourceIndex, int pageIndex)
    {
        if (BenchSvc.TryGetSourceThumb(sourceIndex, pageIndex, out _)) { StateHasChanged(); return; }
        await BenchSvc.RenderSourceThumbAsync(sourceIndex, pageIndex);
        StateHasChanged();
    }

    [JSInvokable]
    public void DropShelfPage(int sourceIndex, int pageIndex, string deskId, int index)
    {
        if (Guid.TryParse(deskId, out var d))
        {
            BenchSvc.AddPageToDesk(d, sourceIndex, pageIndex, index);
        }
    }

    [JSInvokable]
    public void DropDeskPage(string pageId, string deskId, int index)
    {
        if (Guid.TryParse(pageId, out var pg) && Guid.TryParse(deskId, out var d))
        {
            BenchSvc.MovePage(pg, d, index);
        }
    }

    [JSInvokable]
    public void CloseTransient()
    {
        var any = _deskMenu is not null || _wmDesk is not null || _hfDesk is not null || _scatterDesk is not null
                  || _expDesk is not null || _pressSrc is not null || _propsSrc is not null || _showReset || _sessionMenu;
        if (!any) return;
        _deskMenu = null;
        _sessionMenu = false;
        _wmDesk = null;
        _hfDesk = null;
        _scatterDesk = null;
        _expDesk = null;
        _pressSrc = null;
        _propsSrc = null;
        _showReset = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void DropSourceAll(int sourceIndex, string deskId, int index)
    {
        if (Guid.TryParse(deskId, out var d))
        {
            BenchSvc.AddSourceAllToDesk(d, sourceIndex, index);
        }
    }

    [JSInvokable]
    public void SelectBenchPage(string pageId, bool shift)
    {
        if (!Guid.TryParse(pageId, out var id)) return;
        if (shift) BenchSvc.SelectRangeTo(id);
        else BenchSvc.ToggleSelect(id);
    }

    private async Task FetchFile()
    {
        var paths = await Picker.PickDocumentsAsync();
        if (paths.Count == 0) return;
        _status = null;
        _resultPath = null;
        _fetching = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            foreach (var path in paths)
            {
                await BenchSvc.AddSourceAsync(path, System.IO.Path.GetFileName(path));
            }
        }
        finally
        {
            _fetching = false;
        }
    }

    private async Task FetchImageToDesk(Guid deskId)
    {
        _deskMenu = null;
        var paths = await Picker.PickImagesAsync();
        if (paths.Count == 0) return;
        foreach (var path in paths)
        {
            BenchSvc.AddImageToDesk(deskId, path);
        }
    }

    private async Task SetPerRow(int n)
    {
        if (_perRow == n) return;
        _perRow = n;
        try { await Storage.SetAsync("bench.perRow", n.ToString()); }
        catch { /* non-fatal */ }
    }

    private void ToggleCollapse(int sourceIndex) => BenchSvc.ToggleSourceCollapsed(sourceIndex);
    private void ToggleCollapseAll() => BenchSvc.SetAllCollapsed(!BenchSvc.AllCollapsed);

    private static string PageLabel(BenchPage p)
        => p.IsBlank ? "(blank)" : p.IsImage ? "(image)" : (p.OriginalIndex + 1).ToString();

    private string ImageSrc(BenchPage p)
    {
        if (_imgCache.TryGetValue(p.Id, out var uri)) return uri;
        uri = BenchSvc.ImageDataUri(p);
        _imgCache[p.Id] = uri;
        return uri;
    }

    private static string SrcClass(int sourceIndex) => sourceIndex < 0 ? "src-x" : $"src-{sourceIndex % 8}";

    private static string BlankStyle(BenchPage p)
        => string.IsNullOrWhiteSpace(p.BackgroundHex) ? "background:#fff" : $"background:{p.BackgroundHex}";

    private void AddDesk()
    {
        _deskMenu = null;
        BenchSvc.AddDesk();
    }

    private void RemoveDesk(Guid deskId)
    {
        _deskMenu = null;
        BenchSvc.RemoveDesk(deskId);
    }

    private void ClearDesk(Guid deskId)
    {
        _deskMenu = null;
        BenchSvc.ClearDesk(deskId);
    }

    private void DuplicateDesk(Guid deskId)
    {
        _deskMenu = null;
        BenchSvc.DuplicateDesk(deskId);
    }

    // Desk colour palette (#34).
    private Guid? _deskPalette;
    private static readonly string[] _deskColors =
        { "#C2693B", "#D9A441", "#5E8C61", "#3E7CB1", "#7B5EA7", "#B0506E", "#4A4A4A", "#8A8F98" };

    private void ToggleDeskPalette(Guid deskId) => _deskPalette = _deskPalette == deskId ? null : deskId;

    private void PickDeskColour(Guid deskId, string? hex)
    {
        BenchSvc.SetDeskColour(deskId, hex);
        _deskPalette = null;
    }

    private void CloseSource(int sourceIndex)
    {
        if (BenchSvc.TryRemoveSource(sourceIndex))
        {
            _status = null;
            _error = false;
        }
        else
        {
            _status = "This file still has pages on a desk. Use a desk's \u201CClear\u201D button to delete all its pages first, then close the file.";
            _error = true;
        }
    }

    private void RenameDesk(Guid deskId, string? name) => BenchSvc.RenameDesk(deskId, name ?? "");

    private string DeskName(Guid deskId) => BenchSvc.FindDesk(deskId)?.Name ?? "Desk";

    private bool DeskHasWatermark(Guid deskId) => BenchSvc.FindDesk(deskId)?.Watermark is not null;

    private void AddBlank(Guid deskId)
    {
        _deskMenu = null;
        BenchSvc.AddBlankToDesk(deskId);
    }

    private void TurnPage(Guid pageId) => BenchSvc.TurnPage(pageId);

    private void Undo() => BenchSvc.Undo();

    // ── sessions, templates, handoff (#36 / #37 / #56 / #57) ────────────────────

    private void ToggleSessionMenu()
    {
        _sessionMenu = !_sessionMenu;
        _deskMenu = null;
    }

    private async Task ToggleDeskMenu(Guid deskId)
    {
        if (_deskMenu == deskId)
        {
            _deskMenu = null;
            return;
        }

        _deskMenu = deskId;
        _sessionMenu = false;
        await LoadTemplates();
    }

    private async Task LoadTemplates()
    {
        try
        {
            _templates = await Session.ListTemplatesAsync();
        }
        catch
        {
            _templates = new List<DeskTemplateDto>();
        }
    }

    private async Task SaveSession()
    {
        _sessionMenu = false;
        var path = await Picker.PickSaveSessionAsync("bench-session");
        if (string.IsNullOrEmpty(path))
        {
            return;
        }

        try
        {
            await Session.SaveSessionAsync(path, BenchSvc.ExportSession());
            _error = false;
            _status = $"Session saved to {System.IO.Path.GetFileName(path)}.";
        }
        catch (Exception ex)
        {
            _error = true;
            _status = $"Couldn't save the session: {ex.Message}";
        }
    }

    private async Task OpenSession()
    {
        _sessionMenu = false;
        var path = await Picker.PickOpenSessionAsync();
        if (string.IsNullOrEmpty(path))
        {
            return;
        }

        _busy = true;
        _busyLabel = "Opening session…";
        StateHasChanged();
        try
        {
            var dto = await Session.LoadSessionAsync(path);
            var result = await BenchSvc.ImportSessionAsync(dto);
            _error = false;
            _status = result.HasWarnings
                ? $"Session opened with {result.SourcesLoaded} source(s). Skipped {result.SourcesMissing} missing source(s) and {result.PagesSkipped} page(s): {string.Join("; ", result.Warnings.Take(4))}{(result.Warnings.Count > 4 ? "…" : "")}"
                : $"Session opened — {result.SourcesLoaded} source(s) restored.";
        }
        catch (Exception ex)
        {
            _error = true;
            _status = $"Couldn't open the session: {ex.Message}";
        }
        finally
        {
            _busy = false;
            _busyLabel = null;
            StateHasChanged();
        }
    }

    private async Task SaveDeskAsTemplate(Guid deskId)
    {
        _deskMenu = null;
        var desk = BenchSvc.Desks.FirstOrDefault(d => d.Id == deskId);
        var name = string.IsNullOrWhiteSpace(desk?.Name) ? "Template" : desk!.Name.Trim();
        var tpl = BenchSvc.CaptureTemplate(deskId, name);
        if (tpl is null)
        {
            return;
        }

        try
        {
            await Session.SaveTemplateAsync(tpl);
            await LoadTemplates();
            _error = false;
            _status = $"Saved desk settings as template \"{tpl.Name}\".";
        }
        catch (Exception ex)
        {
            _error = true;
            _status = $"Couldn't save the template: {ex.Message}";
        }
    }

    private void ApplyDeskTemplate(Guid deskId, DeskTemplateDto template)
    {
        _deskMenu = null;
        BenchSvc.ApplyTemplate(deskId, template);
        _error = false;
