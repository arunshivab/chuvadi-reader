    public async ValueTask DisposeAsync()
    {
        BenchSvc.Changed -= OnBenchChanged;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        _ref?.Dispose();
    }
