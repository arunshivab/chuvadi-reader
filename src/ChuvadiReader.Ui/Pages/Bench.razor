    private async Task BindDeskAndRoute(Guid deskId, bool toRedact)
    {
        _deskMenu = null;
        var desk = BenchSvc.Desks.FirstOrDefault(d => d.Id == deskId);
        if (desk is null || desk.IsEmpty)
        {
            return;
        }

        _busy = true;
        _busyLabel = toRedact ? "Sending to Redact…" : "Opening in Reader…";
        StateHasChanged();
        try
        {
            var safe = string.IsNullOrWhiteSpace(desk.Name) ? "desk" : desk.Name.Trim();
            foreach (var c in System.IO.Path.GetInvalidFileNameChars())
            {
                safe = safe.Replace(c, '_');
            }

            var tmp = System.IO.Path.Combine(System.IO.Path.GetTempPath(), $"{safe}-{Guid.NewGuid():N}.pdf");
            await BenchSvc.BindDeskAsync(deskId, tmp);

            if (toRedact)
            {
                RedactReq.Request(tmp, safe + ".pdf");
                Nav.NavigateTo("/redact");
            }
            else
            {
                OpenDoc.Request(tmp, safe + ".pdf");
                Nav.NavigateTo("/reader");
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _status = $"Couldn't bind the desk: {ex.Message}";
        }
        finally
        {
            _busy = false;
            _busyLabel = null;
            StateHasChanged();
        }
    }

    /// <summary>Strips the intrinsic <c>width</c>/<c>height</c> attributes from the rendered page
    /// SVG so it has only its <c>viewBox</c> and therefore scales to fill its container, instead of
    /// imposing its natural point size (which would overflow the compare frame).</summary>
    private static string ResponsiveSvg(string svg)
    {
        var end = svg.IndexOf('>');
        if (end < 0)
        {
            return svg;
        }

        var head = System.Text.RegularExpressions.Regex.Replace(
            svg[..end], @"\s(width|height)\s*=\s*""[^""]*""", "");
        return head + svg[end..];
    }

    /// <summary>Sizes a compare frame to the page's true aspect ratio, read from the rendered SVG's
    /// viewBox. Matching the frame to the viewBox means the SVG fills it exactly with no clipping or
    /// letterboxing, whatever the page's real size. Falls back to A4 when the viewBox is absent
    /// (e.g. blank/image pages).</summary>
    private static string PageAspectStyle(string? svg)
    {
        var ratio = "1 / 1.414";
        if (!string.IsNullOrEmpty(svg))
        {
            var m = System.Text.RegularExpressions.Regex.Match(
                svg, @"viewBox\s*=\s*[""']\s*[-\d.]+\s+[-\d.]+\s+([\d.]+)\s+([\d.]+)");
            if (m.Success
                && double.TryParse(m.Groups[1].Value, System.Globalization.CultureInfo.InvariantCulture, out var w)
                && double.TryParse(m.Groups[2].Value, System.Globalization.CultureInfo.InvariantCulture, out var h)
                && w > 0 && h > 0)
            {
                ratio = string.Create(
                    System.Globalization.CultureInfo.InvariantCulture, $"{w} / {h}");
            }
        }
        return $"aspect-ratio: {ratio};";
    }

