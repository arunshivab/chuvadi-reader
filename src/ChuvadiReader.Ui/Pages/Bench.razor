    private void OpenCrop(Guid pageId)
    {
        var page = BenchSvc.Desks.SelectMany(d => d.Pages).FirstOrDefault(p => p.Id == pageId);
        if (page is null || page.IsBlank) return;
        _cropPageId = pageId;
        _cropThumb = BenchSvc.TryGetThumb(page, out var svg) ? FitCropSvg(svg) : null;
        _cropDrawing = false; _cropHasSel = false;
        _selX = _selY = _selW = _selH = 0; _cropOvW = _cropOvH = 0;
    }

    // The library emits the page SVG at natural size with units (e.g. width="612pt").
    // CSS isolation can't reliably reach injected SVG, so constrain it inline: fit the
    // whole page into a comfortable preview box (aspect preserved via the viewBox).
    private static string FitCropSvg(string svg)
    {
        if (string.IsNullOrEmpty(svg)) return svg;
        var idx = svg.IndexOf("<svg", StringComparison.OrdinalIgnoreCase);
        if (idx < 0) return svg;
        const string style = " style=\"display:block;width:auto;height:auto;max-width:340px;max-height:64vh\"";
        return svg.Insert(idx + 4, style);
    }

    private async Task CropPointerDown(PointerEventArgs e)
    {
        if (_module is null) return;
        try
        {
            var dims = await _module.InvokeAsync<double[]>("cropBegin", _cropOvRef, e.PointerId);
            _cropOvW = dims.Length > 0 ? dims[0] : 0;
            _cropOvH = dims.Length > 1 ? dims[1] : 0;
        }
        catch (JSException) { _cropOvW = _cropOvH = 0; }
        if (_cropOvW <= 0 || _cropOvH <= 0) return;
        _sx0 = Math.Clamp(e.OffsetX, 0, _cropOvW);
        _sy0 = Math.Clamp(e.OffsetY, 0, _cropOvH);
        _cropDrawing = true; _cropHasSel = true;
        _selX = _sx0; _selY = _sy0; _selW = 0; _selH = 0;
    }

    private void CropPointerMove(PointerEventArgs e)
    {
        if (!_cropDrawing) return;
        var cx = Math.Clamp(e.OffsetX, 0, _cropOvW);
        var cy = Math.Clamp(e.OffsetY, 0, _cropOvH);
        _selX = Math.Min(_sx0, cx); _selY = Math.Min(_sy0, cy);
        _selW = Math.Abs(cx - _sx0); _selH = Math.Abs(cy - _sy0);
    }

    private void CropPointerUp(PointerEventArgs e)
    {
        _cropDrawing = false;
        if (_selW <= 4 || _selH <= 4) _cropHasSel = false;
    }

    private void CancelCrop()
    {
        _cropPageId = null; _cropThumb = null;
        _cropDrawing = false; _cropHasSel = false;
    }

