    /// <summary>Keyboard shortcuts reported by bench.js (it filters out typing in inputs and ignores
    /// keys while a modal is open). Desk-scoped actions target the active desk.</summary>
    [JSInvokable]
    public async Task OnKey(string key, bool ctrl, bool shift, bool alt)
    {
        if (_busy)
        {
            return;
        }

        if (_compareOpen && key == "Escape")
        {
            CloseCompare();
            StateHasChanged();
            return;
        }

        var active = BenchSvc.ActiveDesk;

        if (ctrl && !alt && key is "z" or "Z" && !shift)
        {
            BenchSvc.Undo();
        }
        else if (ctrl && !alt && (key is "y" or "Y" || (shift && key is "z" or "Z")))
        {
            BenchSvc.Redo();
        }
        else if (ctrl && !alt && key is "a" or "A" && active is { } sa)
        {
            BenchSvc.SelectAllInDesk(sa);
        }
        else if (ctrl && !alt && key is "d" or "D" && active is { } sd)
        {
            BenchSvc.DuplicateSelected(sd);
        }
        else if (!ctrl && !alt && key is "r" or "R" && active is { } sr)
        {
            BenchSvc.RotateSelected(sr, clockwise: !shift);
        }
        else if (!ctrl && !alt && key is "Delete" or "Backspace")
        {
            BenchSvc.RemoveSelectedAll();
        }
        else if (key == "Escape")
        {
            BenchSvc.ClearSelection();
        }
        else
        {
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

