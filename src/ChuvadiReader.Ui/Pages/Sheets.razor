@page "/sheets"
@using ChuvadiReader.Ui.Components.Viewers
@inject IFilePicker Picker

@* Thin wrapper: pick an .xlsx and host the shared XlsxView (the same viewer the Reader uses for Excel tabs). *@

<PageTitle>Chuvadi · Sheets</PageTitle>

<div class="shp">
    <div class="shp-bar">
        <a href="/" class="shp-back"><Icon Name="chevron-left" Size="14" /> dashboard</a>
        <span class="shp-title"><Icon Name="grid-view" Size="15" /> Sheets</span>
        @if (!string.IsNullOrEmpty(_path))
        {
            <span class="shp-name" title="@_path">@System.IO.Path.GetFileName(_path)</span>
            @if (!string.IsNullOrEmpty(_meta)) { <span class="shp-meta">@_meta</span> }
        }
        <div class="shp-spacer"></div>
        <button class="shp-open" @onclick="Open"><Icon Name="upload" Size="14" /> Open Excel file</button>
    </div>

    <div class="shp-stage">
        @if (string.IsNullOrEmpty(_path))
        {
            <div class="shp-empty">
                <div class="shp-empty-card">
                    <div class="shp-empty-ic"><Icon Name="grid-view" Size="40" /></div>
                    <h2>View a spreadsheet</h2>
                    <p>Open an <strong>.xlsx</strong> file to read it here as a grid — values, multiple sheets and frozen headers, no Excel needed.</p>
                    <button class="shp-open lg" @onclick="Open"><Icon Name="upload" Size="16" /> Open Excel file</button>
                </div>
            </div>
        }
        else
        {
            <XlsxView @ref="_viewer" Path="@_path" OnStatus="s => _meta = s" />
        }
    </div>
</div>

@code {
    private string _path = "";
    private string? _meta;
    private XlsxView? _viewer;

    private async Task Open()
    {
        var path = await Picker.PickDocumentAsync();
        if (string.IsNullOrEmpty(path)) return;
        if (path == _path && _viewer is not null) { await _viewer.ReloadAsync(); return; }
        _meta = null;
        _path = path;
    }
}
