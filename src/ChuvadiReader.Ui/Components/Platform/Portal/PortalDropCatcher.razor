@namespace ChuvadiReader.Ui.Components.Platform.Portal
@using Microsoft.AspNetCore.Components.Forms
@using ChuvadiReader.Core.Documents
@inject ChuvadiReader.Platform.IDroppedFiles Dropped
@inject IJSRuntime JS
@inject ShellService Shell
@implements IAsyncDisposable

@*
    D-89 A: drag-and-drop on the web portal. While documents are dragged over the window, an invisible
    full-window file input takes the drop (Blazor's own InputFile; nothing to see — the desktop window
    shows nothing either). Image-only drags pass through, so the Reader can still place a dropped image
    on a page. Drops anywhere else are stopped, so the browser never opens the file and leaves the app.
    Rendered by MainLayout only on the portal, when the Web host provides IDroppedFiles.
*@
@if (Dropped.IsAvailable)
{
    <div class="pdrop" @ref="_root">
        <InputFile multiple accept="@Accept" OnChange="OnFilesAsync" class="pdrop-input" tabindex="-1" aria-hidden="true" title="Drop to upload" />
    </div>
}

@code {
    private const int MaxFiles = 64;
    private static readonly string Accept = string.Join(",", DocumentFormatExtensions.OpenableExtensions);

    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Dropped.IsAvailable)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ChuvadiReader.Ui/js/portal-drop.js");
        _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _root);
    }

    private async Task OnFilesAsync(InputFileChangeEventArgs e)
    {
        try
        {
            var max = Dropped.MaxFileBytes;
            var files = e.GetMultipleFiles(MaxFiles)
                .Select(f => new ChuvadiReader.Platform.DroppedFile(f.Name, f.Size, ct => f.OpenReadStream(max, ct)))
                .ToList();
            if (e.FileCount > MaxFiles)
            {
                Shell.Notify($"Couldn't upload {e.FileCount - MaxFiles} of the files: at most {MaxFiles} at a time.", isError: true);
            }

            foreach (var message in await Dropped.ReceiveAsync(files))
            {
                Shell.Notify(message, isError: true);
            }
        }
        catch (Exception ex)
        {
            Shell.Notify("Couldn't upload: " + ex.Message, isError: true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser left; nothing to clean up there.
        }
    }
}
