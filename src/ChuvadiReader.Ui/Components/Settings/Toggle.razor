@namespace ChuvadiReader.Ui.Components.Settings

@* On/off switch. Saves on click; disabled when the row is "coming soon". *@
<button type="button" class="tog @(Value ? "on" : null)" role="switch" aria-checked="@(Value ? "true" : "false")"
        aria-label="@AriaLabel" disabled="@IsDisabled" @onclick="Flip">
    <span class="knob"></span>
</button>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [CascadingParameter(Name = "RowSoon")] public bool RowSoon { get; set; }

    private bool IsDisabled => Disabled || RowSoon;

    private async Task Flip()
    {
        if (IsDisabled)
        {
            return;
        }

        await ValueChanged.InvokeAsync(!Value);
    }
}
