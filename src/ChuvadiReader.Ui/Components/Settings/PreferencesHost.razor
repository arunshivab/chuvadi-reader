@namespace ChuvadiReader.Ui.Components.Settings
@implements IDisposable
@inject PreferencesService Prefs
@inject IJSRuntime JS
@inject IServiceProvider Services

@*
    Renderless. Drop <PreferencesHost /> once into the shell (MainLayout). On first render it
    hydrates PreferencesService and applies UI scale (host window zoom when the host has it,
    else CSS zoom on <html>) + reduce motion; afterwards it
    re-applies whenever a preference changes (Settings saves immediately). The theme is applied
    by the shell itself from ThemeService (use Theme.Current.Key()).
*@

@code {
    // Optional: hosts without whole-window zoom (or tests) simply don't register one.
    private ChuvadiReader.Core.Window.IUiScale? HostScale =>
        Services.GetService(typeof(ChuvadiReader.Core.Window.IUiScale)) as ChuvadiReader.Core.Window.IUiScale;

    protected override void OnInitialized() => Prefs.Changed += OnPrefsChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (Prefs.IsHydrated)
        {
            await PreferencesInterop.ApplyAsync(JS, Prefs, HostScale);
        }
        else
        {
            await Prefs.HydrateAsync(); // raises Changed → applies
        }
    }

    private void OnPrefsChanged() => _ = InvokeAsync(() => PreferencesInterop.ApplyAsync(JS, Prefs, HostScale));

    public void Dispose() => Prefs.Changed -= OnPrefsChanged;
}
