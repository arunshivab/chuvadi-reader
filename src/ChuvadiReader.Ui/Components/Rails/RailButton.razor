@inject ChuvadiReader.Platform.IPlatformInfo Platform
@*
    One button on a D-10 rail (Tools, View or Arrange). Icons only until the rail is hovered;
    then the label and shortcut show. Unbuilt features pass DisabledReason: the button is
    greyed out and the reason is its tooltip (the owner wants them visible, not hidden).
*@
<button class="rb @Class @(Active ? "on" : null) @(Primary ? "primary" : null) @(Danger ? "danger" : null)"
        disabled="@(DisabledReason is not null || Disabled)"
        title="@Tip" aria-label="@Label" aria-pressed="@(Active ? "true" : null)"
        @onclick="OnClick">
    <Icon Name="@Icon" Size="@Size" />
    <span class="rb-l">@Label</span>
    <span class="rb-k">@(DisabledReason is not null ? "soon" : ShownKeys)</span>
</button>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Keys { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Primary { get; set; }
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? DisabledReason { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public int Size { get; set; } = 19;
    [Parameter] public EventCallback OnClick { get; set; }

    private string Tip => DisabledReason is not null
        ? $"{Label} — {DisabledReason}"
        : string.IsNullOrEmpty(Keys) ? Label : $"{Label} ({ShownKeys})";

    private string? ShownKeys => string.IsNullOrEmpty(Keys) ? Keys : Platform.Keys.Format(Keys);
}
