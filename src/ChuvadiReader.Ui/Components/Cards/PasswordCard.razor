@namespace ChuvadiReader.Ui.Components.Cards
@inject IServiceProvider Services
@*
    Password-protect a copy (AES-256) and, for a locked file, remove its password into a new
    copy. The original is never changed; the host's IFilePicker.PickSavePdfAsync picks the
    output path.
*@

<section class="chvd-card" aria-label="Password">
    <header class="head">
        <span class="title">Password</span>
        <span class="meta">AES-256</span>
        <button type="button" class="close" title="Close" aria-label="Close" @onclick="OnClose">
            <Icon Name="close" Size="14" />
        </button>
    </header>

    <span class="lede"><Icon Name="doc-lock" Size="15" />The copy will need a password to open. The original stays as it is.</span>

    <label class="field">
        <span class="label">Password to open</span>
        <span class="input @(OpenPassword.Length > 0 ? "filled" : null)">
            <input type="@(_show ? "text" : "password")" autocomplete="new-password" spellcheck="false"
                   @bind="OpenPassword" @bind:event="oninput" aria-label="Password to open" />
            <button type="button" class="show" @onclick="() => _show = !_show">@(_show ? "hide" : "show")</button>
        </span>
        @if (OpenPassword.Length > 0)
        {
            <span class="meter" aria-hidden="true">
                @for (int i = 1; i <= 4; i++)
                {
                    <span class="bar @(i <= Strength.Score ? StrengthClass : null)"></span>
                }
            </span>
            <span class="hint @StrengthClass">@Strength.Label</span>
        }
    </label>

    <label class="field">
        <span class="label">Confirm</span>
        <span class="input">
            <input type="@(_show ? "text" : "password")" autocomplete="new-password" spellcheck="false"
                   @bind="ConfirmPassword" @bind:event="oninput" aria-label="Confirm password" />
            @if (ConfirmPassword.Length > 0)
            {
                <span class="match @(Matches ? "ok" : "bad")" title="@(Matches ? "Passwords match" : "Passwords don't match")">
                    <Icon Name="@(Matches ? "check" : "warning")" Size="14" />
                </span>
            }
        </span>
    </label>

    <div class="allow">
        <span class="eyebrow">Once opened, allow</span>
        <label class="toggle-row">Printing
            <button type="button" role="switch" class="switch" aria-checked="@(AllowPrint ? "true" : "false")" @onclick="() => AllowPrint = !AllowPrint"><span></span></button>
        </label>
        <label class="toggle-row">Copying text
            <button type="button" role="switch" class="switch" aria-checked="@(AllowCopy ? "true" : "false")" @onclick="() => AllowCopy = !AllowCopy"><span></span></button>
        </label>
        <label class="toggle-row">Changing the document
            <button type="button" role="switch" class="switch" aria-checked="@(AllowModify ? "true" : "false")" @onclick="() => AllowModify = !AllowModify"><span></span></button>
        </label>
    </div>

    @if (Restricted)
    {
        <label class="field">
            <span class="label">Permissions password <span class="opt">(optional)</span></span>
            <span class="input">
                <input type="@(_show ? "text" : "password")" autocomplete="new-password" spellcheck="false"
                       @bind="PermissionsPassword" @bind:event="oninput" aria-label="Permissions password" />
            </span>
            <span class="note">@(PermissionsPassword.Length == 0
                ? "Without one, these limits can't be lifted later."
                : "Lets you lift the limits later.")</span>
        </label>
    }

    <span class="fine">AES-256 · works in Acrobat and browsers</span>

    <div class="footer">
        <button type="button" class="primary" disabled="@(!CanSave)" @onclick="SaveProtectedAsync">
            <Icon Name="lock" Size="15" />@(_busy ? "Saving…" : "Save protected copy")
        </button>

        @if (IsLocked)
        {
            @if (!_removeOpen)
            {
                <span class="aside">Opened a locked file? <button type="button" class="link" disabled="@_busy" @onclick="StartRemove">Remove its password</button></span>
            }
            else
            {
                <div class="remove">
                    @if (string.IsNullOrEmpty(Password) || _askOwner)
                    {
                        @if (_askOwner)
                        {
                            <span class="note">@PasswordService.RemoveRefusedMessage</span>
                        }
                        <span class="input">
                            <input type="password" autocomplete="current-password" placeholder="@(_askOwner ? "Permissions password" : "Current password")"
                                   @bind="RemovePasswordText" @bind:event="oninput" aria-label="Current password" />
                        </span>
                    }
                    <button type="button" class="secondary" disabled="@(_busy || string.IsNullOrEmpty(EffectiveRemovePassword))" @onclick="RemovePasswordAsync">
                        <Icon Name="unlock" Size="15" />Save copy without password
                    </button>
                </div>
            }
        }
    </div>
</section>

@code {
    /// <summary>The source file. Never modified.</summary>
    [Parameter] public string? Path { get; set; }

    [Parameter] public IPdfSession? Session { get; set; }

    /// <summary>Zero-based page in view (<c>ReaderTab.CurrentPageIndex</c>).</summary>
    [Parameter] public int CurrentPage { get; set; }

    /// <summary>The password the file was opened with, when it is protected.</summary>
    [Parameter] public string? Password { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Success/error toasts.</summary>
    [Parameter] public EventCallback<string> OnMessage { get; set; }

    /// <summary>Raised with the output path after a copy is written.</summary>
    [Parameter] public EventCallback<string> OnSaved { get; set; }

    private string OpenPassword { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;
    private string PermissionsPassword { get; set; } = string.Empty;
    private string RemovePasswordText { get; set; } = string.Empty;
    private bool AllowPrint { get; set; } = true;
    private bool AllowCopy { get; set; } = true;
    private bool AllowModify { get; set; } = true;

    private bool _show;
    private bool _busy;
    private bool _removeOpen;
    private bool _isLockedFile;
    private string? _probedPath;
    private PasswordService? _service;

    private PasswordService Service =>
        _service ??= Services.GetService(typeof(PasswordService)) as PasswordService ?? new PasswordService();

    private PasswordStrength Strength => PasswordService.RatePassword(OpenPassword);

    private string StrengthClass => Strength.Score switch { <= 1 => "weak", 2 => "fair", _ => "strong" };

    private bool Matches => OpenPassword.Length > 0 && string.Equals(OpenPassword, ConfirmPassword, StringComparison.Ordinal);

    private bool Restricted => !AllowPrint || !AllowCopy || !AllowModify;

    private bool CanSave => !_busy && !string.IsNullOrEmpty(Path) && Matches;

    private bool IsLocked => Session?.Document.IsEncrypted == true || _isLockedFile;

    // After a refusal the card asks for the owner password; what is typed then wins over the
    // password the file was opened with.
    private bool _askOwner;

    private string EffectiveRemovePassword => string.IsNullOrEmpty(Password) || _askOwner ? RemovePasswordText : Password!;

    protected override void OnParametersSet()
    {
        if (string.Equals(Path, _probedPath, StringComparison.Ordinal))
        {
            return;
        }

        _probedPath = Path;
        _removeOpen = false;
        _askOwner = false;
        try
        {
            _isLockedFile = !string.IsNullOrEmpty(Path) && Service.RequiresPassword(Path!);
        }
        catch
        {
            _isLockedFile = false;
        }
    }

    private async Task SaveProtectedAsync()
    {
        if (!CanSave)
        {
            return;
        }

        var output = await PickOutputAsync("protected");
        if (output is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await Service.ProtectAsync(Path!, output, new PasswordProtectOptions
            {
                OpenPassword = OpenPassword,
                PermissionsPassword = string.IsNullOrEmpty(PermissionsPassword) ? null : PermissionsPassword,
                AllowPrint = AllowPrint,
                AllowCopy = AllowCopy,
                AllowModify = AllowModify,
            }, Password);

            OpenPassword = ConfirmPassword = PermissionsPassword = string.Empty;
            await OnMessage.InvokeAsync("Saved a protected copy · " + System.IO.Path.GetFileName(output));
            await OnSaved.InvokeAsync(output);
        }
        catch (Exception ex)
        {
            await OnMessage.InvokeAsync("Couldn't save the protected copy: " + ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartRemove() => _removeOpen = true;

    private async Task RemovePasswordAsync()
    {
        var pw = EffectiveRemovePassword;
        if (string.IsNullOrEmpty(Path) || string.IsNullOrEmpty(pw))
        {
            return;
        }

        var output = await PickOutputAsync("unlocked");
        if (output is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await Service.RemovePasswordAsync(Path!, pw, output);
            RemovePasswordText = string.Empty;
            _removeOpen = false;
            _askOwner = false;
            await OnMessage.InvokeAsync("Saved a copy without a password · " + System.IO.Path.GetFileName(output));
            await OnSaved.InvokeAsync(output);
        }
        catch (Chuvadi.Pdf.Primitives.PdfPasswordRequiredException)
        {
            await OnMessage.InvokeAsync("That password doesn't open this file.");
        }
        catch (PasswordRemovalRefusedException)
        {
            // Opened with the open password and the file forbids changes: ask for the owner password.
            _askOwner = true;
            RemovePasswordText = string.Empty;
        }
        catch (Exception ex)
        {
            await OnMessage.InvokeAsync("Couldn't remove the password: " + ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string?> PickOutputAsync(string suffix)
    {
        if (Services.GetService(typeof(IFilePicker)) is not IFilePicker picker)
        {
            await OnMessage.InvokeAsync("Saving a copy isn't available here.");
            return null;
        }

        var stem = System.IO.Path.GetFileNameWithoutExtension(Path) ?? "document";
        var chosen = await picker.PickSavePdfAsync($"{stem}-{suffix}.pdf");
        if (chosen is not null && string.Equals(System.IO.Path.GetFullPath(chosen), System.IO.Path.GetFullPath(Path!), StringComparison.OrdinalIgnoreCase))
        {
            await OnMessage.InvokeAsync("Choose a different name — the original is never overwritten.");
            return null;
        }

        return chosen;
    }
}
