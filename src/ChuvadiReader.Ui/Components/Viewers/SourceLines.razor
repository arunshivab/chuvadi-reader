@*
    Numbered, virtualized lines (D-09 frame 11k). Used by TextView, and by MarkdownView / HtmlView
    when "Source" is on. Text is rendered by Blazor (always escaped). Reports the line counter and
    the Find count through the ViewerBase callbacks.
*@
@inherits ViewerBase

<div class="sl-scroll" @ref="_scroll" style="--vw-scale:@Css(Scale);--ln-h:@(_itemPx)px;--sl-chars:@_maxChars">
    <div class="sl-page @(WrapLines ? "wrap" : "nowrap") @WidthClass">
        <Virtualize @key="_generation" Items="_items" ItemSize="_itemPx" OverscanCount="40" Context="ln">
            <div class="sl-ln @(_hitLines.Contains(ln.N) ? "hit" : null)" data-ln="@ln.N">
                <span class="sl-n">@ln.N</span><span class="sl-t">@LineContent(ln.Text)</span>
            </div>
        </Virtualize>
    </div>
</div>

@code {
    /// <summary>The lines to show (display split only; never written back).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Lines { get; set; } = Array.Empty<string>();

    private readonly record struct LineItem(int N, string Text);

    private ElementReference _scroll;
    private LineItem[] _items = Array.Empty<LineItem>();
    private IReadOnlyList<string>? _source;
    private string? _query;
    private double _scale = -1;
    private int _itemPx = 22;
    private int _maxChars;
    private int _generation;
    private HashSet<int> _hitLines = new();
    private int _firstHit;
    private bool _attach, _scrollToHit;

    protected override async Task OnParametersSetAsync()
    {
        bool linesChanged = !ReferenceEquals(Lines, _source);
        if (linesChanged)
        {
            _source = Lines;
            _items = new LineItem[Lines.Count];
            int max = 0;
            for (int i = 0; i < Lines.Count; i++)
            {
                _items[i] = new LineItem(i + 1, Lines[i]);
                var len = VisualLength(Lines[i]);
                if (len > max) max = len;
            }
            _maxChars = Math.Min(max, 4000);
            _generation++;
            _attach = true;
            await ReportCounterAsync(1, Lines.Count, ViewerCounter.Line, force: true);
        }

        if (Math.Abs(Scale - _scale) > 0.0001)
        {
            _scale = Scale;
            _itemPx = (int)Math.Round(22 * Scale);
            _generation++;
        }

        var q = string.IsNullOrEmpty(FindQuery) ? null : FindQuery;
        if (linesChanged || q != _query)
        {
            _query = q;
            await ComputeHitsAsync();
        }
    }

    private async Task ComputeHitsAsync()
    {
        _hitLines = new HashSet<int>();
        _firstHit = 0;
        int count = 0;
        if (_query is not null)
        {
            for (int i = 0; i < _items.Length; i++)
            {
                var t = _items[i].Text;
                int k = t.IndexOf(_query, StringComparison.OrdinalIgnoreCase);
                if (k < 0) continue;
                _hitLines.Add(i + 1);
                if (_firstHit == 0) _firstHit = i + 1;
                while (k >= 0)
                {
                    count++;
                    k = t.IndexOf(_query, k + _query.Length, StringComparison.OrdinalIgnoreCase);
                }
            }
            _scrollToHit = _firstHit > 0;
        }
        await ReportFindCountAsync(count);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_attach)
        {
            _attach = false;
            await JsVoidAsync("attach", _scroll, Self, "lines");
        }
        if (_scrollToHit)
        {
            _scrollToHit = false;
            await JsVoidAsync("scrollToLine", _scroll, _firstHit, _itemPx, true);
        }
    }

    protected override Task HandleScrollAsync(int index) =>
        ReportCounterAsync(index, _items.Length, ViewerCounter.Line);

    public override async Task GoToAsync(int index)
    {
        var n = Math.Clamp(index, 1, Math.Max(1, _items.Length));
        await JsVoidAsync("scrollToLine", _scroll, n, _itemPx, false);
        await ReportCounterAsync(n, _items.Length, ViewerCounter.Line);
    }

    /// <summary>Accepts "L42" or "42".</summary>
    public override Task ScrollToAnchorAsync(string anchor)
    {
        var a = (anchor ?? "").Trim().TrimStart('L', 'l');
        return int.TryParse(a, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var n)
            ? GoToAsync(n)
            : Task.CompletedTask;
    }

    public override string GetAllText() => string.Join("\n", Lines);

    protected override ValueTask DisposeCoreAsync() => new(JsVoidAsync("detach", _scroll));

    private static int VisualLength(string s)
    {
        int n = 0;
        foreach (var c in s) n += c == '\t' ? 4 - n % 4 : 1;
        return n;
    }

    private RenderFragment LineContent(string text) => b =>
    {
        if (_query is null || text.Length == 0)
        {
            b.AddContent(0, text);
            return;
        }
        int start = 0;
        while (true)
        {
            int k = text.IndexOf(_query, start, StringComparison.OrdinalIgnoreCase);
            if (k < 0) break;
            b.AddContent(1, text[start..k]);
            b.OpenElement(2, "mark");
            b.AddAttribute(3, "class", "sl-hit");
            b.AddContent(4, text.Substring(k, _query.Length));
            b.CloseElement();
            start = k + _query.Length;
        }
        b.AddContent(5, text[start..]);
    };
}
