<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    TESTING ONLY — never shipped, never referenced by a host. A Blazor Server page that renders the
    shared Ui at phone / tablet / desktop layouts so the Mobile app UI chat can screenshot it in a
    headless browser and compare it with the design handout (Portal & Android 12d-12j).
    It uses only what ships with .NET (Kestrel, Blazor Server). Run it through
    tools/mobile-ui/preview.sh, which applies the proposed MainLayout hooks in a scratch copy first.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ChuvadiReader.Hosting\ChuvadiReader.Hosting.csproj" />
  </ItemGroup>
</Project>
