<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- CI-only committed feed: the chuvadi-pdf 3.14.1 set + LiPicons.Blazor.
         The dev tree uses ./localpackages (git-ignored); this mirror keeps CI self-sufficient.
         When the library version bumps, refresh ./packages with the new .nupkgs and bump the pin. -->
    <add key="chuvadi-ci" value="./packages" />
  </packageSources>
</configuration>
